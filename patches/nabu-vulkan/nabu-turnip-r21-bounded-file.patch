diff --git a/src/freedreno/vulkan/nabu_trace_file_transport.inc b/src/freedreno/vulkan/nabu_trace_file_transport.inc
--- /dev/null
+++ b/src/freedreno/vulkan/nabu_trace_file_transport.inc
@@ -0,0 +1,174 @@
+// SPDX-License-Identifier: MIT
+// Capture control is the deployed controller's read-only registry result.
+// No new IOConnect selector is sent to the kernel.
+#include <CoreFoundation/CoreFoundation.h>
+#include <IOKit/IOKitLib.h>
+#include <errno.h>
+#include <sys/stat.h>
+
+#include "nabu_trace_file_budget.h"
+
+static uint64_t nabu_number(CFDictionaryRef dict, const char *name)
+{
+   CFStringRef key = CFStringCreateWithCString(NULL, name, kCFStringEncodingUTF8);
+   CFTypeRef value = CFDictionaryGetValue(dict, key);
+   int64_t result = 0;
+   if (value && CFGetTypeID(value) == CFNumberGetTypeID())
+      CFNumberGetValue((CFNumberRef)value, kCFNumberSInt64Type, &result);
+   CFRelease(key);
+   return (uint64_t)result;
+}
+
+static NativeAdrenoTraceStatus nabu_file_query(tu_darwin_trace_state *state)
+{
+   const uint64_t now = trace_now(state);
+   // Only the transport thread polls IOKit; submission consumes the cached deadline.
+   if (pthread_equal(pthread_self(), state->worker) && now >= state->file_next_poll_ns) {
+      state->file_next_poll_ns = now + 10000000;
+      io_service_t service = IOServiceGetMatchingService(kIOMainPortDefault,
+         IOServiceMatching("NativeAdrenoGpuPublished"));
+      if (service) {
+         CFTypeRef value = IORegistryEntryCreateCFProperty(service, CFSTR("LastTraceResult"), NULL, 0);
+         IOObjectRelease(service);
+         if (value && CFGetTypeID(value) == CFDictionaryGetTypeID()) {
+            CFDictionaryRef result = (CFDictionaryRef)value;
+            NativeAdrenoTraceStatus status = {};
+            status.generation = nabu_number(result, "window");
+            status.started_ns = nabu_number(result, "start_us") * 1000;
+            status.deadline_ns = nabu_number(result, "deadline_us") * 1000;
+            status.stopped_ns = nabu_number(result, "end_us") * 1000;
+            const CFTypeRef active = CFDictionaryGetValue(result, CFSTR("active"));
+            if (active == kCFBooleanTrue && status.generation && now < status.deadline_ns)
+               status.state = NativeAdrenoTraceRunning;
+            pthread_mutex_lock(&state->mutex);
+            state->file_control = status;
+            pthread_mutex_unlock(&state->mutex);
+         }
+         if (value) CFRelease(value);
+      }
+   }
+   pthread_mutex_lock(&state->mutex);
+   NativeAdrenoTraceStatus status = state->file_control;
+   pthread_mutex_unlock(&state->mutex);
+   if (status.generation && now >= status.deadline_ns) {
+      status.state = 0;
+      status.stopped_ns = status.deadline_ns;
+   }
+   if (status.generation == p_atomic_read(&state->file_failure_generation)) status.state = 0;
+   return status;
+}
+
+static void nabu_file_marker(uint64_t id, uint64_t stage, uint64_t a, uint64_t b)
+{
+   const int saved = errno;
+   syscall(179, 0x31ca81fcull, id, stage, a, b);
+   errno = saved;
+}
+
+int tu_darwin_trace_call(struct tu_device *device, uint32_t method,
+                        const void *input, size_t input_size,
+                        void *output, size_t output_size)
+{
+   (void)input_size;
+   (void)output_size;
+   tu_darwin_trace_state *state = trace_state(device);
+   if (method == NativeAdrenoMethodQueryTrace) {
+      *(NativeAdrenoTraceStatus *)output = nabu_file_query(state);
+      return 0;
+   }
+   if (method == NativeAdrenoMethodRegisterTraceProducer) {
+      NativeAdrenoTraceProducer producer = *(const NativeAdrenoTraceProducer *)input;
+      const NativeAdrenoTraceStatus control = nabu_file_query(state);
+      if (producer.generation != control.generation || control.state != NativeAdrenoTraceRunning) return -1;
+      // The tail reservation guarantees a terminal loss/error record even at the file budget.
+      state->file_budget = nabu_file_budget_acquire(control.started_ns, producer.generation,
+                                                    sizeof(NabuTraceFileHeader) + 4096);
+      if (!state->file_budget) {
+         const int error = errno;
+         p_atomic_set(&state->file_failure_generation, producer.generation);
+         nabu_file_marker(state->file_id, 780, producer.generation, error);
+         return -1;
+      }
+      char directory[1024];
+      const char *home = getenv("CFFIXED_USER_HOME");
+      if (!home) home = getenv("HOME");
+      const bool container = home && strstr(home, "/Containers/");
+      if (container) snprintf(directory, sizeof(directory), "%s/Library/Caches/NabuGpuTrace", home);
+      else snprintf(directory, sizeof(directory), "/var/mobile/Media/NabuGpuOpt");
+      mkdir(directory, 0700);
+      char name[1200];
+      snprintf(name, sizeof(name), "%s/r21-gpu-%u-%llu-%u-%llu.bin", directory,
+               (unsigned)getpid(), (unsigned long long)state->file_id, producer.generation, (unsigned long long)control.started_ns);
+      state->file = fopen(name, "wbx");
+      if (!state->file) {
+         const int error = errno;
+         nabu_file_budget_release(state->file_budget); state->file_budget = NULL;
+         p_atomic_set(&state->file_failure_generation, producer.generation);
+         nabu_file_marker(state->file_id, 780, producer.generation, (uint64_t(container) << 32) | uint32_t(error));
+         return -1;
+      }
+      state->file_generation = producer.generation;
+      state->file_bytes = 0;
+      state->file_rejected = 0;
+      state->file_io_error = 0;
+      producer.producer_id = (uint32_t)state->file_id;
+      const NabuTraceFileHeader header = {0x313254525542414eull, 1, sizeof(NativeAdrenoTraceEvent),
+         (uint64_t)getpid(), producer.generation, producer.producer_id, control.started_ns, control.deadline_ns};
+      if (fwrite(&header, sizeof(header), 1, state->file) != 1 || fflush(state->file)) {
+         state->file_io_error = errno ? errno : EIO;
+         fclose(state->file); state->file = NULL;
+         nabu_file_budget_release(state->file_budget); state->file_budget = NULL;
+         p_atomic_set(&state->file_failure_generation, producer.generation);
+         nabu_file_marker(state->file_id, 780, producer.generation, state->file_io_error);
+         return -1;
+      }
+      *(NativeAdrenoTraceProducer *)output = producer;
+      nabu_file_marker(state->file_id, 780, producer.generation, uint64_t(container) << 32);
+      return 0;
+   }
+   if (method == NativeAdrenoMethodAppendTrace) {
+      const NativeAdrenoTraceBatch *batch = (const NativeAdrenoTraceBatch *)input;
+      if (!state->file || batch->generation != state->file_generation) return -1;
+      const size_t bytes = batch->count * sizeof(batch->events[0]);
+      if (state->file_io_error || !nabu_file_reserve(state->file_budget, bytes)) {
+         state->file_rejected += batch->count;
+         return -1;
+      }
+      if (fwrite(batch->events, sizeof(batch->events[0]), batch->count, state->file) != batch->count) {
+         state->file_io_error = errno ? errno : EIO;
+         state->file_rejected += batch->count;
+         return -1;
+      }
+      state->file_bytes += bytes;
+      return 0;
+   }
+   if (method == NativeAdrenoMethodEndTraceProducer) {
+      const NativeAdrenoTraceProducer *producer = (const NativeAdrenoTraceProducer *)input;
+      if (state->file) {
+         NativeAdrenoTraceEvent footer = {};
+         footer.source = NativeAdrenoTraceSourceTurnip;
+         footer.point = NativeAdrenoTraceTurnipRecordCounts;
+         footer.phase = NativeAdrenoTracePhaseInstant;
+         footer.clock_domain = NativeAdrenoTraceClockMonotonicNanoseconds;
+         footer.timestamp_ns = trace_now(state);
+         footer.process_id = getpid();
+         snprintf(footer.name, sizeof(footer.name), "file_complete");
+         footer.argument_count = 4;
+         footer.args[0] = {1001, NativeAdrenoTraceArgumentUnsigned, state->file_bytes};
+         footer.args[1] = {1002, NativeAdrenoTraceArgumentUnsigned, state->file_rejected};
+         footer.args[2] = {1003, NativeAdrenoTraceArgumentUnsigned, state->file_io_error};
+         footer.args[3] = {1004, NativeAdrenoTraceArgumentUnsigned, producer->dropped};
+         const bool wrote = fwrite(&footer, sizeof(footer), 1, state->file) == 1;
+         const int flush_error = fflush(state->file);
+         const int close_error = fclose(state->file);
+         state->file = NULL;
+         if (!wrote || flush_error || close_error) state->file_io_error = errno ? errno : EIO;
+      }
+      if (state->file_budget) {
+         nabu_file_budget_release(state->file_budget); state->file_budget = NULL;
+      }
+      // Always release the producer: failed diagnostics must not stall device teardown.
+      return 0;
+   }
+   return -1;
+}
diff --git a/src/freedreno/vulkan/nabu_trace_file_budget.h b/src/freedreno/vulkan/nabu_trace_file_budget.h
--- /dev/null
+++ b/src/freedreno/vulkan/nabu_trace_file_budget.h
@@ -0,0 +1,91 @@
+// SPDX-License-Identifier: MIT
+#pragma once
+#include <errno.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <stdlib.h>
+
+// One process-wide allowance per capture identity, shared by every Vulkan device.
+// Old writers retain their own budget while completed GPU timestamps drain.
+static constexpr uint64_t NABU_TRACE_FILE_WINDOW_BYTES = 512ull << 20;
+struct NabuTraceFileBudget {
+   uint64_t started_ns, used;
+   uint32_t generation, writers;
+   NabuTraceFileBudget *next;
+};
+static pthread_mutex_t nabu_file_budget_mutex = PTHREAD_MUTEX_INITIALIZER;
+static NabuTraceFileBudget *nabu_file_budgets;
+static uint64_t nabu_file_latest_started_ns;
+
+static void nabu_file_budget_prune_locked()
+{
+   NabuTraceFileBudget **link = &nabu_file_budgets;
+   while (*link) {
+      NabuTraceFileBudget *budget = *link;
+      if (!budget->writers && budget->started_ns < nabu_file_latest_started_ns) {
+         *link = budget->next;
+         free(budget);
+      } else {
+         link = &budget->next;
+      }
+   }
+}
+
+static NabuTraceFileBudget *nabu_file_budget_acquire(uint64_t started_ns,
+                                                   uint32_t generation,
+                                                   uint64_t initial_bytes)
+{
+   pthread_mutex_lock(&nabu_file_budget_mutex);
+   if (started_ns > nabu_file_latest_started_ns) {
+      nabu_file_latest_started_ns = started_ns;
+      nabu_file_budget_prune_locked();
+   }
+   NabuTraceFileBudget *budget = nabu_file_budgets;
+   while (budget && (budget->started_ns != started_ns || budget->generation != generation))
+      budget = budget->next;
+   if (!budget) {
+      if (started_ns < nabu_file_latest_started_ns) {
+         pthread_mutex_unlock(&nabu_file_budget_mutex);
+         errno = ESTALE;
+         return NULL;
+      }
+      budget = (NabuTraceFileBudget *)calloc(1, sizeof(*budget));
+      if (!budget) {
+         pthread_mutex_unlock(&nabu_file_budget_mutex);
+         errno = ENOMEM;
+         return NULL;
+      }
+      budget->started_ns = started_ns;
+      budget->generation = generation;
+      budget->next = nabu_file_budgets;
+      nabu_file_budgets = budget;
+   }
+   if (initial_bytes > NABU_TRACE_FILE_WINDOW_BYTES - budget->used) {
+      pthread_mutex_unlock(&nabu_file_budget_mutex);
+      errno = ENOSPC;
+      return NULL;
+   }
+   budget->used += initial_bytes;
+   ++budget->writers;
+   pthread_mutex_unlock(&nabu_file_budget_mutex);
+   return budget;
+}
+
+static bool nabu_file_reserve(NabuTraceFileBudget *budget, uint64_t bytes)
+{
+   pthread_mutex_lock(&nabu_file_budget_mutex);
+   const bool allowed = bytes <= NABU_TRACE_FILE_WINDOW_BYTES - budget->used;
+   if (allowed) budget->used += bytes;
+   pthread_mutex_unlock(&nabu_file_budget_mutex);
+   return allowed;
+}
+
+static void nabu_file_budget_release(NabuTraceFileBudget *budget)
+{
+   pthread_mutex_lock(&nabu_file_budget_mutex);
+   --budget->writers;
+   // Retain an ended current window's usage so a later device cannot reset it.
+   // Retired windows are removed only after their final writer is done.
+   nabu_file_budget_prune_locked();
+   pthread_mutex_unlock(&nabu_file_budget_mutex);
+}
