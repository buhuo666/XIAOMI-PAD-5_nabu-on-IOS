+    * Widen before alignment/multiplication so a large row cannot wrap. */
+   const uint64_t reach =
+      ALIGN_POT((uint64_t) iview->view.width, (uint64_t) info->gmem_align_w) * layout->cpp;
+   return reach > pitch;
 }
 
