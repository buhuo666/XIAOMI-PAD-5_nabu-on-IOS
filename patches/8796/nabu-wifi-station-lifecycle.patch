+void
+hakios_sta_sample_signal(void)
+{
+	const struct hakios_sta_ops *ops;
+	struct hakios_sta_state state;
+	uint64_t generation, connection_generation;
+	bool publish;
+
+	lck_mtx_lock(&sta_lock);
+	ops = !sta_failed && sta_on && sta_want_on && sta_association_valid &&
