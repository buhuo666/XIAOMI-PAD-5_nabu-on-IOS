+	 * while it runs; the reader count keeps detach from freeing its owner. */
+	ops->state(&state);
+	lck_mtx_lock(&sta_publish);
+	lck_mtx_lock(&sta_lock);
+	publish = current_locked(ops, generation) && connection_generation == sta_connection_generation &&
+	    sta_on && sta_want_on && sta_association_valid && !asked_join && !asked_leave &&
+	    (!sta_join_active || sta_join_committed) && state.phase == HAKIOS_STA_JOINED;
+	sta_reads--;
+	lck_mtx_unlock(&sta_lock);
+	if (publish) {
+		hakios_apple80211_signal(state.bss.rssi);
+	}
+	lck_mtx_unlock(&sta_publish);
