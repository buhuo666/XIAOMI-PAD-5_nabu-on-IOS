+/* Diagnostics for the existing timed return; never changes its routing policy. */
+static bool loader_diag_enabled;
+static char loader_diag_initial[768], loader_diag_expired[768];
+static char loader_diag_route[160], loader_diag_callback[160];
+#if defined(GENERIC_GIC_V3_IRQ)
+extern uint64_t gic_timer_count[MAX_CPUS], gic_signal_count[MAX_CPUS];
+extern uint64_t gic_cpu_mpidr[MAX_CPUS];
+extern uint32_t gic_last_intid[MAX_CPUS];
+static uint64_t loader_diag_initial_timer[MAX_CPUS], loader_diag_initial_signal[MAX_CPUS];
+#endif
+
+static void
+loader_diag_args(char *line, size_t size, const char *stage,
+    uint32_t cpu, boolean_t cpu_found, uint32_t as_panic, boolean_t panic_found)
+{
+	snprintf(line, size,
+	    "nabu_diag %s on cpu %d: return_cpu found=%u value=%u return_panic found=%u value=%u args=%.607s\n",
+	    stage, cpu_number(), (unsigned)cpu_found, cpu, (unsigned)panic_found, as_panic, PE_boot_args());
+}
+
+static void
+loader_diag_append(void)
+{
+	if (!loader_diag_enabled) {
+		return;
+	}
+	loader_log_line("\n--- nabu return diagnostic ---\n");
+	loader_log_line(loader_diag_initial);
+	loader_log_line(loader_diag_expired);
+	loader_log_line(loader_diag_route);
+	loader_log_line(loader_diag_callback);
+#if defined(GENERIC_GIC_V3_IRQ)
+	for (unsigned cpu = 0; cpu < MAX_CPUS; ++cpu) {
+		char line[192];
+		snprintf(line, sizeof(line),
+		    "nabu_diag cpu %u mpidr=0x%llx timer=%llu->%llu sgi=%llu->%llu last=%u\n",
+		    cpu, (unsigned long long)os_atomic_load(&gic_cpu_mpidr[cpu], relaxed),
+		    (unsigned long long)loader_diag_initial_timer[cpu],
+		    (unsigned long long)os_atomic_load(&gic_timer_count[cpu], relaxed),
+		    (unsigned long long)loader_diag_initial_signal[cpu],
+		    (unsigned long long)os_atomic_load(&gic_signal_count[cpu], relaxed),
+		    os_atomic_load(&gic_last_intid[cpu], relaxed));
+		loader_log_line(line);
+	}
+#endif
 }
 
