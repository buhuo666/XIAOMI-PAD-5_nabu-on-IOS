diff --git a/osfmk/arm/pmap/pmap.c b/osfmk/arm/pmap/pmap.c
--- a/osfmk/arm/pmap/pmap.c
+++ b/osfmk/arm/pmap/pmap.c
@@ -12349,6 +12349,30 @@ pmap_in_ppl(void)
 	return false;
 }
 
+#if !PMAP_CS && !XNU_MONITOR
+int
+pmap_cs_configuration(void)
+{
+	/*
+	 * This configuration has no pmap code-signing monitor. Match the
+	 * unsupported-query convention in the 8796 x86_64 implementation.
+	 * Zero does not describe the kernel's or AMFI's code-signing policy;
+	 * see the contract in vm/pmap.h.
+	 */
+	return 0;
+}
+
+bool
+pmap_has_iofilter_protected_write(void)
+{
+	/*
+	 * There is no guarded-mode register filter in this configuration.
+	 * The companion write operation below panics as unsupported.
+	 */
+	return false;
+}
+#endif /* !PMAP_CS && !XNU_MONITOR */
+
 __attribute__((__noreturn__))
 void
 pmap_iofilter_protected_write(__unused vm_address_t addr, __unused uint64_t value, __unused uint64_t width)
