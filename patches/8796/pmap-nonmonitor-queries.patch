diff --git a/osfmk/arm/pmap/pmap.c b/osfmk/arm/pmap/pmap.c
--- a/osfmk/arm/pmap/pmap.c
+++ b/osfmk/arm/pmap/pmap.c
@@ -12349,6 +12349,32 @@ pmap_in_ppl(void)
 	return false;
 }
 
+#if !PMAP_CS && !XNU_MONITOR
+int
+pmap_cs_configuration(void)
+{
+	code_signing_config_t config;
+
+	/*
+	 * The 20F66 arm64 query reads the same cached configuration as
+	 * code_signing_configuration(). Preserve its shared initialization
+	 * and boot-argument state in this non-monitor configuration.
+	 */
+	code_signing_configuration(NULL, &config);
+	return (int)config;
+}
+
+bool
+pmap_has_iofilter_protected_write(void)
+{
+	/*
+	 * There is no guarded-mode register filter in this configuration.
+	 * The companion write operation below panics as unsupported.
+	 */
+	return false;
+}
+#endif /* !PMAP_CS && !XNU_MONITOR */
+
 __attribute__((__noreturn__))
 void
 pmap_iofilter_protected_write(__unused vm_address_t addr, __unused uint64_t value, __unused uint64_t width)
