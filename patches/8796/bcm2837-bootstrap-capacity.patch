--- a/osfmk/arm/pmap/pmap.h
+++ b/osfmk/arm/pmap/pmap.h
@@ -118,7 +118,12 @@
  * 2 GB device (8 pages); 20 pages cover 8 GB, enough for a boot image of
  * several GB next to the kernel.
  */
+#if defined(BCM2837) && (ARM_PGSHIFT == 12) && !defined(ARM_LARGE_MEMORY)
+/* Two L1 roots plus up to 26 L2 pages for 12 GiB with arbitrary slide. */
+#define BOOTSTRAP_TABLE_SIZE (ARM_PGBYTES * 32)
+#else
 #define BOOTSTRAP_TABLE_SIZE (ARM_PGBYTES * 20)
+#endif
 #endif /* defined(ARM_LARGE_MEMORY) */
 
 typedef uint64_t tt_entry_t; /* translation table entry type */
--- a/osfmk/arm64/genassym.c
+++ b/osfmk/arm64/genassym.c
@@ -249,6 +249,7 @@
 
 
 	DECLARE("PGBYTES", ARM_PGBYTES);
+	DECLARE("BOOTSTRAP_TABLE_BYTES", BOOTSTRAP_TABLE_SIZE);
 	DECLARE("PGSHIFT", ARM_PGSHIFT);
 
 	DECLARE("VM_MIN_KERNEL_ADDRESS", VM_MIN_KERNEL_ADDRESS);
--- a/osfmk/arm64/start.s
+++ b/osfmk/arm64/start.s
@@ -581,6 +581,11 @@
 
 	/* allocate an L2 table */
 3:	add	$4, $4, PGBYTES
+#if defined(BCM2837) && (ARM_PGSHIFT == 12) && !defined(ARM_LARGE_MEMORY)
+	/* x17 is the exclusive end of the pool, reserved by the caller. */
+	cmp	$4, x17
+	b.hs	Lbootstrap_table_exhausted
+#endif
 
 	/* create_l1_table_entry(virt_base, L1 table, L2 table, scratch1, scratch2, scratch3) */
 	create_l1_table_entry	$0, $3, $4, $6, $7, $8
@@ -712,8 +717,12 @@
 	// Invalidate all entries in the bootstrap page tables
 	mov		x0, #(ARM_TTE_EMPTY)				// Load invalid entry template
 	mov		x1, x25								// Start at V=P pagetable root
+#if defined(BCM2837) && (ARM_PGSHIFT == 12) && !defined(ARM_LARGE_MEMORY)
+	MOV64	x2, (BOOTSTRAP_TABLE_BYTES >> TTE_SHIFT)
+#else
 	mov		x2, #(TTE_PGENTRIES)				// Load number of entries per page
 	lsl		x2, x2, #2							// Shift by 2 for num entries on 4 pages
+#endif
 
 Linvalidate_bootstrap:							// do {
 	str		x0, [x1], #(1 << TTE_SHIFT)			//   Invalidate and advance
@@ -784,6 +793,10 @@
 	mov		x1, x25
 	add		x3, x1, PGBYTES
 	mov		x2, x3
+#if defined(BCM2837) && (ARM_PGSHIFT == 12) && !defined(ARM_LARGE_MEMORY)
+	MOV64	x17, BOOTSTRAP_TABLE_BYTES
+	add		x17, x25, x17
+#endif
 
 	/*
 	 * Setup the V=P bootstrap mapping
@@ -797,6 +810,13 @@
 	lsr		x5,  x24, #(ARM_TT_L2_SHIFT)
 	create_bootstrap_mapping x14, x15, x5, x3, x2, x9, x10, x11, x12, x13
 
+#if defined(BCM2837) && (ARM_PGSHIFT == 12) && !defined(ARM_LARGE_MEMORY)
+	b		Lbootstrap_tables_ready
+Lbootstrap_table_exhausted:
+	/* Stop before an out-of-pool store; x2/x17 identify cursor/limit. */
+	b		Lbootstrap_table_exhausted
+Lbootstrap_tables_ready:
+#endif
 	/* Ensure TTEs are visible */
 	dsb		ish
 
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -1921,7 +1921,11 @@
 	size_t l1_entries = 1 + ((bytes_mapped + ARM_TT_L1_SIZE - 1) / ARM_TT_L1_SIZE);
 	/* 1 L1 each for V=P and KVA, plus 1 page for each L2 */
 	size_t pages_used = 2 * (l1_entries + 1);
+#if defined(BCM2837) && (ARM_PGSHIFT == 12) && !defined(ARM_LARGE_MEMORY)
+	if (pages_used > BOOTSTRAP_TABLE_SIZE / ARM_PGBYTES) {
+#else
 	if (pages_used > BOOTSTRAP_TABLE_SIZE) {
+#endif
 		panic("BOOTSTRAP_TABLE_SIZE too small for memory config");
 	}
 #endif
