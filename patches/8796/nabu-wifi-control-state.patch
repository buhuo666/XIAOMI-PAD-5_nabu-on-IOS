+/* Validate the mode selected by 20F66, not every mode advertised by an AP. */
+static int
+join_security(const struct apple80211_assoc *asked)
+{
+	if (asked->version != 1 || asked->key_version != 1) return EINVAL;
+	if (asked->mode != 2 || asked->auth_lower != 1 || asked->auth_upper != 8 ||
+	    asked->key_flags || asked->key_index) return EOPNOTSUPP;
+	if (asked->key_cipher != CIPHER_PMK && asked->key_cipher != CIPHER_PASSPHRASE) return EOPNOTSUPP;
+	if ((asked->key_cipher == CIPHER_PMK && asked->key_length != 32) ||
+	    (asked->key_cipher == CIPHER_PASSPHRASE && (asked->key_length < 8 || asked->key_length > 63))) return EINVAL;
+	unsigned length = asked->rsn_length;
+	const uint8_t *r = asked->rsn;
+	if (!length) return EOPNOTSUPP;
+	if (length < 20 || length > sizeof(asked->rsn) || r[1] + 2u != length) return EINVAL;
+	if (r[0] != 48) return EOPNOTSUPP;
+	if (r[2] != 1 || r[3]) return EINVAL;
+	if (memcmp(r + 4, "\x00\x0f\xac\x04", 4)) return EOPNOTSUPP;
+	unsigned count = r[8] | r[9] << 8;
+	if (!count || count > (length - 10) / 4) return EINVAL;
+	if (count != 1 || memcmp(r + 10, "\x00\x0f\xac\x04", 4)) return EOPNOTSUPP;
+	count = r[14] | r[15] << 8;
+	if (!count || count > (length - 16) / 4) return EINVAL;
+	if (count != 1 || memcmp(r + 16, "\x00\x0f\xac\x02", 4)) return EOPNOTSUPP;
+	if (length == 20) return 0;
+	if (length < 22) return EINVAL;
+	if (r[20] & 0xc0) return EOPNOTSUPP; /* No management-frame protection negotiated. */
+	if (length == 22) return 0;
+	if (length < 24) return EINVAL;
+	count = r[22] | r[23] << 8;
+	if (count > (length - 24) / 16) return EINVAL;
+	/* PMKID caching and group-management keys are outside this connection path. */
+	return count || length != 24 ? EOPNOTSUPP : 0;
+}
