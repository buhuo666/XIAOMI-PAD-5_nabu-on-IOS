+++ b/bsd/sys/hakios.security.h
@@ -0,0 +1,85 @@
+/* Shared WPA/RSN information-element reader. No keys, allocations or policy. */
+#ifndef _SYS_HAKIOS_SECURITY_H_
+#define _SYS_HAKIOS_SECURITY_H_
+#include <stdbool.h>
+#include <stdint.h>
+
+enum { HAKIOS_SECURITY_OK, HAKIOS_SECURITY_MALFORMED, HAKIOS_SECURITY_UNSUPPORTED };
+struct hakios_security {
+    bool wpa1, pairwise_unknown, akm_unknown, duplicate;
+    unsigned group, pairwise, akms, pairwise_count, akm_count;
+    unsigned capabilities, pmkid_count, management_cipher;
+};
+struct hakios_security_choice {
+    bool open, wpa1, sae, h2e, pmf, sha256, pmf_required;
+    unsigned pairwise, group;
+};
+
+static inline unsigned
+hakios_security_le16(const uint8_t *p)
+{
+    return (unsigned)p[0] | (unsigned)p[1] << 8;
+}
+
+static inline bool
+hakios_security_oui(const uint8_t *p, bool wpa1)
+{
+    return p[0] == 0 && p[1] == (wpa1 ? 0x50 : 0x0f) && p[2] == (wpa1 ? 0xf2 : 0xac);
+}
+
+static inline int
+hakios_security_read(const uint8_t *ie, unsigned length, struct hakios_security *out)
+{
+    *out = (struct hakios_security){false, false, false, false, 0, 0, 0, 0, 0, 0, 0, 0};
+    if (length < 2 || length != (unsigned)ie[1] + 2) return HAKIOS_SECURITY_MALFORMED;
+    unsigned at = 2;
+    if (ie[0] == 221) {
+        if (length < 6 || !hakios_security_oui(ie + 2, true) || ie[5] != 1)
+            return HAKIOS_SECURITY_UNSUPPORTED;
+        out->wpa1 = true; at = 6;
+    } else if (ie[0] != 48) return HAKIOS_SECURITY_UNSUPPORTED;
+    if (length - at < 8 || hakios_security_le16(ie + at) != 1)
+        return HAKIOS_SECURITY_MALFORMED;
+    at += 2;
+    if (!hakios_security_oui(ie + at, out->wpa1)) return HAKIOS_SECURITY_UNSUPPORTED;
+    out->group = ie[at + 3]; at += 4;
+    unsigned count = hakios_security_le16(ie + at); at += 2;
+    if (!count || count > (length - at) / 4) return HAKIOS_SECURITY_MALFORMED;
+    out->pairwise_count = count;
+    for (unsigned i = 0; i < count; i++, at += 4) {
+        unsigned cipher = ie[at + 3];
+        if (!hakios_security_oui(ie + at, out->wpa1) || (cipher != 2 && cipher != 4)) {
+            out->pairwise_unknown = true; continue;
+        }
+        unsigned bit = 1u << cipher;
+        if (out->pairwise & bit) out->duplicate = true;
+        out->pairwise |= bit;
+    }
+    if (length - at < 2) return HAKIOS_SECURITY_MALFORMED;
+    count = hakios_security_le16(ie + at); at += 2;
+    if (!count || count > (length - at) / 4) return HAKIOS_SECURITY_MALFORMED;
+    out->akm_count = count;
+    for (unsigned i = 0; i < count; i++, at += 4) {
+        unsigned akm = ie[at + 3];
+        if (!hakios_security_oui(ie + at, out->wpa1) || (akm != 2 && ((akm != 6 && akm != 8) || out->wpa1))) {
+            out->akm_unknown = true; continue;
+        }
+        unsigned bit = 1u << akm;
+        if (out->akms & bit) out->duplicate = true;
+        out->akms |= bit;
+    }
+    if (at == length) return HAKIOS_SECURITY_OK;
+    if (length - at < 2) return HAKIOS_SECURITY_MALFORMED;
+    out->capabilities = hakios_security_le16(ie + at); at += 2;
+    if (at == length) return HAKIOS_SECURITY_OK;
+    if (out->wpa1) return HAKIOS_SECURITY_UNSUPPORTED;
+    if (length - at < 2) return HAKIOS_SECURITY_MALFORMED;
+    out->pmkid_count = hakios_security_le16(ie + at); at += 2;
+    if (out->pmkid_count > (length - at) / 16) return HAKIOS_SECURITY_MALFORMED;
+    at += 16 * out->pmkid_count;
+    if (at == length) return HAKIOS_SECURITY_OK;
+    if (length - at != 4 || !hakios_security_oui(ie + at, false)) return HAKIOS_SECURITY_UNSUPPORTED;
+    out->management_cipher = ie[at + 3];
+    return HAKIOS_SECURITY_OK;
+}
+#endif
