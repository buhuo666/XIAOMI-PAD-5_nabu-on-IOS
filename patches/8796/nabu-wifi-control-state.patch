+/* Non-sensitive scalar diagnostics from this request, never the scan cache. */
+static void
+join_rsn_diagnostic(const struct apple80211_assoc *asked, unsigned *akms,
+    bool *akms_valid, unsigned *caps, bool *caps_valid)
+{
+	*akms = *caps = 0;
+	*akms_valid = *caps_valid = false;
+	unsigned length = asked->rsn_length;
+	const uint8_t *r = asked->rsn;
+	if (length < 10 || length > sizeof(asked->rsn) || r[0] != 48 ||
+	    r[1] + 2u != length || r[2] != 1 || r[3]) return;
+	unsigned count = r[8] | r[9] << 8;
+	if (!count || count > (length - 10) / 4) return;
+	unsigned offset = 10 + 4 * count;
+	if (length - offset < 2) return;
+	count = r[offset] | r[offset + 1] << 8;
+	*akms = count;
+	*akms_valid = true;
+	offset += 2;
+	if (!count || count > (length - offset) / 4) return;
+	offset += 4 * count;
+	if (length - offset < 2) return;
+	*caps = r[offset] | r[offset + 1] << 8;
+	*caps_valid = true;
+}
+
+/* Validate the mode selected by 20F66, not every mode advertised by an AP. */
+static int
+join_security(const struct apple80211_assoc *asked)
+{
+    if (asked->version != 1) return EINVAL;
+    if (asked->mode != 2 || asked->auth_lower != 1 || asked->key_flags || asked->key_index)
+        return EOPNOTSUPP;
+    if (!asked->auth_upper) {
+        if (asked->key_length || asked->key_cipher || asked->rsn_length) return EOPNOTSUPP;
+        return asked->key_version <= 1 ? 0 : EINVAL;
+    }
+    bool sae = asked->auth_upper == (1u << 12);
+    bool sha256 = asked->auth_upper == (1u << 10);
+    bool wpa1 = asked->auth_upper == 2, mixed = asked->auth_upper == (2 | 8);
+    if (!sae && !sha256 && !wpa1 && !mixed && asked->auth_upper != 8) return EOPNOTSUPP;
+    if (asked->key_version != 1) return EINVAL;
+    if (asked->key_cipher != CIPHER_PMK && asked->key_cipher != CIPHER_PASSPHRASE) return EOPNOTSUPP;
+    if (sae && asked->key_cipher != CIPHER_PASSPHRASE) return EOPNOTSUPP;
+    if ((asked->key_cipher == CIPHER_PMK && asked->key_length != 32) ||
+        (asked->key_cipher == CIPHER_PASSPHRASE && (asked->key_length < (sae ? 1u : 8u) || asked->key_length > 63)))
+        return EINVAL;
+    /* Some native PSK requests carry only the selected auth and PMK. The
+     * backend must still require that protocol on the AP; never infer open. */
+    if (!asked->rsn_length) return (sae || sha256) ? EOPNOTSUPP : 0;
+    if (asked->rsn_length > sizeof(asked->rsn)) return EINVAL;
+    struct hakios_security selected;
+    int error = hakios_security_read(asked->rsn, asked->rsn_length, &selected);
+    if (error) return error == HAKIOS_SECURITY_MALFORMED ? EINVAL : EOPNOTSUPP;
+    if (!mixed && selected.wpa1 != wpa1) return EOPNOTSUPP;
+    if (selected.group != 2 && selected.group != 4) return EOPNOTSUPP;
+    if (selected.pairwise_count != 1 || selected.pairwise_unknown || selected.akm_unknown || selected.duplicate ||
+        selected.akm_count > 3 || !(selected.akms & (1u << (sae ? 8 : sha256 ? 6 : 2)))) return EOPNOTSUPP;
+    if (selected.pmkid_count) return EOPNOTSUPP; /* No cached-association contract. */
+    unsigned caps = selected.wpa1 ? 0 : selected.capabilities;
+    bool mfpc = (caps & 0x80) != 0, mfpr = (caps & 0x40) != 0;
+    if (mfpr && !mfpc) return EOPNOTSUPP;
+    if (sae && !mfpc) return EOPNOTSUPP;
+    /* AKM6 keeps SHA256/CMAC, independently of optional management protection. */
+    if ((sae || sha256) && (selected.group != 4 || selected.pairwise != (1u << 4))) return EOPNOTSUPP;
+    /* Optional capability is negotiated by the backend with the AP. */
+    if (mfpr && (selected.group != 4 || selected.pairwise != (1u << 4))) return EOPNOTSUPP;
+    if (selected.management_cipher && (!mfpc || selected.management_cipher != 6)) return EOPNOTSUPP;
+    return 0;
+}
