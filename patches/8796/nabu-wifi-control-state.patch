+/* Non-sensitive scalar diagnostics from this request, never the scan cache. */
+static void
+join_rsn_diagnostic(const struct apple80211_assoc *asked, unsigned *akms,
+    bool *akms_valid, unsigned *caps, bool *caps_valid)
+{
+	*akms = *caps = 0;
+	*akms_valid = *caps_valid = false;
+	unsigned length = asked->rsn_length;
+	const uint8_t *r = asked->rsn;
+	if (length < 10 || length > sizeof(asked->rsn) || r[0] != 48 ||
+	    r[1] + 2u != length || r[2] != 1 || r[3]) return;
+	unsigned count = r[8] | r[9] << 8;
+	if (!count || count > (length - 10) / 4) return;
+	unsigned offset = 10 + 4 * count;
+	if (length - offset < 2) return;
+	count = r[offset] | r[offset + 1] << 8;
+	*akms = count;
+	*akms_valid = true;
+	offset += 2;
+	if (!count || count > (length - offset) / 4) return;
+	offset += 4 * count;
+	if (length - offset < 2) return;
+	*caps = r[offset] | r[offset + 1] << 8;
+	*caps_valid = true;
+}
+
+/* Validate the mode selected by 20F66, not every mode advertised by an AP. */
+static int
+join_security(const struct apple80211_assoc *asked)
+{
+	if (asked->version != 1 || asked->key_version != 1) return EINVAL;
+	bool sae = asked->auth_upper == (1u << 12);
+	if (asked->mode != 2 || asked->auth_lower != 1 || (!sae && asked->auth_upper != 8) ||
+	    asked->key_flags || asked->key_index) return EOPNOTSUPP;
+	if (asked->key_cipher != CIPHER_PMK && asked->key_cipher != CIPHER_PASSPHRASE) return EOPNOTSUPP;
+	if (sae && asked->key_cipher != CIPHER_PASSPHRASE) return EOPNOTSUPP;
+	if ((asked->key_cipher == CIPHER_PMK && asked->key_length != 32) ||
+	    (asked->key_cipher == CIPHER_PASSPHRASE && (asked->key_length < (sae ? 1u : 8u) || asked->key_length > 63))) return EINVAL;
+	unsigned length = asked->rsn_length;
+	const uint8_t *r = asked->rsn;
+	if (!length) return EOPNOTSUPP;
+	if (length < 20 || length > sizeof(asked->rsn) || r[1] + 2u != length) return EINVAL;
+	if (r[0] != 48) return EOPNOTSUPP;
+	if (r[2] != 1 || r[3]) return EINVAL;
+	if (memcmp(r + 4, "\x00\x0f\xac\x04", 4)) return EOPNOTSUPP;
+	unsigned count = r[8] | r[9] << 8;
+	if (!count || count > (length - 10) / 4) return EINVAL;
+	if (count != 1 || memcmp(r + 10, "\x00\x0f\xac\x04", 4)) return EOPNOTSUPP;
+	count = r[14] | r[15] << 8;
+	if (!count || count > (length - 16) / 4) return EINVAL;
+	if (count > 2) return EOPNOTSUPP;
+	bool has_psk = false, has_sae = false;
+	unsigned offset = 16;
+	for (unsigned i = 0; i < count; i++, offset += 4) {
+		if (memcmp(r + offset, "\x00\x0f\xac", 3)) return EOPNOTSUPP;
+		if (r[offset + 3] == 2) {
+			if (has_psk) return EOPNOTSUPP;
+			has_psk = true;
+		} else if (r[offset + 3] == 8) {
+			if (has_sae) return EOPNOTSUPP;
+			has_sae = true;
+		}
+		else return EOPNOTSUPP;
+	}
+	if (sae ? !has_sae : !has_psk) return EOPNOTSUPP;
+	if (offset == length) return sae ? EOPNOTSUPP : 0;
+	if (length - offset < 2) return EINVAL;
+	unsigned capabilities = r[offset] | r[offset + 1] << 8;
+	offset += 2;
+	bool mfpc = (capabilities & 0x80) != 0, mfpr = (capabilities & 0x40) != 0;
+	/* SAE negotiates PMF even when the AP does not require it of PSK stations. */
+	if (sae ? !mfpc : mfpr) return EOPNOTSUPP;
+	if (offset == length) return 0;
+	if (length - offset < 2) return offset >= 24 ? EOPNOTSUPP : EINVAL;
+	count = r[offset] | r[offset + 1] << 8;
+	offset += 2;
+	if (count > (length - offset) / 16) return EINVAL;
+	if (count) return EOPNOTSUPP; /* No cached association. */
+	offset += 16 * count;
+	if (offset == length) return 0;
+	if (length - offset != 4 || !mfpc || memcmp(r + offset, "\x00\x0f\xac\x06", 4))
+		return EOPNOTSUPP;
+	return 0;
+}
