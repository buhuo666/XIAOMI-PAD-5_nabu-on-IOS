diff --git a/TrollStore/main.m b/TrollStore/main.m
index ba87d0a..ef896bc 100644
--- a/TrollStore/main.m
+++ b/TrollStore/main.m
@@ -1,6 +1,43 @@
 #import <Foundation/Foundation.h>
 #import "TSAppDelegate.h"
 #import "TSUtil.h"
+#ifdef NABU_APP_STORE
+#import <errno.h>
+#import <string.h>
+#import <sys/stat.h>
+#import <unistd.h>
+
+static int nabuPrepareHelper(void)
+{
+	NSMutableDictionary *report = [@{@"uid": @(getuid()), @"euid": @(geteuid()),
+		@"timestamp": @([[NSDate date] timeIntervalSince1970])} mutableCopy];
+	NSMutableArray *files = [NSMutableArray new];
+	int result = 0;
+	if (getuid() != 0 || geteuid() != 0) result = EPERM;
+	else {
+		NSString *bundle = [getExecutablePath() stringByDeletingLastPathComponent];
+		for (NSString *name in @[@"trollstorehelper", @"ldid"]) {
+			NSString *path = [bundle stringByAppendingPathComponent:name];
+			NSMutableDictionary *file = [@{@"path": path} mutableCopy];
+			struct stat before, after;
+			if (stat(path.fileSystemRepresentation, &before) == 0) file[@"mode_before"] = @(before.st_mode & 07777);
+			int chmodError = chmod(path.fileSystemRepresentation, 0755) == 0 ? 0 : errno;
+			file[@"chmod_errno"] = @(chmodError);
+			if (stat(path.fileSystemRepresentation, &after) == 0) file[@"mode_after"] = @(after.st_mode & 07777);
+			[files addObject:file];
+			if (chmodError != 0) { result = chmodError; break; }
+		}
+	}
+	report[@"files"] = files;
+	report[@"result"] = @(result);
+	NSString *directory = @"/var/mobile/Media/NabuStore";
+	[[NSFileManager defaultManager] createDirectoryAtPath:directory withIntermediateDirectories:YES attributes:nil error:nil];
+	NSData *data = [NSJSONSerialization dataWithJSONObject:report options:NSJSONWritingPrettyPrinted error:nil];
+	[data writeToFile:[directory stringByAppendingPathComponent:@"helper-preparation.json"] options:NSDataWritingAtomic error:nil];
+	NSLog(@"[NabuStore] prepare helper uid=%u euid=%u result=%d", getuid(), geteuid(), result);
+	return result;
+}
+#endif
 
