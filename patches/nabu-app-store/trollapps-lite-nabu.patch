 import Combine
 
+private func recordInstallResult(_ itemID: UUID, helper: String, ipa: String, result: Int32) {
+    let directory = URL(fileURLWithPath: "/var/mobile/Media/NabuStore", isDirectory: true)
+    do {
+        try FileManager.default.createDirectory(at: directory, withIntermediateDirectories: true)
+        let record: [String: Any] = [
+            "operation": "install", "itemID": itemID.uuidString,
+            "helper": helper, "ipa": ipa, "result": Int(result),
+            "timestamp": Date().timeIntervalSince1970
+        ]
+        try JSONSerialization.data(withJSONObject: record, options: [.prettyPrinted, .sortedKeys])
+            .write(to: directory.appendingPathComponent("last-install-result.json"), options: .atomic)
+    } catch {
+        print("NabuStore: could not save installation result: \(error)")
+    }
+}
