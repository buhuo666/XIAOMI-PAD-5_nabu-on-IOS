@@ -193,6 +193,10 @@ static uint32_t step;                   /* the one being performed */
 static uint32_t new_from;               /* the first of the steps that have not been seen to work: they wait */
 static char last_write[96] = "nothing written";
 
+/* Optimization: dynamic pause reduction after initialization */
+static uint32_t init_complete_step = 11;  /* after DSP startup, reduce wait times */
+static uint32_t reduced_pause_ms = 200;   /* reduced pause for established initialization */
+
 /* As in hakios.adreno.c: every line goes to the log the loader reads from another core as well. */
 extern void loader_log_putc(char c);
 
@@ -395,12 +399,25 @@ need(struct block *b)
 	}
