-/* Time for the loader to note what has just been said, where it is not yet known to be harmless. */
+/* Time for the loader to note what has just been said, where it is not yet known to be harmless.
+ * Optimization: Dynamic wait time reduction after initialization phase completes.
+ * - Steps 1-11: Full pause (loader needs to log each step)
+ * - Steps 12+: Reduced pause (initialization complete, driver taking over)
+ */
 static void
 hold(bool single_access)
 {
-	if (step >= new_from && pause_ms && (!single_access || fine)) {
-		sleep_ms(pause_ms);
+	uint32_t effective_pause = pause_ms;
+
+	/* After step 11 (DSP started), use reduced pause for GLINK/QRTR setup */
+	if (step > init_complete_step && reduced_pause_ms > 0) {
+		if (effective_pause > reduced_pause_ms) {
+			effective_pause = reduced_pause_ms;
+		}
+	}
+
+	if (step >= new_from && effective_pause && (!single_access || fine)) {
+		sleep_ms(effective_pause);
 	}
 }
 
