+/// Optional startup evidence for the documented Apple request. Readback is the requested
+/// class, not the effective priority after overrides, process clamps or scheduler placement.
+/// These helpers run at worker startup; bound even that output across a process's devices.
+#[cfg(any(target_os = "macos", target_os = "ios"))]
+fn qos_startup_diagnostic(requested: libc::qos_class_t, status: libc::c_int) {
+    use std::sync::atomic::{AtomicU32, Ordering};
+    static ENABLED: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    static RECORDS: AtomicU32 = AtomicU32::new(0);
+    if !*ENABLED.get_or_init(|| {
+        std::env::var_os("NABU_METAL_QOS_PROFILE").is_some_and(|value| value == "1")
+    }) || RECORDS.fetch_add(1, Ordering::Relaxed) >= 64 {
+        return;
+    }
+    let mut class = libc::qos_class_t::QOS_CLASS_UNSPECIFIED;
+    let mut relative = 0;
+    // SAFETY: the current live pthread and two output values that live for the call.
+    let pthread = unsafe { libc::pthread_self() };
+    let read = unsafe { libc::pthread_get_qos_class_np(pthread, &mut class, &mut relative) };
+    let thread = std::thread::current();
+    eprintln!(
+        "nabu-metal-qos thread={:?} pthread={:#x} requested={:#x} set={} read={} class={:#x} relative={}",
+        thread.name().unwrap_or("(unnamed)"), pthread as usize, requested as u32,
+        status, read, class as u32, relative,
+    );
 }
 
