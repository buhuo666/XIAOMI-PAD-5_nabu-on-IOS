diff --git a/DarwinBootPkg/Driver/NabuDiagnostic.h b/DarwinBootPkg/Driver/NabuDiagnostic.h
new file mode 100644
index 0000000..0753b74
--- /dev/null
+++ b/DarwinBootPkg/Driver/NabuDiagnostic.h
@@ -0,0 +1,58 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#ifndef DARWINBOOT_NABU_DIAGNOSTIC_H
+#define DARWINBOOT_NABU_DIAGNOSTIC_H
+
+#ifndef DARWINBOOT_NABU_DIAGNOSTIC
+#define DARWINBOOT_NABU_DIAGNOSTIC 0
+#endif
+
+#if DARWINBOOT_NABU_DIAGNOSTIC && DARWINBOOT_XNU_MAJOR != 22
+#error NABU diagnostic guards require the Darwin 22 ABI
+#endif
+
+#if DARWINBOOT_NABU_DIAGNOSTIC
+// Only the offline diagnostic tree is supported. In particular, no storage
+// controller or PSCI node may reach the kernel through this profile.
+static inline int DarwinNabuNodePath(UINTN depth, UINTN parent,
+                                    const UINT8 *name, UINTN length, UINTN *path) {
+  if (name == NULL || length == 0 || name[length - 1] != 0) { return 0; }
+#define NABU_NODE(d,p,s,id) \
+  if (depth == (d) && parent == (p) && length == sizeof(s) && \
+      CompareMem(name, s, sizeof(s)) == 0) { *path = (id); return 1; }
+  NABU_NODE(0, 3, "device-tree", 0)
+  NABU_NODE(1, 0, "chosen", 1)
+  NABU_NODE(2, 1, "memory-map", 2)
+  NABU_NODE(1, 0, "cpus", 4)
+  NABU_NODE(2, 4, "cpu0", 5)
+  NABU_NODE(1, 0, "defaults", 6)
+  NABU_NODE(1, 0, "options", 7)
+  NABU_NODE(1, 0, "product", 8)
+  NABU_NODE(1, 0, "arm-io", 9)
+  NABU_NODE(2, 9, "gic", 10)
+#undef NABU_NODE
+  return 0;
+}
+#endif
+
+// These are the current xnu-8796 NABU bootstrap constants, not panel discovery.
+static inline int DarwinNabuVideoValid(const UINT64 video[6]) {
+  return video[0] == 0x9c000000ULL && video[1] == 1 &&
+         video[2] == 6400 && video[3] == 1600 &&
+         video[4] == 2560 && video[5] == 32;
+}
+
+static inline int DarwinWindowCandidate(UINT64 start, UINT64 end, UINT64 base,
+                                       UINT64 size, UINT64 limit, UINT64 *candidate) {
+  // XNU's 16 KiB bootstrap uses 32 MiB L2 blocks. Preserve their VA/PA
+  // offsets; the stronger congruence also covers 4 KiB / 2 MiB bootstraps.
+  const UINT64 mask = 0x1ffffffULL;
+  UINT64 aligned, delta = (base - start) & mask;
+  if (end > limit) { end = limit; }
+  if (start > MAX_UINT64 - delta) { return 0; }
+  aligned = start + delta;
+  if (end < aligned || size > end - aligned) { return 0; }
+  *candidate = aligned;
+  return 1;
+}
+
+#endif
diff --git a/README.md b/README.md
index 13b9c74..ca79db8 100644
--- a/README.md
+++ b/README.md
@@ -5,3 +5,25 @@ UEFI bootloader for UniXNU. Loads the payload, kernel, device tree and trust cac
 Current state: boots from the firmware volume and supports the packed RAM disk handoff.
 
 Built as part of the firmware volume.
+
+The standalone `DarwinBoot.dsc` defaults to Darwin 23 / xnu-10063 boot_args.
+For Darwin 22 / xnu-8796, build with `-D DARWINBOOT_XNU_MAJOR=22` (or run
+`scripts/build-darwinboot.sh` with `DARWINBOOT_XNU_MAJOR=22`). The ABIs differ:
+the command line is 608 bytes in 8796 and 1024 in 10063. Their memSizeActual
+offsets are 0x2d8 and 0x478 respectively. Do not mix a loader and kernel ABI.
+Firmware DSCs that include this driver directly must also pass the matching
+C compiler definition; the standalone DSC option does not configure them.
+
+`scripts/test-darwinboot.py --xnu-major 22` selects the corresponding synthetic
+QEMU entry fixture. It must match the loader already built. This is a separate
+boot_args layout check, not evidence that a real nabu device boots.
+
+For the xnu-8796 nabu diagnostic candidate, also set
+`DARWINBOOT_NABU_DIAGNOSTIC=1`. This profile requires Darwin 22, the exact
+arguments `nabulog=0 ufsrw=0 cpus=1`, a 256 MiB owned window entirely below
+4 GiB, and GOP base 0x9c000000 / 1600x2560 / stride 6400 / BGRA32.
+It accepts only the diagnostic node paths, excluding storage and PSCI nodes,
+and rejects ramdisk, trust cache and GPU addon placeholders. Unsupported
+inputs return to firmware before ExitBootServices. The generic QEMU
+validation suite requires the ordinary profile; it is not a diagnostic
+profile hardware test. No profile here supplies an iPadOS userland.
