diff --git a/Test/NabuValidation.c b/Test/NabuValidation.c
new file mode 100644
index 0000000..c6e43a5
--- /dev/null
+++ b/Test/NabuValidation.c
@@ -0,0 +1,56 @@
+// SPDX-License-Identifier: BSD-2-Clause-Patent
+#include <Uefi.h>
+#include <Library/BaseMemoryLib.h>
+#include <Library/UefiBootServicesTableLib.h>
+#include <Library/UefiLib.h>
+#include <Protocol/LoadedImage.h>
+#include <Protocol/UniXNULoader.h>
+
+EFI_STATUS
+EFIAPI
+NabuValidationEntry (EFI_HANDLE ImageHandle, EFI_SYSTEM_TABLE *SystemTable)
+{
+  EFI_STATUS Status;
+  EFI_LOADED_IMAGE_PROTOCOL *Loaded;
+  UNIXNU_LOADER_PROTOCOL *Loader;
+  UNIXNU_LOADER_BOOT_REQUEST Request;
+  UINT8 Byte = 0;
+  UINTN Index;
+  CHAR16 *Paths[] = {
+    L"\\EFI\\UniXNU\\Payloads\\diagnostic.macho",
+    L"\\EFI\\UniXNU\\Payloads\\storage.macho",
+    L"\\EFI\\UniXNU\\Payloads\\psci.macho",
+    L"\\EFI\\UniXNU\\Payloads\\large-window.macho",
+    L"\\EFI\\UniXNU\\Payloads\\ramdisk.macho"
+  };
+  EFI_STATUS Expected[] = {
+    EFI_UNSUPPORTED, EFI_COMPROMISED_DATA, EFI_COMPROMISED_DATA,
+    EFI_UNSUPPORTED, EFI_UNSUPPORTED
+  };
+  (VOID)SystemTable;
+  Status = gBS->HandleProtocol (ImageHandle, &gEfiLoadedImageProtocolGuid, (VOID **)&Loaded);
+  if (EFI_ERROR (Status)) { return Status; }
+  Status = gBS->LocateProtocol (&gUniXNULoaderProtocolGuid, NULL, (VOID **)&Loader);
+  if (EFI_ERROR (Status)) { return Status; }
+  ZeroMem (&Request, sizeof (Request));
+  Request.Volume = Loaded->DeviceHandle;
+  Request.KernelPath = Paths[0];
+  if (Loader->Boot (Loader, &Request) != EFI_UNSUPPORTED) { goto Failed; }
+  Request.BootArgs = L"nabulog=0 ufsrw=1 cpus=1";
+  if (Loader->Boot (Loader, &Request) != EFI_UNSUPPORTED) { goto Failed; }
+  Request.BootArgs = L"nabulog=0 ufsrw=0 cpus=1";
+  Request.Ramdisk = &Byte;
+  Request.RamdiskSize = 1;
+  if (Loader->Boot (Loader, &Request) != EFI_UNSUPPORTED) { goto Failed; }
+  Request.Ramdisk = NULL;
+  Request.RamdiskSize = 0;
+  for (Index = 0; Index < sizeof (Paths) / sizeof (Paths[0]); Index++) {
+    Request.KernelPath = Paths[Index];
+    if (Loader->Boot (Loader, &Request) != Expected[Index]) { goto Failed; }
+  }
+  Print (L"NABU-DIAGNOSTIC-VALIDATION: 8 refused requests; firmware retained PASS\n");
+  return EFI_SUCCESS;
+Failed:
+  Print (L"NABU-DIAGNOSTIC-VALIDATION: FAIL\n");
+  return EFI_DEVICE_ERROR;
+}
