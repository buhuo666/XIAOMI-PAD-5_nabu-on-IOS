+++ b/bsd/dev/nabu_key_chord.h
@@ -0,0 +1,69 @@
+/*
+ * Nabu volume chord: require confirmed release, then one continuous second.
+ * Caller supplies monotonic nanoseconds and trustworthy switch states.
+ * No hardware or storage access is performed here.
+ */
+#ifndef NABU_KEY_CHORD_H
+#define NABU_KEY_CHORD_H
+
+#define NABU_HOME_HOLD_NS       1000000000ULL
+#define NABU_HOME_TAP_NS        100000000ULL
+#define NABU_HOME_DOWN          1u
+#define NABU_HOME_UP            2u
+
+struct nabu_key_chord {
+	uint64_t started_ns;
+	uint64_t release_ns;
+	bool armed;
+	bool pending;
+	bool home_down;
+};
+
+static unsigned
+nabu_key_chord_step(struct nabu_key_chord *s, bool valid,
+    bool volume_up, bool volume_down, uint64_t now_ns)
+{
+	unsigned events = 0;
+
+	if (s->home_down && (!valid || !volume_up || !volume_down ||
+	    now_ns >= s->release_ns)) {
+		s->home_down = false;
+		events |= NABU_HOME_UP;
+	}
+	if (!valid) {
+		s->armed = false;
+		s->pending = false;
+		return events;
+	}
+	if (!volume_up && !volume_down) {
+		s->armed = true;
+		s->pending = false;
+		return events;
+	}
+	if (!s->armed) {
+		return events;
+	}
+	if (!volume_up || !volume_down) {
+		s->pending = false;
+		return events;
+	}
+	if (!s->pending) {
+		s->started_ns = now_ns;
+		s->pending = true;
+		return events;
+	}
+	if (now_ns < s->started_ns) {
+		s->armed = false;
+		s->pending = false;
+		return events;
+	}
+	if (now_ns - s->started_ns >= NABU_HOME_HOLD_NS) {
+		s->home_down = true;
+		s->release_ns = now_ns + NABU_HOME_TAP_NS;
+		s->armed = false;
+		s->pending = false;
+		events |= NABU_HOME_DOWN;
+	}
+	return events;
+}
+#endif
