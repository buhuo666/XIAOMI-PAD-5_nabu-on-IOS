 static struct nabu_pauth_thread *
 nabu_pauth_thread_entry(void)
 {
@@ -306,7 +464,8 @@ nabu_pauth_thread_entry(void)
 		}
 	}
 	if (!nabu_pauth_wanted(proc_name_address(p))) {
-		__atomic_fetch_add(&nabu_pauth_q_untracked, 1, __ATOMIC_RELAXED);
+		uint64_t ordinal = nabu_pauth_add(&nabu_pauth_q_untracked, 1);
+		nabu_pau_note_untracked(p, thread, uid, tid, ordinal);
 		return NULL;
 	}
 	if (free_slot == NABU_PAUTH_MAX_THREADS) {
@@ -748,6 +907,244 @@ nabu_pauth_print_window(void)
 	}
 }
 
+static void
+nabu_pau_aggregate(const struct nabu_pau_sample *sample)
+{
+	uint64_t x = (sample->uid * 0x9e3779b97f4a7c15ULL) ^
+	    (sample->tid * 0xbf58476d1ce4e5b9ULL);
+	unsigned int start = (unsigned int)(x >> 40) & (NABU_PAU_AGG_KEYS - 1);
+
+	for (unsigned int probe = 0; probe < NABU_PAU_AGG_PROBE; probe++) {
+		unsigned int index = (start + probe) & (NABU_PAU_AGG_KEYS - 1);
+		struct nabu_pau_agg *entry = &nabu_pau_agg[index];
+
+		if (!entry->used) {
+			entry->used = 1;
+			entry->uid = sample->uid;
+			entry->tid = sample->tid;
+			entry->pid = sample->pid;
+			entry->count = 1;
+			entry->name[0] = '\0';
+			for (unsigned int i = 0; i <= NABU_PAUTH_NAME_MAX; i++) {
+				entry->name[i] = sample->name[i];
+				if (sample->name[i] == '\0') {
+					break;
+				}
+			}
+			nabu_pau_agg_keys++;
+			nabu_pau_window_agg++;
+			__atomic_fetch_add(&nabu_pau_aggregated, 1, __ATOMIC_RELAXED);
+			return;
+		}
+		if (entry->uid == sample->uid && entry->tid == sample->tid) {
+			entry->count++;
+			nabu_pau_window_agg++;
+			__atomic_fetch_add(&nabu_pau_aggregated, 1, __ATOMIC_RELAXED);
+			return;
+		}
+	}
+	__atomic_fetch_add(&nabu_pau_agg_overflow, 1, __ATOMIC_RELAXED);
+}
+
+static void
+nabu_pau_drain(unsigned int budget, uint64_t *oldest_ns)
+{
+	for (unsigned int i = 0; i < budget; i++) {
+		struct nabu_pau_sample sample;
+		uint32_t head = nabu_pau_head;
+
+		if (head == nabu_pau_tail) {
+			return;
+		}
+		sample = nabu_pau_queue[head & (NABU_PAU_QUEUE_CAP - 1)];
+		__atomic_store_n(&nabu_pau_head, head + 1, __ATOMIC_RELEASE);
+		__atomic_fetch_add(&nabu_pau_dequeued, 1, __ATOMIC_RELAXED);
+		if (sample.ts_ns != 0 && *oldest_ns != 0 &&
+		    sample.ts_ns < *oldest_ns) {
+			*oldest_ns = sample.ts_ns;
+		} else if (*oldest_ns == 0) {
+			*oldest_ns = sample.ts_ns;
+		}
+		nabu_pau_aggregate(&sample);
+	}
+}
+
+static unsigned int
+nabu_pau_window(unsigned int seq, uint64_t begin_ns, uint64_t end_ns,
+    uint64_t oldest_ns)
+{
+	char buffer[NABU_PAUTH_LINE_BYTES];
+	unsigned int used = 0;
+	uint64_t unt_total = __atomic_load_n(&nabu_pauth_q_untracked, __ATOMIC_RELAXED);
+	uint64_t eligible = __atomic_load_n(&nabu_pau_eligible, __ATOMIC_RELAXED);
+	uint64_t ok = __atomic_load_n(&nabu_pau_enq_ok, __ATOMIC_RELAXED);
+	uint64_t busy = __atomic_load_n(&nabu_pau_busy, __ATOMIC_RELAXED);
+	uint64_t full = __atomic_load_n(&nabu_pau_full, __ATOMIC_RELAXED);
+	uint64_t deq = __atomic_load_n(&nabu_pau_dequeued, __ATOMIC_RELAXED);
+	uint64_t agg = __atomic_load_n(&nabu_pau_aggregated, __ATOMIC_RELAXED);
+	uint64_t overflow = __atomic_load_n(&nabu_pau_agg_overflow, __ATOMIC_RELAXED);
+	uint32_t pending = nabu_pau_tail - nabu_pau_head;
+	int n;
+
+	n = snprintf(buffer, sizeof(buffer), "NABU PAU W: v=1 s=%llu win=%u"
+	    " begin=%llu end=%llu\n", nabu_pau_session, seq, begin_ns, end_ns);
+	if (n > 0 && n < (int)sizeof(buffer)) {
+		printf("%s", buffer);
+		used += (unsigned int)n;
+	}
+
+	/* Top NABU_PAU_DETAIL_GENS keys by retained samples, then at most
+	 * NABU_PAU_DETAIL_TIDS per generation. */
+	int chosen[NABU_PAU_DETAIL_GENS];
+	unsigned int chosen_count = 0;
+	uint64_t detail = 0;
+	uint64_t window_agg;
+
+	for (unsigned int i = 0; i < NABU_PAU_AGG_KEYS; i++) {
+		if (!nabu_pau_agg[i].used) {
+			continue;
+		}
+		unsigned int position = chosen_count;
+		if (position < NABU_PAU_DETAIL_GENS) {
+			chosen[position] = (int)i;
+			chosen_count++;
+		} else {
+			unsigned int smallest = 0;
+			for (unsigned int k = 1; k < chosen_count; k++) {
+				if (nabu_pau_agg[chosen[k]].count <
+				    nabu_pau_agg[chosen[smallest]].count) {
+					smallest = k;
+				}
+			}
+			if (nabu_pau_agg[i].count >
+			    nabu_pau_agg[chosen[smallest]].count) {
+				chosen[smallest] = (int)i;
+			}
+		}
+	}
+	for (unsigned int k = 0; k < chosen_count; k++) {
+		struct nabu_pau_agg *entry = &nabu_pau_agg[chosen[k]];
+		n = snprintf(buffer, sizeof(buffer), "NABU PAU I: v=1 s=%llu win=%u"
+		    " rank=%u uid=%llu pid=%d tid=%llu nm=%s n=%llu cls=invalid"
+		    " st=invalid age=%llu\n", nabu_pau_session, seq, k + 1,
+		    entry->uid, entry->pid, entry->tid, entry->name, entry->count,
+		    oldest_ns != 0 ? (end_ns > oldest_ns ? end_ns - oldest_ns : 0) : 0);
+		if (n <= 0 || n >= (int)sizeof(buffer) - 1 ||
+		    used + (unsigned int)n > NABU_PAU_BUDGET_BYTES) {
+			__atomic_fetch_add(&nabu_pau_output_skipped, 1, __ATOMIC_RELAXED);
+			continue;
+		}
+		printf("%s", buffer);
+		used += (unsigned int)n;
+		detail += entry->count;
+	}
+	nabu_pau_detail_total += detail;
+	/* Omitted detail is measured in samples, not in aggregation keys, so
+	 * agg_total = detail_total + omit_total holds after the final drain. */
+	window_agg = nabu_pau_window_agg;
+	if (window_agg > detail) {
+		nabu_pau_omitted_detail += window_agg - detail;
+	}
+
+	n = snprintf(buffer, sizeof(buffer), "NABU PAU Q: v=1 s=%llu win=%u"
+	    " unt=%llu el=%llu ok=%llu busy=%llu full=%llu deq=%llu pend=%u"
+	    " agg=%llu ovf=%llu det=%llu omit=%llu out=%llu inflight=%u"
+	    " old=%llu snap=%llu-%llu\n",
+	    nabu_pau_session, seq, unt_total, eligible, ok, busy, full, deq,
+	    pending, agg, overflow, nabu_pau_detail_total,
+	    nabu_pau_omitted_detail,
+	    __atomic_load_n(&nabu_pau_output_skipped, __ATOMIC_RELAXED),
+	    (unsigned int)__atomic_load_n(&nabu_pau_inflight, __ATOMIC_ACQUIRE),
+	    oldest_ns != 0 && end_ns > oldest_ns ? end_ns - oldest_ns : 0,
+	    begin_ns, end_ns);
+	if (n > 0 && n < (int)sizeof(buffer)) {
+		printf("%s", buffer);
+		used += (unsigned int)n;
+	}
+	return used;
+}
+
+static void
+nabu_pau_finalize(uint64_t *window_begin, unsigned int *window_seq,
+    uint64_t *oldest_ns)
+{
+	uint64_t now;
+	unsigned int i;
+
+	/* 1. Stop accepting new producers. */
+	__atomic_store_n(&nabu_pau_enabled, 0, __ATOMIC_RELEASE);
+
+	/* 2. Wait for producers that already passed the enabled check.  They are
+	 *    short and non-blocking, so this is bounded; if it expires the end
+	 *    record stays honest about the possible race. */
+	for (i = 0; i < 2000; i++) {
+		if (__atomic_load_n(&nabu_pau_inflight, __ATOMIC_ACQUIRE) == 0) {
+			break;
+		}
+		(void)tsleep(&nabu_pau_chan, PZERO, "nabupau", 1);
+	}
+
+	/* 3. Bounded drain, re-checking in-flight producers after each pass. */
+	for (i = 0; i < 64; i++) {
+		nabu_pau_drain(NABU_PAU_QUEUE_CAP, oldest_ns);
+		if (nabu_pau_head == nabu_pau_tail &&
+		    __atomic_load_n(&nabu_pau_inflight, __ATOMIC_ACQUIRE) == 0) {
+			break;
+		}
+		(void)tsleep(&nabu_pau_chan, PZERO, "nabupau", 1);
+	}
+
+	now = nabu_pauth_now_ns();
+	nabu_pau_window(++(*window_seq), *window_begin, now, *oldest_ns);
+	*oldest_ns = 0;
+	nabu_pau_windows++;
+	if (nabu_pau_head == nabu_pau_tail &&
+	    __atomic_load_n(&nabu_pau_inflight, __ATOMIC_ACQUIRE) == 0) {
+		printf("NABU PAU E: v=1 s=%llu end=%llu reason=deadline\n",
+		    nabu_pau_session, now);
+	} else {
+		/* A producer may still publish after this record; say so instead
+		 * of claiming a completed drain. */
+		printf("NABU PAU E: v=1 s=%llu end=%llu reason=deadline_inflight"
+		    " pend=%u inflight=%u\n", nabu_pau_session, now,
+		    (unsigned int)(nabu_pau_tail - nabu_pau_head),
+		    (unsigned int)__atomic_load_n(&nabu_pau_inflight,
+		    __ATOMIC_ACQUIRE));
+	}
+}
+
+static void
+nabu_pau_worker(__unused void *arg, __unused wait_result_t wr)
+{
+	uint64_t window_begin = nabu_pauth_now_ns();
+	uint64_t oldest_ns = 0;
+	unsigned int window_seq = 0;
+
+	for (;;) {
+		uint64_t now;
+
+		(void)tsleep(&nabu_pau_chan, PZERO, "nabupau", hz);
+		now = nabu_pauth_now_ns();
+		nabu_pau_drain(NABU_PAU_QUEUE_CAP, &oldest_ns);
+		if (now >= nabu_pau_deadline_ns) {
+			nabu_pau_finalize(&window_begin, &window_seq, &oldest_ns);
+			return;
+		}
+		if (now - window_begin >= (uint64_t)NABU_PAU_WINDOW_SECONDS *
+		    1000000000ULL) {
+			nabu_pau_window(++window_seq, window_begin, now, oldest_ns);
+			nabu_pau_windows++;
+			window_begin = now;
+			oldest_ns = 0;
+			for (unsigned int i = 0; i < NABU_PAU_AGG_KEYS; i++) {
+				nabu_pau_agg[i].used = 0;
+			}
+			nabu_pau_agg_keys = 0;
+			nabu_pau_window_agg = 0;
+		}
+	}
+}
+
 static void
 nabu_pauth_diag_worker(__unused void *arg, __unused wait_result_t wr)
 {
@@ -813,6 +1210,29 @@ nabu_pauth_diag_start(void)
 	}
 	nabu_pauth_rate = (unsigned int)rate;
 	nabu_pauth_session = nabu_pauth_now_ns();
