+/*
+ * PAU queues identity samples of diagnostics events that fall outside the
+ * tracked name list.  The count of those events stays in Q.unt; this queue only
+ * records one sample per NABU_PAU_RATE events and its sample_count is never a
+ * trap count.  Producers copy scalars into a fixed ring with one try-lock
+ * attempt and count busy/full drops; a dedicated worker drains, aggregates per
+ * 5 s window and prints a bounded summary.
+ */
+struct nabu_pau_sample {
+	uint64_t ordinal;
+	uint64_t ts_ns;
+	uint64_t uid;
+	uint64_t tid;
+	int32_t pid;
+	uint8_t valid;
+	uint8_t name_len;
+	char name[NABU_PAUTH_NAME_MAX + 1];
+};
+
+struct nabu_pau_agg {
+	uint64_t uid;
+	uint64_t tid;
+	uint64_t count;
+	int32_t pid;
+	uint8_t used;
+	char name[NABU_PAUTH_NAME_MAX + 1];
+};
+
+static struct nabu_pau_sample nabu_pau_queue[NABU_PAU_QUEUE_CAP];
+static struct nabu_pau_agg nabu_pau_agg[NABU_PAU_AGG_KEYS];
+static volatile uint32_t nabu_pau_head;
+static volatile uint32_t nabu_pau_tail;
+static volatile int nabu_pau_lock;
+static int nabu_pau_enabled;
+static uint64_t nabu_pau_session;
+static uint64_t nabu_pau_start_ns;
+static uint64_t nabu_pau_deadline_ns;
+static unsigned int nabu_pau_phase;
+static uint64_t nabu_pau_eligible;
+static uint64_t nabu_pau_enq_ok;
+static uint64_t nabu_pau_busy;
+static uint64_t nabu_pau_full;
+static uint64_t nabu_pau_dequeued;
+static uint64_t nabu_pau_aggregated;
+static uint64_t nabu_pau_agg_overflow;
+static uint64_t nabu_pau_omitted_detail;
+static uint64_t nabu_pau_detail_total;
+static uint64_t nabu_pau_window_agg;
+static uint32_t nabu_pau_inflight;
+static uint64_t nabu_pau_output_skipped;
+static uint64_t nabu_pau_windows;
+static uint32_t nabu_pau_agg_keys;
+static int nabu_pau_chan;
+
 static inline uint64_t
 nabu_pauth_add(uint64_t *counter, uint64_t value)
 {
@@ -269,6 +335,98 @@ nabu_pauth_proc_index(proc_t p)
 	return -1;
 }
 
+/*
+ * Producer protocol: enter after the enabled check and before any work that
+ * could still enqueue; leave after the sample is published or dropped.  The
+ * finalizer stops production, waits for in_flight to drain, then drains the
+ * ring again, so a producer that passed the enabled check cannot enqueue
+ * after the end record.
+ */
+static int
+nabu_pau_producer_enter(uint64_t ordinal, uint64_t *now_out)
+{
+	uint64_t now;
+
+	if (!__atomic_load_n(&nabu_pau_enabled, __ATOMIC_ACQUIRE)) {
+		return 0;
+	}
+	__atomic_fetch_add(&nabu_pau_inflight, 1, __ATOMIC_ACQ_REL);
+	if ((ordinal & (uint64_t)(NABU_PAU_RATE - 1)) != 0) {
+		__atomic_fetch_sub(&nabu_pau_inflight, 1, __ATOMIC_RELEASE);
+		return 0;
+	}
+	now = nabu_pauth_now_ns();
+	if (now >= nabu_pau_deadline_ns) {
+		/* Hard collection deadline: stop producing before counting this
+		 * event as eligible, so the drained counters stay conserved. */
+		__atomic_store_n(&nabu_pau_enabled, 0, __ATOMIC_RELEASE);
+		__atomic_fetch_sub(&nabu_pau_inflight, 1, __ATOMIC_RELEASE);
+		return 0;
+	}
+	*now_out = now;
+	__atomic_fetch_add(&nabu_pau_eligible, 1, __ATOMIC_RELAXED);
+	return 1;
+}
+
+static void
+nabu_pau_producer_leave(void)
+{
+	__atomic_fetch_sub(&nabu_pau_inflight, 1, __ATOMIC_RELEASE);
+}
+
+static void
+nabu_pau_enqueue_sample(uint64_t ordinal, uint64_t now, proc_t p,
+    thread_t thread, uint64_t uid, uint64_t tid)
+{
+	struct nabu_pau_sample *slot;
+	uint32_t tail;
+	int expected = 0;
+
+	if (!__atomic_compare_exchange_n(&nabu_pau_lock, &expected, 1, 0,
+	    __ATOMIC_ACQ_REL, __ATOMIC_RELAXED)) {
+		__atomic_fetch_add(&nabu_pau_busy, 1, __ATOMIC_RELAXED);
+		return;
+	}
+	tail = nabu_pau_tail;
+	if ((uint32_t)(tail - nabu_pau_head) >= NABU_PAU_QUEUE_CAP) {
+		__atomic_store_n(&nabu_pau_lock, 0, __ATOMIC_RELEASE);
+		__atomic_fetch_add(&nabu_pau_full, 1, __ATOMIC_RELAXED);
+		return;
+	}
+	slot = &nabu_pau_queue[tail & (NABU_PAU_QUEUE_CAP - 1)];
+	slot->ordinal = ordinal;
+	slot->ts_ns = now;
+	slot->uid = uid;
+	slot->tid = tid;
+	slot->pid = p != NULL ? proc_getpid(p) : -1;
+	slot->valid = (p != NULL && thread != NULL) ? 1 : 0;
+	slot->name_len = 0;
+	if (p != NULL) {
+		const char *name = proc_name_address(p);
+		for (unsigned int i = 0; i < NABU_PAUTH_NAME_MAX && name[i] != '\0'; i++) {
+			slot->name[i] = name[i];
+			slot->name_len++;
+		}
+	}
+	slot->name[slot->name_len] = '\0';
+	__atomic_store_n(&nabu_pau_tail, tail + 1, __ATOMIC_RELEASE);
+	__atomic_store_n(&nabu_pau_lock, 0, __ATOMIC_RELEASE);
+	__atomic_fetch_add(&nabu_pau_enq_ok, 1, __ATOMIC_RELAXED);
+}
+
+static void
+nabu_pau_note_untracked(proc_t p, thread_t thread, uint64_t uid, uint64_t tid,
+    uint64_t ordinal)
+{
+	uint64_t now = 0;
+
+	if (!nabu_pau_producer_enter(ordinal, &now)) {
+		return;
+	}
+	nabu_pau_enqueue_sample(ordinal, now, p, thread, uid, tid);
+	nabu_pau_producer_leave();
+}
