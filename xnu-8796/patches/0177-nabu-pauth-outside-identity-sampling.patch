+		    sizeof(outside));
+		if (outside_set && outside != 0) {
+			if (outside != 1) {
+				printf("NABU PAU: rejected reason=outside\n");
+				return;
+			}
+			nabu_pau_session = nabu_pauth_session;
+			nabu_pau_start_ns = nabu_pauth_now_ns();
+			nabu_pau_deadline_ns = nabu_pau_start_ns +
+			    (uint64_t)NABU_PAU_DEADLINE_SECONDS * 1000000000ULL;
+			nabu_pau_phase = (unsigned int)(nabu_pau_start_ns /
+			    1000000000ULL) & 0xffffu;
+			nabu_pau_enabled = 1;
+			printf("NABU PAU C: v=1 s=%llu rate=%u cap=%u aggc=%u"
+			    " deadline=%llu start=%llu phase=%u\n",
+			    nabu_pau_session, NABU_PAU_RATE, NABU_PAU_QUEUE_CAP,
+			    NABU_PAU_AGG_KEYS, nabu_pau_deadline_ns,
+			    nabu_pau_start_ns, nabu_pau_phase);
+		}
+	}
 	printf("NABU PAUTH: v=1 s=%llu start rate=%u win=%us procs=%s/%s/%s/%s\n",
 	    nabu_pauth_session, nabu_pauth_rate, NABU_PAUTH_WINDOW_SECONDS,
 	    nabu_pauth_names[0], nabu_pauth_names[1], nabu_pauth_names[2],
@@ -823,6 +1243,14 @@ nabu_pauth_diag_start(void)
 	} else {
 		__atomic_fetch_add(&nabu_pauth_q_snapshot_fail, 1, __ATOMIC_RELAXED);
 	}
+	if (__atomic_load_n(&nabu_pau_enabled, __ATOMIC_RELAXED)) {
+		if (kernel_thread_start(nabu_pau_worker, NULL, &thread) == KERN_SUCCESS) {
+			thread_deallocate(thread);
+		} else {
+			__atomic_store_n(&nabu_pau_enabled, 0, __ATOMIC_RELEASE);
+			printf("NABU PAU: rejected reason=thread\n");
+		}
+	}
 }
 
