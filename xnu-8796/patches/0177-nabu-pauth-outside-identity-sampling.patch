+/* Outside-list identity sampling (D2), opt-in via nabupauthoutside=1. */
+#define NABU_PAU_QUEUE_CAP         4096
+#define NABU_PAU_RATE              4096
+#define NABU_PAU_WINDOW_SECONDS    5
+#define NABU_PAU_AGG_KEYS          256
+#define NABU_PAU_AGG_PROBE         8
