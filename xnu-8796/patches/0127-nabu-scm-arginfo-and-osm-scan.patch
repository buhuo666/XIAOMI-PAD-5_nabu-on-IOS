diff --git a/bsd/dev/nabu_cpu_freq.c b/bsd/dev/nabu_cpu_freq.c
--- a/bsd/dev/nabu_cpu_freq.c
+++ b/bsd/dev/nabu_cpu_freq.c
@@ -149,23 +149,29 @@
 }
 
 /*
- * Walk a cluster's table. Returns the index of its fastest row and that row's
- * frequency.
- *
- * The first attempt stopped at the first row whose frequency did not increase,
- * which cut every table short: the measured top rows were 1612800 / 1785600 /
- * 2419200 kHz where this tablet's own cpufreq reports 1785600 / 2419200 /
- * 2956800. The table does not simply repeat its last row.
- *
- * Each row word carries its own index in bits [15:8] -- row 0 reads 0x0004000f,
- * row 1 reads 0x50040115, row 2 reads 0x5004021a -- so the table's real end is
- * the first row whose index no longer matches its position. That is a fact read
- * from the hardware rather than a guess about the ending.
+ * Walk a cluster's table and report how many rows it really has.
+ *
+ * Three layouts were tried and all three produced frequencies that disagreed
+ * with this tablet's own cpufreq output. Comparing the raw words settled it:
+ *
+ *   little base 0x18321000, rows 0..2 = 0x0004000f 0x50040115 0x5004021a
+ *     -> codes 15, 21, 26 -> 300000/403200/499200 kHz, which IS little's table
+ *   big base 0x18323000, rows 0..2 = the same three words
+ *     -> so that base does not begin big's table
+ *   prime base 0x18325800, rows 0..2 = 0x40040025 0x4004012b 0x40040231
+ *     -> codes 37, 43, 49 -> 710400/825600/940800 kHz, which is BIG's table
+ *        shifted by one row, then prime's
+ *
+ * The offset 0x110, the 32-byte row and the code x 19.2 MHz formula are all
+ * correct; the bases simply do not each point at the start of their own table.
+ * So this walk starts where it is told to and stops at the first row whose
+ * embedded index does not continue, reporting what it actually found instead of
+ * asserting a fixed row count.
  */
 static uint32_t
 nabu_cpu_scan(struct nabu_cluster *cluster, uint32_t *top_khz_out)
 {
-	uint32_t top_row = 0, top_khz = 0;
+	uint32_t top_row = 0, top_khz = 0, expected = 0;
 
 	for (uint32_t row = 0; row < NABU_OSM_TABLE_ROWS; row++) {
 		uint32_t word = *(volatile uint32_t *)(cluster->base +
@@ -173,8 +179,15 @@
 		uint32_t index = NABU_OSM_ROW_INDEX(word);
 		uint32_t khz;
 
-		if (index != row) {
-			break;          /* past the end: this row is not the table's */
+		/*
+		 * The first row read sets the index the rest must follow: a base
+		 * may begin partway into a table, so the sequence need not start
+		 * at 0.
+		 */
+		if (row == 0) {
+			expected = index;
+		} else if (index != expected) {
+			break;
 		}
 		khz = nabu_cpu_row_khz(word);
 		if (khz == 0) {
@@ -182,15 +195,20 @@
 		}
 		top_row = row;
 		top_khz = khz;
+		expected++;
 	}
 	*top_khz_out = top_khz;
 	return top_row;
 }
 
 /*
- * Read-only pass: for every cluster, report the current row, the top row and
- * its frequency, plus the first few raw table words. Nothing is written, so a
- * wrong assumption about the layout cannot damage anything.
+ * Read-only pass.
+ *
+ * Besides the per-cluster summary this dumps the first rows of every table
+ * verbatim, because the three bases turned out not to each begin their own
+ * table: comparing the raw words is what showed that big's base reads little's
+ * table and prime's base reads big's, one row in. The dump makes that visible
+ * in one line per cluster instead of another round of guesswork.
  */
 static bool
 nabu_cpu_read_only(void)
@@ -206,19 +224,27 @@
 		}
 		top_row = nabu_cpu_scan(cluster, &top_khz);
 		current = *(volatile uint32_t *)(cluster->base + NABU_OSM_PERF_STATE);
-		printf("nabucpu: %s (0x%llx, %u cores): current row %u, top row %u = %u kHz\n",
-		    cluster->name, cluster->phys, cluster->cores, current, top_row,
-		    top_khz);
-		printf("nabucpu: %s: rows 0..3 = 0x%08x 0x%08x 0x%08x 0x%08x\n",
-		    cluster->name,
-		    *(volatile uint32_t *)(cluster->base + NABU_OSM_FREQ_LUT),
-		    *(volatile uint32_t *)(cluster->base + NABU_OSM_FREQ_LUT + NABU_OSM_ROW_SIZE),
-		    *(volatile uint32_t *)(cluster->base + NABU_OSM_FREQ_LUT + 2 * NABU_OSM_ROW_SIZE),
-		    *(volatile uint32_t *)(cluster->base + NABU_OSM_FREQ_LUT + 3 * NABU_OSM_ROW_SIZE));
-		printf("nabucpu: %s: dcvs_ctrl=0x%08x current_vote=0x%08x\n",
-		    cluster->name,
-		    *(volatile uint32_t *)(cluster->base + NABU_OSM_DCVS_CTRL),
-		    *(volatile uint32_t *)(cluster->base + NABU_OSM_CURRENT_VOTE));
+		printf("nabucpu: %s (0x%llx, %u cores): perf_state=%u, rows walked=%u, "
+		    "top=%u kHz\n",
+		    cluster->name, cluster->phys, cluster->cores, current,
+		    top_row + 1, top_khz);
+
+		/* Rows 0..7: enough to see where this base really starts. */
+		for (uint32_t row = 0; row < 8; row += 4) {
+			uint32_t base_off = NABU_OSM_FREQ_LUT +
+			    NABU_OSM_ROW_SIZE * row;
+			printf("nabucpu: %s: row%u..%u = 0x%08x 0x%08x 0x%08x 0x%08x "
+			    "(codes %u %u %u %u)\n",
+			    cluster->name, row, row + 3,
+			    *(volatile uint32_t *)(cluster->base + base_off),
+			    *(volatile uint32_t *)(cluster->base + base_off + NABU_OSM_ROW_SIZE),
+			    *(volatile uint32_t *)(cluster->base + base_off + 2 * NABU_OSM_ROW_SIZE),
+			    *(volatile uint32_t *)(cluster->base + base_off + 3 * NABU_OSM_ROW_SIZE),
+			    NABU_OSM_ROW_MULT(*(volatile uint32_t *)(cluster->base + base_off)),
+			    NABU_OSM_ROW_MULT(*(volatile uint32_t *)(cluster->base + base_off + NABU_OSM_ROW_SIZE)),
+			    NABU_OSM_ROW_MULT(*(volatile uint32_t *)(cluster->base + base_off + 2 * NABU_OSM_ROW_SIZE)),
+			    NABU_OSM_ROW_MULT(*(volatile uint32_t *)(cluster->base + base_off + 3 * NABU_OSM_ROW_SIZE)));
+		}
 		nabu_cpu_sleep_ms(cpu_pause_ms);
 	}
 	return true;
diff --git a/bsd/dev/nabu_gpu_trustzone.c b/bsd/dev/nabu_gpu_trustzone.c
--- a/bsd/dev/nabu_gpu_trustzone.c
+++ b/bsd/dev/nabu_gpu_trustzone.c
@@ -40,18 +40,39 @@
 #include <vm/vm_kern.h>
 
 /* ---------------------------------------------------------------------------
- * The secure monitor's call encoding (qcom_scm-smc.c).
+ * The secure monitor's call encoding (qcom_scm-smc.c, qcom_scm.h).
  * -------------------------------------------------------------------------*/
 #define NABU_SCM_FAST               (1ull << 31)  /* answered without preemption */
 #define NABU_SCM_64                 (1ull << 30)
 #define NABU_SCM_SIP                (2ull << 24)  /* the SoC vendor's call space */
 #define NABU_SCM_CALL(service, cmd) (((uint64_t)(service) << 8) | (cmd))
 
-#define NABU_SCM_IS_CALL_AVAILABLE  NABU_SCM_CALL(6, 1)
-#define NABU_SCM_PAS_IS_SUPPORTED   NABU_SCM_CALL(2, 7)
-
-/* The word that describes a call's arguments: one plain number. */
-#define NABU_SCM_ONE_VALUE          1
+/* Service numbers (QCOM_SCM_SVC_*). */
+#define NABU_SCM_SVC_PIL            2   /* peripheral image loader */
+#define NABU_SCM_SVC_INFO           6   /* the monitor's own information */
+
+/* Commands (QCOM_SCM_PIL_PAS_* and QCOM_SCM_INFO_*). */
+#define NABU_SCM_INFO_IS_CALL_AVAIL 0x01
+#define NABU_SCM_PAS_IS_SUPPORTED   0x07
+#define NABU_SCM_PAS_INIT_IMAGE     0x01
+#define NABU_SCM_PAS_MEM_SETUP      0x02
+#define NABU_SCM_PAS_AUTH_AND_RESET 0x05
+
+#define NABU_SCM_FNID(svc, cmd)     NABU_SCM_CALL(svc, cmd)
+
+/*
+ * The argument descriptor passed in x1. This was the bug that made the first
+ * attempt report "image 13 not supported": the value is not a plain count.
+ * QCOM_SCM_ARGS(n) packs the number of arguments in the low four bits and one
+ * two-bit type per argument above it (QCOM_SCM_VAL == 1 for a plain number):
+ *
+ *   QCOM_SCM_ARGS(1) = (1 << 4) | 1 = 0x11
+ *
+ * Passing 0x1 described zero arguments of one type, so the monitor saw a
+ * call with no arguments and answered 0.
+ */
+#define NABU_SCM_ARGS_ONE_VAL       0x11u
+
 #define NABU_SCM_INTERRUPTED        1  /* x0 == 1 asks the call to be made again */
 
 /* Peripheral image numbers this port cares about (qcom_scm.h). */
@@ -143,8 +164,10 @@
 	nabu_gpu3_announce("ask whether the vendor's call set is served at all");
 	status = nabu_scm_call("is the call set available",
 	    NABU_SCM_FAST | NABU_SCM_64 | NABU_SCM_SIP |
-	    NABU_SCM_IS_CALL_AVAILABLE,
-	    NABU_SCM_ONE_VALUE, NABU_SCM_CALL(6, 1), 0, &answer);
+	    NABU_SCM_FNID(NABU_SCM_SVC_INFO, NABU_SCM_INFO_IS_CALL_AVAIL),
+	    NABU_SCM_ARGS_ONE_VAL,
+	    NABU_SCM_FNID(NABU_SCM_SVC_PIL, NABU_SCM_PAS_IS_SUPPORTED) |
+	    NABU_SCM_SIP, 0, &answer);
 	if (status != 0) {
 		printf("nabugpu3: the call set is refused (status %d); firmware "
 		    "loading through TrustZone is not available to this kernel\n",
@@ -154,18 +177,27 @@
 	printf("nabugpu3: the vendor's call set is served (answer 0x%llx)\n",
 	    answer);
 
-	nabu_gpu3_announce("ask whether the GPU's image can be authenticated");
-	status = nabu_scm_call("is peripheral authentication supported",
-	    NABU_SCM_FAST | NABU_SCM_64 | NABU_SCM_SIP |
-	    NABU_SCM_PAS_IS_SUPPORTED,
-	    NABU_SCM_ONE_VALUE, NABU_PAS_GPU, 0, &answer);
-	if (status != 0) {
-		printf("nabugpu3: peripheral authentication refused (status %d)\n",
-		    status);
-	} else {
-		printf("nabugpu3: image %d (GPU) supported = %llu\n",
-		    NABU_PAS_GPU, answer);
-	}
+	/*
+	 * Which image numbers the monitor will authenticate. The reference port
+	 * uses 13 on its SoC; this tablet's own loader names the GPU's zap as a
+	 * pil-tz image, so the number is worth reading rather than assuming.
+	 * Querying a range costs nothing and changes no state.
+	 */
+	nabu_gpu3_announce("ask which peripheral image numbers can be authenticated");
+	for (uint32_t image = 0; image <= 20; image++) {
+		status = nabu_scm_call("is this image supported",
+		    NABU_SCM_FAST | NABU_SCM_64 | NABU_SCM_SIP |
+		    NABU_SCM_FNID(NABU_SCM_SVC_PIL, NABU_SCM_PAS_IS_SUPPORTED),
+		    NABU_SCM_ARGS_ONE_VAL, image, 0, &answer);
+		if (status == 0 && answer) {
+			printf("nabugpu3: image %u: SUPPORTED%s\n", image,
+			    image == NABU_PAS_GPU ? " (the reference port's GPU "
+			    "number)" : "");
+		}
+		nabu_gpu3_sleep_ms(20);
+	}
+
+	printf("nabugpu3: image scan finished; no image was loaded and no state changed\n");
 
