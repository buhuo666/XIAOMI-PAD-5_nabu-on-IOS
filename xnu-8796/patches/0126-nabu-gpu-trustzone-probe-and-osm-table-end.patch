diff --git a/bsd/dev/nabu_gpu_trustzone.c b/bsd/dev/nabu_gpu_trustzone.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/nabu_gpu_trustzone.c
@@ -0,0 +1,178 @@
+/*
+ * nabu GPU bring-up, stage 3a: ask TrustZone whether it will help at all.
+ *
+ * Stage 2 switched the GPU's CX half on and its branch clocks with it; all five
+ * clocks went from "OFF bit set" to running. The next step in the reference port
+ * hands the GPU's images to TrustZone for authentication, which needs a secure
+ * monitor call. Before any image is offered, this asks only questions:
+ *
+ *   SCM_IS_CALL_AVAILABLE   does this monitor serve the vendor's call set?
+ *   SCM_PAS_IS_SUPPORTED    does it support the peripheral authenticator, and
+ *                           for which image numbers? The GPU is one of them.
+ *
+ * Neither call changes device state, so a refusal costs nothing. What comes back
+ * decides whether the port can load firmware the vendor signed, or has to look
+ * for another way.
+ *
+ * The call convention follows qcom_scm-smc.c: a fast call in x0 with the service
+ * and command packed together, arguments in x1..x5, a session handle in x6, and
+ * the answer in x1 on return. A call reported as interrupted (x0 == 1) is
+ * repeated with that value as the function, which is how the protocol asks to be
+ * resumed.
+ *
+ * Boot arguments:
+ *   nabugpu3=1        run at all
+ *   nabugpu3_pause=MS wait after each announcement (default 1500)
+ *   nabugpu3_watch=S  report liveness afterwards
+ */
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <mach/vm_param.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+#include <vm/vm_kern.h>
+
+/* ---------------------------------------------------------------------------
+ * The secure monitor's call encoding (qcom_scm-smc.c).
+ * -------------------------------------------------------------------------*/
+#define NABU_SCM_FAST               (1ull << 31)  /* answered without preemption */
+#define NABU_SCM_64                 (1ull << 30)
+#define NABU_SCM_SIP                (2ull << 24)  /* the SoC vendor's call space */
+#define NABU_SCM_CALL(service, cmd) (((uint64_t)(service) << 8) | (cmd))
+
+#define NABU_SCM_IS_CALL_AVAILABLE  NABU_SCM_CALL(6, 1)
+#define NABU_SCM_PAS_IS_SUPPORTED   NABU_SCM_CALL(2, 7)
+
+/* The word that describes a call's arguments: one plain number. */
+#define NABU_SCM_ONE_VALUE          1
+#define NABU_SCM_INTERRUPTED        1  /* x0 == 1 asks the call to be made again */
+
+/* Peripheral image numbers this port cares about (qcom_scm.h). */
+#define NABU_PAS_GPU                13
+
+static uint32_t gpu3_pause_ms = 1500;
+static uint32_t gpu3_watch_secs;
+
+static void
+nabu_gpu3_sleep_ms(unsigned ms)
+{
+	static int gpu3_sleep_chan;
+	uint64_t deadline;
+
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&gpu3_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+nabu_gpu3_announce(const char *what)
+{
+	printf("nabugpu3: %s\n", what);
+	nabu_gpu3_sleep_ms(gpu3_pause_ms);
+}
+
+/*
+ * One secure monitor call. Returns the monitor's own status in *status_out and
+ * its answer word in *answer_out; the return value is 0 when a call completed.
+ */
+static int32_t
+nabu_scm_call(const char *what, uint64_t function, uint64_t arguments,
+    uint64_t first, uint64_t second, uint64_t *answer_out)
+{
+	uint64_t session = 0;
+
+	printf("nabugpu3: about to ask TrustZone %s: smc 0x%llx args 0x%llx, 0x%llx, 0x%llx\n",
+	    what, function, arguments, first, second);
+	nabu_gpu3_sleep_ms(gpu3_pause_ms);
+
+	for (int attempt = 0; attempt < 100; attempt++) {
+		register uint64_t x0 __asm__("x0") =
+		    attempt == 0 ? function : NABU_SCM_INTERRUPTED;
+		register uint64_t x1 __asm__("x1") = arguments;
+		register uint64_t x2 __asm__("x2") = first;
+		register uint64_t x3 __asm__("x3") = second;
+		register uint64_t x4 __asm__("x4") = 0;
+		register uint64_t x5 __asm__("x5") = 0;
+		register uint64_t x6 __asm__("x6") = session;
+		register uint64_t x7 __asm__("x7") = 0;
+
+		__asm__ volatile ("smc #0"
+		    : "+r" (x0), "+r" (x1), "+r" (x2), "+r" (x3),
+		      "+r" (x4), "+r" (x5), "+r" (x6), "+r" (x7)
+		    :
+		    : "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15",
+		      "x16", "x17", "memory");
+
+		session = x6;
+		if (x0 != NABU_SCM_INTERRUPTED) {
+			printf("nabugpu3: TrustZone returns %d, answer 0x%llx\n",
+			    (int32_t)x0, x1);
+			*answer_out = x1;
+			return (int32_t)x0;
+		}
+	}
+	printf("nabugpu3: TrustZone keeps saying the call was interrupted\n");
+	return -1;
+}
+
+/* ---------------------------------------------------------------------------
+ * Entry point
+ * -------------------------------------------------------------------------*/
+void
+nabu_gpu_trustzone(void)
+{
+	uint32_t enable = 0;
+	uint64_t answer = 0;
+	int32_t status;
+
+	if (!PE_parse_boot_argn("nabugpu3", &enable, sizeof(enable)) || !enable) {
+		return;
+	}
+	(void)PE_parse_boot_argn("nabugpu3_pause", &gpu3_pause_ms, sizeof(gpu3_pause_ms));
+	(void)PE_parse_boot_argn("nabugpu3_watch", &gpu3_watch_secs, sizeof(gpu3_watch_secs));
+
+	printf("nabugpu3: ask TrustZone what it will do for this kernel (no image is offered)\n");
+
+	nabu_gpu3_announce("ask whether the vendor's call set is served at all");
+	status = nabu_scm_call("is the call set available",
+	    NABU_SCM_FAST | NABU_SCM_64 | NABU_SCM_SIP |
+	    NABU_SCM_IS_CALL_AVAILABLE,
+	    NABU_SCM_ONE_VALUE, NABU_SCM_CALL(6, 1), 0, &answer);
+	if (status != 0) {
+		printf("nabugpu3: the call set is refused (status %d); firmware "
+		    "loading through TrustZone is not available to this kernel\n",
+		    status);
+		goto watch;
+	}
+	printf("nabugpu3: the vendor's call set is served (answer 0x%llx)\n",
+	    answer);
+
+	nabu_gpu3_announce("ask whether the GPU's image can be authenticated");
+	status = nabu_scm_call("is peripheral authentication supported",
+	    NABU_SCM_FAST | NABU_SCM_64 | NABU_SCM_SIP |
+	    NABU_SCM_PAS_IS_SUPPORTED,
+	    NABU_SCM_ONE_VALUE, NABU_PAS_GPU, 0, &answer);
+	if (status != 0) {
+		printf("nabugpu3: peripheral authentication refused (status %d)\n",
+		    status);
+	} else {
+		printf("nabugpu3: image %d (GPU) supported = %llu\n",
+		    NABU_PAS_GPU, answer);
+	}
+
+watch:
+	if (gpu3_watch_secs) {
+		for (uint32_t second = 1; second <= gpu3_watch_secs; second++) {
+			nabu_gpu3_sleep_ms(1000);
+			printf("nabugpu3: alive %u/%u s\n", second, gpu3_watch_secs);
+		}
+	}
+	printf("nabugpu3: finished\n");
+}
