diff --git a/iokit/Kernel/arm/NabuSurface.h b/iokit/Kernel/arm/NabuSurface.h
--- a/iokit/Kernel/arm/NabuSurface.h
+++ b/iokit/Kernel/arm/NabuSurface.h
@@ -48,6 +48,10 @@
 /* Retained surface for an id, or NULL. */
 NabuSurface *nabu_surface_copy(uint32_t id);
 
+/* Optional framebuffer bring-up diagnostics and a best-effort BGRA hint. */
+void nabu_surface_probe_all(void);
+uint32_t nabu_surface_bgra_hint_id(void);
+
 /*
  * Publish physical memory (the panel framebuffer) as a surface. Returns a
  * retained surface that stays in the id table until released by the caller
diff --git a/iokit/Kernel/arm/NabuSurface.cpp b/iokit/Kernel/arm/NabuSurface.cpp
--- a/iokit/Kernel/arm/NabuSurface.cpp
+++ b/iokit/Kernel/arm/NabuSurface.cpp
@@ -184,6 +184,61 @@
 	return s;
 }
 
+void
+nabu_surface_probe_all(void)
+{
+	uint32_t logged = 0;
+	for (uint32_t id = 1; id < NABU_SURFACE_MAX_ID; id++) {
+		NabuSurface *s = nabu_surface_copy(id);
+		if (s == NULL) {
+			continue;
+		}
+		/* Log outside the table lock, retaining the surface while in use. */
+		if (logged < 32) {
+			IOLog("NABU SURF: probe id=%u %ux%u row=%u format=0x%08x planes=%u\n",
+			    s->id, s->width, s->height, s->bytesPerRow,
+			    s->pixelFormat, s->planeCount);
+		}
+		logged++;
+		s->release();
+	}
+	IOLog("NABU SURF: probe found %u surfaces (at most 32 logged)\n", logged);
+}
+
+uint32_t
+nabu_surface_bgra_hint_id(void)
+{
+	if (nabu_surface_lock == NULL) {
+		return 0;
+	}
+	uint32_t hint = 0;
+	IOLockLock(nabu_surface_lock);
+	/* Search backwards from the latest allocation, including id wraparound.
+	 * Buffer-backed surfaces exclude the physical scanout framebuffer.
+	 * This is only a diagnostic hint, not a compositor or ownership fence. */
+	uint32_t id = nabu_surface_next_id;
+	for (uint32_t n = 1; n < NABU_SURFACE_MAX_ID; n++) {
+		id = id > 1 ? id - 1 : NABU_SURFACE_MAX_ID - 1;
+		NabuSurface *s = nabu_surface_table[id];
+		if (s == NULL || s->pixelFormat != 0x42475241 ||
+		    s->bytesPerElement != 4 || s->elementWidth != 1 ||
+		    s->elementHeight != 1 || s->planeCount != 0 ||
+		    s->width == 0 || s->height == 0 ||
+		    s->bytesPerRow < (uint64_t)s->width * 4 ||
+		    OSDynamicCast(IOBufferMemoryDescriptor, s->memory) == NULL) {
+			continue;
+		}
+		uint64_t end = s->offset + (uint64_t)s->height * s->bytesPerRow;
+		if (end <= s->memory->getLength()) {
+			hint = id;
+			break;
+		}
+	}
+	IOLockUnlock(nabu_surface_lock);
+	/* The caller must acquire a retained surface and recheck it before use. */
+	return hint;
+}
+
 /* The table lock; the framebuffer may publish a surface before the root starts. */
 static void
 nabu_surface_init_lock(void)
