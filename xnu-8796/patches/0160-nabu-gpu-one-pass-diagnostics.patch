diff --git a/bsd/dev/nabu_gpu_diag.h b/bsd/dev/nabu_gpu_diag.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/nabu_gpu_diag.h
@@ -0,0 +1,68 @@
+/*
+ * Opt-in RAM-only progress records. Each lane has exactly one writer.
+ * Readers never wait for the target thread or touch GPU registers.
+ */
+#ifndef NABU_GPU_DIAG_H
+#define NABU_GPU_DIAG_H
+
+#include <sys/types.h>
+
+enum nabu_gpu_diag_lane {
+	NABU_DIAG_PATH, NABU_DIAG_CLOCK, NABU_DIAG_WAIT, NABU_DIAG_EARLY_IO,
+	NABU_DIAG_CACHE, NABU_DIAG_WORKER, NABU_DIAG_GMU_IO,
+	NABU_DIAG_GMU_PHASE, NABU_DIAG_HFI, NABU_DIAG_LOG, NABU_DIAG_LANES
+};
+
+enum nabu_gpu_diag_op {
+	NABU_DIAG_CONFIG = 1, NABU_DIAG_EARLY_CALL, NABU_DIAG_MAP,
+	NABU_DIAG_ANNOUNCE, NABU_DIAG_CLOCK_FINISHED,
+	NABU_DIAG_READ32, NABU_DIAG_WRITE32, NABU_DIAG_WRITE64,
+	NABU_DIAG_DEADLINE, NABU_DIAG_ASSERT_WAIT, NABU_DIAG_THREAD_BLOCK,
+	NABU_DIAG_ROOT, NABU_DIAG_SCHEDULE, NABU_DIAG_WORKER_ENTER,
+	NABU_DIAG_CACHE_PREPARE, NABU_DIAG_CACHE_CLEAN, NABU_DIAG_CACHE_SET,
+	NABU_DIAG_CACHE_ATTR, NABU_DIAG_CACHE_TRANSLATE, NABU_DIAG_RESOURCES,
+	NABU_DIAG_COLD_START, NABU_DIAG_PHASE, NABU_DIAG_CLEAN,
+	NABU_DIAG_BARRIER, NABU_DIAG_DELAY, NABU_DIAG_HFI_QUERY,
+	NABU_DIAG_HFI_INPUT, NABU_DIAG_HFI_VERSION, NABU_DIAG_HFI_LAYOUT,
+	NABU_DIAG_HFI_PUBLISH, NABU_DIAG_HFI_DOORBELL, NABU_DIAG_HFI_POLL,
+	NABU_DIAG_HFI_RECEIVE, NABU_DIAG_HFI_RESULT, NABU_DIAG_WORKER_EXIT,
+	NABU_DIAG_LOG_SLEEP, NABU_DIAG_LOG_LOCK, NABU_DIAG_LOG_WRITE,
+	NABU_DIAG_LOG_HEADER, NABU_DIAG_LOG_SYNC, NABU_DIAG_LOG_COMMIT
+};
+
+/* Little-endian on the tablet. Extension starts at byte 64 of the log header. */
+#define NABU_GPU_DIAG_HEADER_OFFSET 64u
+#define NABU_GPU_DIAG_VERSION 1u
+#define NABU_GPU_DIAG_ENTER 1u
+#define NABU_GPU_DIAG_DONE 2u
+
+struct nabu_gpu_diag_record {
+	uint32_t seq, op, edge, region, offset, value, detail, cpu, irq, preempt;
+	uint64_t started_ns, updated_ns, deadline_ns;
+};
+
+struct nabu_gpu_diag_snapshot {
+	char magic[8];
+	uint32_t version, bytes, lanes, valid_mask;
+	uint64_t flush_sequence, log_total, captured_ns;
+	uint32_t observer_ticks, checksum;
+	struct nabu_gpu_diag_record record[NABU_DIAG_LANES];
+};
+
+#if defined(NABU_GPU_DIAG_HOST_NOOP)
+static inline void nabu_gpu_diag_start(void) {}
+static inline void nabu_gpu_diag_begin(unsigned l, unsigned o, unsigned r,
+    uint32_t a, uint32_t v, uint64_t d)
+{ (void)l; (void)o; (void)r; (void)a; (void)v; (void)d; }
+static inline void nabu_gpu_diag_end(unsigned l, uint32_t v, uint32_t d)
+{ (void)l; (void)v; (void)d; }
+#else
+void nabu_gpu_diag_start(void);
+void nabu_gpu_diag_begin(unsigned lane, unsigned op, unsigned region,
+    uint32_t offset, uint32_t value, uint64_t deadline);
+void nabu_gpu_diag_end(unsigned lane, uint32_t value, uint32_t detail);
+void nabu_gpu_diag_header(void *header, uint32_t capacity,
+    uint64_t sequence, uint64_t total);
+#endif
+
+#endif /* NABU_GPU_DIAG_H */
diff --git a/bsd/dev/nabu_gpu_diag.c b/bsd/dev/nabu_gpu_diag.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/nabu_gpu_diag.c
@@ -0,0 +1,232 @@
+/*
+ * One-pass GPU startup diagnostics. No allocation, locks, printf, storage or
+ * hardware access in the instrumented path. Publication uses atomic fields
+ * and a bounded seqlock read, so a stalled writer cannot stall its observer.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <machine/atomic.h>
+#include <pexpert/pexpert.h>
+#include <libkern/libkern.h>
+#include "nabu_gpu_diag.h"
+
+#if defined(ARM64_BOARD_CONFIG_NABU)
+
+extern int get_preemption_level(void);
+extern kern_return_t thread_terminate(thread_t);
+extern uint64_t nabu_log_position(void);
+extern uint64_t nabu_log_committed_position(void);
+extern int hz;
+
+struct diag_slot {
+	uint32_t _Atomic seq, op, edge, region, offset, value, detail, cpu, irq, preempt;
+	uint64_t _Atomic started_ns, updated_ns, deadline_ns;
+};
+
+static struct diag_slot diag_slots[NABU_DIAG_LANES];
+static bool diag_enabled, diag_started;
+static uint32_t _Atomic diag_ticks;
+static int diag_sleep_channel;
+
+_Static_assert(sizeof(struct nabu_gpu_diag_record) == 64, "diagnostic record ABI");
+_Static_assert(sizeof(struct nabu_gpu_diag_snapshot) == 696, "diagnostic snapshot ABI");
+_Static_assert(NABU_GPU_DIAG_HEADER_OFFSET + sizeof(struct nabu_gpu_diag_snapshot) <= 4096,
+    "diagnostics must fit the existing log header block");
+
+static uint64_t
+diag_now(void)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns;
+}
+
+void
+nabu_gpu_diag_begin(unsigned lane, unsigned op, unsigned region,
+    uint32_t offset, uint32_t value, uint64_t deadline)
+{
+	if (!diag_enabled || lane >= NABU_DIAG_LANES) {
+		return;
+	}
+	struct diag_slot *slot = &diag_slots[lane];
+	uint64_t now = diag_now(), deadline_ns = 0;
+	if (deadline != 0) {
+		absolutetime_to_nanoseconds(deadline, &deadline_ns);
+	}
+	/* Acq_rel prevents payload updates from preceding the odd generation. */
+	os_atomic_add(&slot->seq, 1, acq_rel);
+	os_atomic_store(&slot->op, op, relaxed);
+	os_atomic_store(&slot->edge, NABU_GPU_DIAG_ENTER, relaxed);
+	os_atomic_store(&slot->region, region, relaxed);
+	os_atomic_store(&slot->offset, offset, relaxed);
+	os_atomic_store(&slot->value, value, relaxed);
+	os_atomic_store(&slot->detail, 0, relaxed);
+	os_atomic_store(&slot->cpu, (uint32_t)cpu_number(), relaxed);
+	os_atomic_store(&slot->irq, ml_get_interrupts_enabled() ? 1u : 0u, relaxed);
+	os_atomic_store(&slot->preempt, (uint32_t)get_preemption_level(), relaxed);
+	os_atomic_store(&slot->started_ns, now, relaxed);
+	os_atomic_store(&slot->updated_ns, now, relaxed);
+	os_atomic_store(&slot->deadline_ns, deadline_ns, relaxed);
+	os_atomic_add(&slot->seq, 1, release);
+}
+
+void
+nabu_gpu_diag_end(unsigned lane, uint32_t value, uint32_t detail)
+{
+	if (!diag_enabled || lane >= NABU_DIAG_LANES) {
+		return;
+	}
+	struct diag_slot *slot = &diag_slots[lane];
+	os_atomic_add(&slot->seq, 1, acq_rel);
+	os_atomic_store(&slot->value, value, relaxed);
+	os_atomic_store(&slot->detail, detail, relaxed);
+	os_atomic_store(&slot->updated_ns, diag_now(), relaxed);
+	os_atomic_store(&slot->edge, NABU_GPU_DIAG_DONE, relaxed);
+	os_atomic_add(&slot->seq, 1, release);
+}
+
+static bool
+diag_read(unsigned lane, struct nabu_gpu_diag_record *out)
+{
+	struct diag_slot *slot = &diag_slots[lane];
+	for (unsigned attempt = 0; attempt < 2; attempt++) {
+		uint32_t seq = os_atomic_load(&slot->seq, acquire);
+		if (seq == 0 || (seq & 1u) != 0) {
+			continue;
+		}
+#define DIAG_COPY(field) out->field = os_atomic_load(&slot->field, relaxed)
+		DIAG_COPY(op); DIAG_COPY(edge); DIAG_COPY(region); DIAG_COPY(offset);
+		DIAG_COPY(value); DIAG_COPY(detail); DIAG_COPY(cpu);
+		DIAG_COPY(irq); DIAG_COPY(preempt); DIAG_COPY(started_ns);
+		DIAG_COPY(updated_ns); DIAG_COPY(deadline_ns);
+#undef DIAG_COPY
+		/* The final generation must be read after all payload fields. */
+		os_atomic_thread_fence(acquire);
+		if (seq == os_atomic_load(&slot->seq, relaxed)) {
+			out->seq = seq;
+			return true;
+		}
+	}
+	bzero(out, sizeof(*out));
+	return false;
+}
+
+static void
+diag_snapshot(struct nabu_gpu_diag_snapshot *out, uint64_t sequence, uint64_t total)
+{
+	bzero(out, sizeof(*out));
+	memcpy(out->magic, "NABUD160", 8);
+	out->version = NABU_GPU_DIAG_VERSION;
+	out->bytes = sizeof(*out);
+	out->lanes = NABU_DIAG_LANES;
+	out->flush_sequence = sequence;
+	out->log_total = total;
+	out->observer_ticks = os_atomic_load(&diag_ticks, relaxed);
+	for (unsigned lane = 0; lane < NABU_DIAG_LANES; lane++) {
+		if (diag_read(lane, &out->record[lane])) {
+			out->valid_mask |= 1u << lane;
+		}
+	}
+	out->captured_ns = diag_now();
+}
+
+void
+nabu_gpu_diag_header(void *header, uint32_t capacity, uint64_t sequence, uint64_t total)
+{
+	if (!diag_enabled || capacity < NABU_GPU_DIAG_HEADER_OFFSET +
+	    sizeof(struct nabu_gpu_diag_snapshot)) {
+		return;
+	}
+	struct nabu_gpu_diag_snapshot snapshot;
+	diag_snapshot(&snapshot, sequence, total);
+	const uint8_t *bytes = (const uint8_t *)&snapshot;
+	uint32_t checksum = 2166136261u;
+	for (unsigned i = 0; i < sizeof(snapshot); i++) {
+		checksum = (checksum ^ bytes[i]) * 16777619u;
+	}
+	snapshot.checksum = checksum;
+	memcpy((uint8_t *)header + NABU_GPU_DIAG_HEADER_OFFSET, &snapshot, sizeof(snapshot));
+}
+
+static void
+diag_observer(__unused void *arg, __unused wait_result_t wr)
+{
+	uint32_t previous[NABU_DIAG_LANES] = {0};
+	printf("nabugpudiag: observer=started version=1 lanes=10 interval_ms=1000 ticks_max=360\n");
+	for (uint32_t tick = 1; tick <= 360; tick++) {
+		struct nabu_gpu_diag_snapshot snapshot;
+		os_atomic_store(&diag_ticks, tick, relaxed);
+		diag_snapshot(&snapshot, 0, 0);
+		printf("nabugpudiag: tick=%u now_ns=%llu total=%llu committed=%llu valid=0x%x\n",
+		    tick, snapshot.captured_ns, nabu_log_position(),
+		    nabu_log_committed_position(), snapshot.valid_mask);
+		for (unsigned lane = 0; lane < NABU_DIAG_LANES; lane++) {
+			const struct nabu_gpu_diag_record *r = &snapshot.record[lane];
+			if ((snapshot.valid_mask & (1u << lane)) == 0) {
+				continue;
+			}
+			bool pending = r->edge == NABU_GPU_DIAG_ENTER &&
+			    snapshot.captured_ns >= r->started_ns &&
+			    snapshot.captured_ns - r->started_ns >= 5ULL * NSEC_PER_SEC;
+			bool overdue = pending && r->deadline_ns != 0 &&
+			    snapshot.captured_ns > r->deadline_ns;
+			if (r->seq == previous[lane] && tick % 10 != 0 && !pending) {
+				continue;
+			}
+			printf("nabugpudiag: lane=%u seq=%u op=%u edge=%u region=%u offset=0x%x "
+			    "value=0x%x detail=0x%x cpu=%u irq=%u preempt=%u start_ns=%llu "
+			    "update_ns=%llu deadline_ns=%llu sample_ns=%llu pending=%u overdue=%u\n",
+			    lane, r->seq, r->op, r->edge, r->region, r->offset,
+			    r->value, r->detail, r->cpu, r->irq, r->preempt,
+			    r->started_ns, r->updated_ns, r->deadline_ns, snapshot.captured_ns,
+			    pending ? 1u : 0u, overdue ? 1u : 0u);
+			previous[lane] = r->seq;
+		}
+		(void)tsleep(&diag_sleep_channel, PZERO, "gpudiag", hz);
+	}
+	printf("nabugpudiag: observer=finished; header snapshots remain enabled\n");
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+nabu_gpu_diag_start(void)
+{
+	uint32_t enable = 0, hfi = 0, clocks = 0, start = 0, logging = 0;
+	uint32_t pause = 2200;
+	char root[32];
+	thread_t thread;
+	if (diag_started) {
+		return;
+	}
+	diag_started = true;
+	if (!PE_parse_boot_argn("nabugpudiag", &enable, sizeof(enable)) || enable != 1 ||
+	    !PE_parse_boot_argn("nabulog", &logging, sizeof(logging)) || logging != 1 ||
+	    !PE_parse_boot_argn("ufsroot", root, sizeof(root)) ||
+	    strncmp(root, "nabu_system", sizeof(root)) != 0) {
+		return;
+	}
+	(void)PE_parse_boot_argn("nabugmuhfi", &hfi, sizeof(hfi));
+	(void)PE_parse_boot_argn("nabugpu2", &clocks, sizeof(clocks));
+	(void)PE_parse_boot_argn("nabugmustart", &start, sizeof(start));
+	(void)PE_parse_boot_argn("nabugpu2_pause", &pause, sizeof(pause));
+	diag_enabled = true;
+	nabu_gpu_diag_begin(NABU_DIAG_PATH, NABU_DIAG_CONFIG, 0, pause,
+	    (clocks & 0xffu) | ((start & 0xffu) << 8) | ((hfi & 0xffu) << 16), 0);
+	nabu_gpu_diag_end(NABU_DIAG_PATH, hfi, pause);
+	printf("nabugpudiag: config clocks=%u start=%u hfi=%u pause_ms=%u "
+	    "header_offset=64 header_bytes=696 no_target_waits=1\n", clocks, start, hfi, pause);
+	kern_return_t result = kernel_thread_start(diag_observer, NULL, &thread);
+	if (result == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("nabugpudiag: observer=create_failed status=%d; header snapshots remain enabled\n",
+		    result);
+	}
+}
+
+#endif /* ARM64_BOARD_CONFIG_NABU */
