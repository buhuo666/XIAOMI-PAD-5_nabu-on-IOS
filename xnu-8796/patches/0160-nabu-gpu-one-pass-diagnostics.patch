 static void
 start_clean(__unused void *cookie, uint64_t physical, uint32_t bytes)
 {
+	nabu_gpu_diag_begin(NABU_DIAG_GMU_IO, NABU_DIAG_CLEAN, 0, bytes, 0, 0);
 	flush_dcache64((addr64_t)physical, bytes, TRUE);
+	nabu_gpu_diag_end(NABU_DIAG_GMU_IO, bytes, 0);
 }
 
 static void
 start_barrier(__unused void *cookie)
 {
+	nabu_gpu_diag_begin(NABU_DIAG_GMU_IO, NABU_DIAG_BARRIER, 0, 0, 0, 0);
 	__asm__ volatile ("dsb sy" ::: "memory");
+	nabu_gpu_diag_end(NABU_DIAG_GMU_IO, 0, 0);
 }
 
 static void
 start_delay(__unused void *cookie, uint32_t microseconds)
 {
+	nabu_gpu_diag_begin(NABU_DIAG_GMU_IO, NABU_DIAG_DELAY, 0, microseconds, 0, 0);
 	delay(microseconds);
+	nabu_gpu_diag_end(NABU_DIAG_GMU_IO, microseconds, 0);
 }
 
 static void
 start_event(__unused void *cookie, const char *event, uint32_t value)
 {
+	static const char *const phases[] = {
+		"memory-validated", "cold-handoff-empty", "domain-installed",
+		"power-sequencers-ready", "firmware-staged", "release-reset",
+		"firmware-ready", "hfi-ready", "failed"
+	};
+	unsigned phase = 0;
+	for (unsigned i = 0; i < sizeof(phases) / sizeof(phases[0]); i++) {
+		if (strcmp(event, phases[i]) == 0) {
+			phase = i + 1;
+			break;
+		}
+	}
+	nabu_gpu_diag_begin(NABU_DIAG_GMU_PHASE, NABU_DIAG_PHASE, 0, phase, value, 0);
 	printf("nabugmustart: phase=%s value=0x%08x\n", event, value);
+	nabu_gpu_diag_end(NABU_DIAG_GMU_PHASE, value, phase);
 }
 
