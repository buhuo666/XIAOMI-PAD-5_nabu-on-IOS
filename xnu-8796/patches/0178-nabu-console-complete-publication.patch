+ * The leading newline resynchronizes readers after a partial legacy line. */
+int nabu_log_record(const char *line, int size);
+int
+nabu_log_record(const char *line, int size)
+{
+	char record[514];
+	if (size <= 0 || size > 512 || line[size - 1] != '\n') {
+		return 0;
+	}
+	record[0] = '\n';
+	memcpy(record + 1, line, (size_t)size);
+	return nabu_log_publish(record, size + 1);
