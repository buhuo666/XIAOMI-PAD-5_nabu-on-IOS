+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+#ifndef NABU_TOUCH_BOARD_H
+#define NABU_TOUCH_BOARD_H
+#include <stdint.h>
+
+/* nabu live FDT: SE18 c84000, QUP wrapper cc0000, 15 MHz SPI maximum.
+ * MiCode nabu-r-oss gcc-sm8150.c/pinctrl-sm8150.c define register semantics. */
+#define NBU_TOUCH_WIDTH 1600u
+#define NBU_TOUCH_HEIGHT 2560u
+#define NBU_TOUCH_SPI_MAX_HZ 15000000u
+#define NBU_TOUCH_XO_HZ 19200000u
+#define NBU_TOUCH_EAST_PA 0x03500000u
+#define NBU_TOUCH_NORTH_PA 0x03900000u
+#define NBU_TOUCH_EAST_SIZE 0x1b000u
+#define NBU_TOUCH_NORTH_SIZE 0x28000u
+#define NBU_TOUCH_GCC_VOTE 0x52014u
+#define NBU_TOUCH_VOTES ((1u << 1) | (1u << 2) | (1u << 5))
+#define NBU_TOUCH_M_AHB 0x1e004u
+#define NBU_TOUCH_S_AHB 0x1e008u
+#define NBU_TOUCH_SE_HALT 0x1e274u
+#define NBU_TOUCH_RCG 0x1e278u
+#define NBU_TOUCH_HWCG (1u << 1)
+#define NBU_TOUCH_CLK_OFF (1u << 31)
+
+/* Panel pixels to IOFixed 0..1. No phone-sized canvas or centering offset. */
+static inline int32_t
+nbu_touch_normalize(int coordinate, unsigned extent)
+{
+	if (extent < 2 || coordinate <= 0) {
+		return 0;
+	}
+	if ((unsigned)coordinate >= extent - 1u) {
+		return 0x10000;
+	}
+	return (int32_t)(((int64_t)coordinate << 16) / (extent - 1u));
+}
+
+/* SPI pins are EAST; IRQ gpio39 is NORTH. No unverified GPIO90 writes. */
+static inline unsigned
+nbu_touch_pin_mux(unsigned pin)
+{
+	return pin == 24u || pin == 25u ? 3u : 2u;
+}
+
+/* Hardware-gated s_ahb may report OFF while idle. The vendor clk-branch
+ * driver does not poll halt in this mode. Require our vote nevertheless;
+ * a subsequent real GENI identity/transfer is still mandatory. */
+static inline int
+nbu_touch_branch_ready(uint32_t offset, uint32_t cbcr, uint32_t vote)
+{
+	uint32_t bit = offset == NBU_TOUCH_M_AHB ? 1u << 2 :
+	    offset == NBU_TOUCH_S_AHB ? 1u << 1 :
+	    offset == NBU_TOUCH_SE_HALT ? 1u << 5 : 0;
+	if (!bit || !(vote & bit)) {
+		return 0;
+	}
+	if (offset == NBU_TOUCH_S_AHB && (cbcr & NBU_TOUCH_HWCG)) {
+		return 1;
+	}
+	return !(cbcr & NBU_TOUCH_CLK_OFF) ||
+	       (cbcr & 0xf0000000u) == 0x20000000u;
+}
+
+/* Select only an explicitly verified XO DFS level. Do not assume that an
+ * inherited level 0 uses 19.2 MHz or guess an unknown PLL/MND frequency. */
+static inline int
+nbu_touch_xo_level(const uint32_t cfg[8])
+{
+	for (unsigned i = 0; i < 8; ++i) {
+		if ((cfg[i] & 0x371fu) == 0 || (cfg[i] & 0x371fu) == 1) {
+			return (int)i;
+		}
+	}
+	return -1;
+}
+#endif
