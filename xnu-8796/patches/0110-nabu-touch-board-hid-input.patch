+#ifndef NABU_TOUCH_INPUT_H
+#define NABU_TOUCH_INPUT_H
+#include "nabu_nt36523.h"
+#include "nabu_touch_board.h"
+
+struct nbu_touch_slots {
+	unsigned active;
+	int x[NVT_MAX_FINGERS];
+	int y[NVT_MAX_FINGERS];
+};
+typedef void (*nbu_touch_emit)(int slot, int down, int x, int y);
+
+/* Validate the full set before emitting anything; duplicate IDs never
+ * become conflicting HID updates. Missing contacts and failed reads release. */
+static inline int
+nbu_touch_publish(struct nbu_touch_slots *state,
+    const struct nvt_contact *points, int count, nbu_touch_emit emit)
+{
+	unsigned present = 0;
+	if (!state || !emit || count < 0 || count > NVT_MAX_FINGERS ||
+	    (count && !points)) {
+		return -1;
+	}
+	for (int i = 0; i < count; ++i) {
+		if (points[i].id < 1 || points[i].id > NVT_MAX_FINGERS ||
+		    !points[i].down || points[i].x < 0 || points[i].y < 0 ||
+		    points[i].x >= (int)NBU_TOUCH_WIDTH ||
+		    points[i].y >= (int)NBU_TOUCH_HEIGHT) {
+			return -1;
+		}
+		unsigned bit = 1u << (points[i].id - 1);
+		if (present & bit) {
+			return -1;
+		}
+		present |= bit;
+	}
+	for (int slot = 0; slot < NVT_MAX_FINGERS; ++slot) {
+		unsigned bit = 1u << slot;
+		if ((state->active & bit) && !(present & bit)) {
+			emit(slot, 0, state->x[slot], state->y[slot]);
+		}
+	}
+	for (int i = 0; i < count; ++i) {
+		int slot = points[i].id - 1;
+		state->x[slot] = points[i].x;
+		state->y[slot] = points[i].y;
+		emit(slot, 1, points[i].x, points[i].y);
+	}
+	state->active = present;
+	return 0;
+}
+
+static inline void
+nbu_touch_release(struct nbu_touch_slots *state, nbu_touch_emit emit)
+{
+	(void)nbu_touch_publish(state, 0, 0, emit);
+}
+#endif
