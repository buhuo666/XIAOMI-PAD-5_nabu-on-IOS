 	for (uint32_t i = 0; i < NABU_SMMU_PLAN_STREAMS; i++) {
 		uint32_t smr = snapshot->smr[i], s2cr = snapshot->s2cr[i];
 		uint32_t type = SMMU_S2CR_TYPE(s2cr);
-		if ((smr & ~SMMU_SMR_FIELDS) != 0 ||
-		    (s2cr & ~SMMU_S2CR_FIELDS) != 0 || type == 3u) {
+		bool s2cr_known = (snapshot->s2cr_known_mask & (1u << i)) != 0;
+		if ((smr & ~SMMU_SMR_FIELDS) != 0 || (s2cr_known &&
