+/*
+ * Nabu's SM8150 FDT routes the NVT GPIO39 rising edge through TLMM. Configure
+ * its edge detector but leave the parent interrupt masked until XNU has a
+ * native GPIO/GIC interrupt domain. This bounded diagnostic polls the latched
+ * status bit rather than relying on sampling the width of the input pulse.
+ */
+static bool
+nbu_touch_irq_prepare(void)
+{
+	uint32_t cfg_off = NABU_TLMM_INTR_CFG(NABU_TOUCH_IRQ_GPIO);
+	uint32_t status_off = NABU_TLMM_INTR_STATUS(NABU_TOUCH_IRQ_GPIO);
+	uint32_t mask = NABU_TLMM_INTR_ENABLE | NABU_TLMM_INTR_POLARITY |
+	    NABU_TLMM_INTR_DETECTION | NABU_TLMM_INTR_RAW_STATUS |
+	    NABU_TLMM_INTR_TARGET;
+	uint32_t cfg = nbu_rd(ts.north, cfg_off);
+
+	cfg &= ~mask;
+	cfg |= NABU_TLMM_INTR_POLARITY | NABU_TLMM_INTR_EDGE_RISING |
+	    NABU_TLMM_INTR_RAW_STATUS | NABU_TLMM_INTR_TARGET_APPS;
+	/* SM8150's TLMM status register is write-zero-to-clear. */
+	nbu_wr(ts.north, status_off, nbu_rd(ts.north, status_off) & ~1u);
+	nbu_wr(ts.north, cfg_off, cfg);
+	uint32_t observed = nbu_rd(ts.north, cfg_off);
+	printf("NABU TOUCH: GPIO39 edge-latch cfg=%#x expected=%#x status=%#x parent=masked\n",
+	    observed, cfg, nbu_rd(ts.north, status_off));
+	return (observed & mask) == (cfg & mask) &&
+	    !(observed & NABU_TLMM_INTR_ENABLE);
+}
+
+static bool
+nbu_touch_irq_take(void)
+{
+	uint32_t status_off = NABU_TLMM_INTR_STATUS(NABU_TOUCH_IRQ_GPIO);
+	uint32_t status = nbu_rd(ts.north, status_off);
+
+	if (!(status & 1u)) {
+		return false;
+	}
+	nbu_wr(ts.north, status_off, status & ~1u);
+	return true;
+}
+
 static uint32_t
 nbu_se_rd(void *ctx, uint32_t off)
 {
 	return nbu_rd((vm_offset_t)ctx, off);
 }
