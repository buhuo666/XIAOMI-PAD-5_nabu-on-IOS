diff --git a/iokit/Kernel/arm/hid/NabuHID.cpp b/iokit/Kernel/arm/hid/NabuHID.cpp
--- a/iokit/Kernel/arm/hid/NabuHID.cpp
+++ b/iokit/Kernel/arm/hid/NabuHID.cpp
@@ -432,12 +432,9 @@
 	if (!fLock || !IOHIDEventService::start(provider)) {
 		return false;
 	}
-	int native = 0;
-	PE_parse_boot_argn("nabufb_native", &native, sizeof(native));
-	fLogicalW = native ? 1080 : 1600;
-	fLogicalH = native ? 2400 : 2560;
-	fOffX = (fLogicalW - 1080) / 2;
-	fOffY = (fLogicalH - 2400) / 2;
+	fLogicalW = 1600;
+	fLogicalH = 2560;
+	fOffX = fOffY = 0;
 	/* The digitizer covers the main display (backboardd maps it 1:1). */
 	setProperty("DisplayIntegrated", kOSBooleanTrue);
 	setProperty("SurfaceWidth", (unsigned long long)(68 << 16), 32);	/* mm, 16.16 */
@@ -458,22 +455,22 @@
 	if (finger < 0 || finger >= NABU_TOUCH_FINGERS) {
 		return;
 	}
-	x = x < 0 ? 0 : (x > 1079 ? 1079 : x);
-	y = y < 0 ? 0 : (y > 2399 ? 2399 : y);
+	x = x < 0 ? 0 : (x >= fLogicalW ? fLogicalW - 1 : x);
+	y = y < 0 ? 0 : (y >= fLogicalH ? fLogicalH - 1 : y);
 
 	IOLockLock(fLock);
 	bool was = fDown[finger];
-	/* 1080x2400 touch coordinates -> the presented 1600x2560 display. */
-	IOFixed nx = (IOFixed)(((int64_t)(x + fOffX) << 16) / fLogicalW);
-	IOFixed ny = (IOFixed)(((int64_t)(y + fOffY) << 16) / fLogicalH);
+	/* Preserve native panel coordinates; only normalize for the HID event. */
+	IOFixed nx = (IOFixed)(((int64_t)x << 16) / (fLogicalW - 1));
+	IOFixed ny = (IOFixed)(((int64_t)y << 16) / (fLogicalH - 1));
 	bool moved = down && (nx != fX[finger] || ny != fY[finger]);
 	if (was == down && !moved) {
 		IOLockUnlock(fLock);
 		return;
 	}
 	if (!was && down) {
-		fEdge[finger] = x < NABU_TOUCH_EDGE_PX || x > 1079 - NABU_TOUCH_EDGE_PX ||
-		    y < NABU_TOUCH_EDGE_PX || y > 2399 - NABU_TOUCH_EDGE_PX;
+		fEdge[finger] = x < NABU_TOUCH_EDGE_PX || x > fLogicalW - 1 - NABU_TOUCH_EDGE_PX ||
+		    y < NABU_TOUCH_EDGE_PX || y > fLogicalH - 1 - NABU_TOUCH_EDGE_PX;
 	}
 
 	collection = IOHIDEvent::digitizerEvent(now, 0, kIOHIDDigitizerTransducerTypeHand, false, 0, 0, 0);
