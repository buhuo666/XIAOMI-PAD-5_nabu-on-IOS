@@ -77,14 +79,21 @@
 }
 
 static void
+nabu_gpu2_announce_delay(const char *what, uint32_t pause_ms)
+{
+	printf("nabugpu2: %s\n", what);
+	nabu_gpu_diag_begin(NABU_DIAG_CLOCK, NABU_DIAG_ANNOUNCE, 0, pause_ms, 0, 0);
+	if (pause_ms != 0) {
+		nabu_gpu2_sleep_ms(pause_ms);
+	}
+	nabu_gpu_diag_end(NABU_DIAG_CLOCK, pause_ms, 0);
+	printf("nabugpu2: pause %u ms returned\n", pause_ms);
+}
+
