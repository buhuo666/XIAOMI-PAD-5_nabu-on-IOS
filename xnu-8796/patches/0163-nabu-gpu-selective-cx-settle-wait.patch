-	nabu_gpu2_sleep_ms(gpu2_pause_ms);
-	/* The wait's own completion, so a stall after it names the access that follows. */
-	printf("nabugpu2: pause %u ms returned\n", gpu2_pause_ms);
-	nabu_gpu_diag_end(NABU_DIAG_CLOCK, gpu2_pause_ms, 0);
