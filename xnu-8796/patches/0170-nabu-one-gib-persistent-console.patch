diff --git a/bsd/dev/nabu_log_storage.h b/bsd/dev/nabu_log_storage.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/nabu_log_storage.h
@@ -0,0 +1,57 @@
+/* Persistent capacity is independent of the existing 4 MiB console RAM ring. */
+#ifndef NABU_LOG_STORAGE_H
+#define NABU_LOG_STORAGE_H
+#include <stdint.h>
+
+#define NABU_LOG_STORAGE_BYTES (1u << 30)
+#define NABU_LOG_STORAGE_BLOCKS (1u + NABU_LOG_STORAGE_BYTES / 4096u)
+#define NABU_LOG_RAM_BYTES (4u << 20)
+#define NABU_LOG_FORMAT_VERSION 2u
+
+struct nabu_log_header {
+	char magic[8];
+	uint32_t version, size;
+	uint64_t total, seq, valid_from, ram_lost;
+	uint32_t ram_size, flags, checksum, reserved;
+};
+_Static_assert(sizeof(struct nabu_log_header) == 64, "log header layout");
+
+static inline uint32_t
+nabu_log_header_checksum(const struct nabu_log_header *h)
+{
+	const unsigned char *bytes = (const unsigned char *)h;
+	uint32_t hash = 2166136261u;
+	for (unsigned int i = 0; i < sizeof(*h); ++i) {
+		/* checksum field is treated as zero. */
+		hash = (hash ^ (i >= 56 && i < 60 ? 0u : bytes[i])) * 16777619u;
+	}
+	return hash;
+}
+
+struct nabu_log_chunk {
+	uint32_t ram_block, disk_block, blocks;
+	uint64_t next;
+};
+
+/* Both rings and bounce buffer use whole 4 KiB blocks. */
+static inline struct nabu_log_chunk
+nabu_log_plan(uint64_t pos, uint64_t total, uint32_t bounce_blocks)
+{
+	struct nabu_log_chunk plan = { 0, 0, 0, pos };
+	if (pos >= total || !bounce_blocks) {
+		return plan;
+	}
+	uint32_t within = (uint32_t)(pos % 4096u);
+	plan.ram_block = (uint32_t)((pos % NABU_LOG_RAM_BYTES) / 4096u);
+	plan.disk_block = (uint32_t)((pos % NABU_LOG_STORAGE_BYTES) / 4096u);
+	uint64_t blocks = ((total - pos) + within + 4095u) / 4096u;
+	uint32_t ram_left = NABU_LOG_RAM_BYTES / 4096u - plan.ram_block;
+	uint32_t disk_left = NABU_LOG_STORAGE_BYTES / 4096u - plan.disk_block;
+	if (blocks > ram_left) { blocks = ram_left; }
+	if (blocks > disk_left) { blocks = disk_left; }
+	if (blocks > bounce_blocks) { blocks = bounce_blocks; }
+	plan.blocks = (uint32_t)blocks;
+	plan.next = pos + blocks * 4096u - within;
+	return plan;
+}
+#endif
