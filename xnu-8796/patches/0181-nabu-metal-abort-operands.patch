+/* NABU_MTL1_BEGIN
+ * Read saved operands of one known mediaserverd SIGABRT. No user code runs,
+ * no memory is written, and no heap is scanned. A mismatch yields unknown.
+ * Static derivation: docs/metal-abort-observation.md. Code guards describe
+ * this layout only; they do not authenticate the whole shared cache.
+ */
+struct nabu_mtl_result {
+	unsigned int status, line, function_null, index, library_null, pipeline_null;
+};
