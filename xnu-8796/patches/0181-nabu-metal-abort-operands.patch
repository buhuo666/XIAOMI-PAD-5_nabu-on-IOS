+extern int nabu_log_record(const char *line, int n);
+
+static void
+nabu_mtl_crash(const char *name, int pid, int sig, uint64_t fp, uint64_t slide)
+{
+	unsigned int enabled = 0;
+	struct nabu_mtl_result observed;
+	char line[224];
+	int n;
+	if (sig != 6 || strcmp(name, "mediaserverd") != 0 ||
+	    !PE_parse_boot_argn("nabumtlprobe", &enabled, sizeof(enabled)) || enabled != 1) {
+		return;
+	}
+	nabu_mtl_observe(fp, slide, &observed);
+	n = snprintf(line, sizeof(line),
+	    "NABU MTL1: pid=%d status=%u line=%u fn_null=%u index=%u lib_null=%u pipe_null=%u\n",
+	    pid, observed.status, observed.line, observed.function_null, observed.index,
+	    observed.library_null, observed.pipeline_null);
+	if (n > 0 && n < (int)sizeof(line)) {
+		(void)nabu_log_record(line, n);
+	}
+}
