+static int
+nabu_mtl_read(uint64_t address, void *out, size_t bytes)
+{
+	/* This diagnostic is for the frozen low-address shared-cache ABI only. */
+	if (address < 0x10000ULL || address >= (1ULL << 39) ||
+	    bytes > 256 || bytes > (1ULL << 39) - address) {
+		return 0;
+	}
+	return copyin((user_addr_t)address, out, bytes) == 0;
+}
+
+static void
+nabu_mtl_observe(uint64_t fp, uint64_t slide, struct nabu_mtl_result *out)
+{
+	uint64_t cold = 0, report, setter, setup;
+	uint64_t f[2], g[2], h[2], line, function, loop, libraries[2];
+	memset(out, 0, sizeof(*out));
+	out->status = 1; /* no matching call chain / unreadable frame */
+	if (slide > 0x100000000ULL || (slide & 0xfff)) {
+		return;
+	}
+	for (unsigned int i = 0; i < 16; i++) {
+		if ((fp & 15) || !nabu_mtl_read(fp, f, sizeof(f))) {
+			return;
+		}
+		if (f[1] == 0x181d29fd4ULL + slide) {
+			cold = fp;
+			break;
+		}
+		if (f[0] <= fp || f[0] - fp > 65536) {
+			return;
+		}
+		fp = f[0];
+	}
+	if (!cold) {
+		return;
+	}
+	report = f[0];
+	if (report != cold + 208 || !nabu_mtl_read(report, g, sizeof(g)) ||
+	    g[1] != 0x181c1c4d4ULL + slide) {
+		return;
+	}
+	setter = g[0];
+	if (setter != report + 64 || !nabu_mtl_read(setter, h, sizeof(h)) ||
+	    h[1] != 0x1c22f1d7cULL + slide) {
+		return;
+	}
+	setup = h[0];
+	if (setup != setter + 128) {
+		return;
+	}
+	out->status = 2; /* code layout unknown */
+	for (unsigned int i = 0; i < sizeof(nabu_mtl_code) / sizeof(nabu_mtl_code[0]); i++) {
+		uint32_t word;
+		if (!nabu_mtl_read(nabu_mtl_code[i].address + slide, &word, sizeof(word)) ||
+		    word != nabu_mtl_code[i].word) {
+			return;
+		}
+	}
+	out->status = 3; /* saved operands unavailable */
+	if (!nabu_mtl_read(cold - 8, &line, sizeof(line)) ||
+	    !nabu_mtl_read(report - 8, &function, sizeof(function)) ||
+	    !nabu_mtl_read(report - 56, &loop, sizeof(loop)) ||
+	    !nabu_mtl_read(setup - 96, libraries, sizeof(libraries))) {
+		return;
+	}
+	out->status = 4; /* inconsistent branch/object or loop; do not interpret */
+	if (!((line == 692 && function == 0) || (line == 697 && function != 0)) ||
+	    loop >= 96 || (loop & 7)) {
+		return;
+	}
+	out->line = (unsigned int)line;
+	out->function_null = function == 0;
+	out->index = (unsigned int)(loop / 8);
+	out->library_null = libraries[1] == 0;
+	out->pipeline_null = libraries[0] == 0;
+	out->status = 0;
+}
+/* NABU_MTL1_END */
