 	}
 
+#if defined(NABU)
+	/* Retain XNU's nominal accounting defaults when optional DT clocks
+	 * are absent or zero. These values do not program hardware clocks. */
+	if (gPEClockFrequencyInfo.bus_clock_rate_hz == 0) {
+		gPEClockFrequencyInfo.bus_frequency_hz = 100000000;
+		gPEClockFrequencyInfo.bus_clock_rate_hz = 100000000;
+		gPEClockFrequencyInfo.bus_frequency_min_hz = 100000000;
+		gPEClockFrequencyInfo.bus_frequency_max_hz = 100000000;
+	}
+	if (gPEClockFrequencyInfo.cpu_clock_rate_hz == 0) {
+		gPEClockFrequencyInfo.cpu_frequency_hz = 400000000;
+		gPEClockFrequencyInfo.cpu_clock_rate_hz = 400000000;
+		gPEClockFrequencyInfo.cpu_frequency_min_hz = 400000000;
+		gPEClockFrequencyInfo.cpu_frequency_max_hz = 400000000;
+	}
+	if (gPEClockFrequencyInfo.dec_clock_rate_hz == 0) {
+		gPEClockFrequencyInfo.timebase_frequency_hz = 19200000;
+		gPEClockFrequencyInfo.dec_clock_rate_hz = 19200000;
+	}
+#endif
+
 	/* Set the num / den pairs form the hz values. */
 	gPEClockFrequencyInfo.bus_clock_rate_num = gPEClockFrequencyInfo.bus_clock_rate_hz;
 	gPEClockFrequencyInfo.bus_clock_rate_den = 1;
