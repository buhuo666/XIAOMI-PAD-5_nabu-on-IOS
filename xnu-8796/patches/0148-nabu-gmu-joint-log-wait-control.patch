+static bool
+joint_wait_for_commit(uint64_t intent, unsigned step, const char *prefix)
+{
+	if (intent == 0) {
+		printf("%s: aborted step=%u; console ring has no recorded intent\n", prefix, step);
+		return false;
+	}
+	for (unsigned waited = 0; nabu_log_committed_position() < intent; waited++) {
+		if (waited == JOINT_LOG_WAIT_SECONDS) {
+			printf("%s: aborted step=%u; intent was not committed\n", prefix, step);
+			return false;
+		}
+		(void)tsleep(&joint_sleep_channel, PZERO, "gmujointlog", hz);
+	}
+	if (nabu_log_committed_position() - intent >= (4ULL << 20) - 1024) {
+		printf("%s: aborted step=%u; intent may have been overwritten\n", prefix, step);
+		return false;
+	}
+	return true;
+}
 
