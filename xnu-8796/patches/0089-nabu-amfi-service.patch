+/* Local project allowlist for the verified 20G81 launchd.plist CodeDirectories.
+ * SHA-256(file): 9d0546d0a377c8bb8a40a63a3fc70ad23af079bbe51b605586ecd8ed46824731
+ * SHA-256(sig): 4ddd672c5df2ebb5963f1ea472f850ed109e90a6d93172458a50b138724b2435
+ * No loading, adding, or persisting hashes through the user client.
+ */
+#ifndef NABU_AMFI_QUERY_H
+#define NABU_AMFI_QUERY_H
+static int nabu_amfi_cache_query(unsigned long long kind, const void *input, unsigned long length)
+{
+    static const unsigned char hashes[2][20] = {
+        {0x33,0x6c,0xaa,0xd5,0x1c,0x93,0x82,0x13,0x11,0x39,0xed,0xff,0x75,0xa9,0xca,0x29,0xdc,0x5d,0xf5,0x1c},
+        {0x48,0xd2,0xf5,0x79,0xb4,0xaf,0xb2,0x42,0x8f,0x07,0xc7,0x3d,0x95,0x9b,0x82,0x6d,0x7d,0x81,0x57,0x20}
+    };
+    if (kind != 1 || input == 0 || length != 20) return -1;
+    const unsigned char *p = (const unsigned char *)input;
+    for (unsigned h = 0; h < 2; ++h) {
+        unsigned diff = 0;
+        for (unsigned i = 0; i < 20; ++i) diff |= p[i] ^ hashes[h][i];
+        if (diff == 0) return 1;
+    }
+    return 0;
+}
+#endif
