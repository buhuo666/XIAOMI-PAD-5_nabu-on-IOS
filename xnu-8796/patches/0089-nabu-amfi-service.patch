+/* NABU experimental AMFI IOKit compatibility, limited to 20G81 launchd cache.
+ * These locally pinned CodeDirectories are not an Apple trust-cache implementation.
+ * Both cover all 339 pages of the pinned installed launchd.plist (see findings).
+ * Signature attachment/page validation remains the responsibility of Security/XNU.
+ */
+#include <pexpert/arm64/board_config.h>
+#if defined(NABU)
+#include <IOKit/IOService.h>
+#include <IOKit/IOUserClient.h>
+#include <IOKit/IOKitKeys.h>
+#include <IOKit/IOLib.h>
+#include <libkern/c++/OSBoolean.h>
+#include "NabuAMFIQuery.h"
+
+class AppleMobileFileIntegrity : public IOService {
+    OSDeclareDefaultStructors(AppleMobileFileIntegrity);
+public:
+    bool start(IOService *provider) APPLE_KEXT_OVERRIDE;
+};
+OSDefineMetaClassAndStructors(AppleMobileFileIntegrity, IOService);
+bool AppleMobileFileIntegrity::start(IOService *provider)
+{
+    if (!IOService::start(provider)) return false;
+    setProperty(kIOUserClientClassKey, "AppleMobileFileIntegrityUserClient");
+    registerService();
+    IOLog("NABU AMFI: restricted 20G81 launchd cache query service registered\n");
+    return true;
+}
+
+class AppleMobileFileIntegrityUserClient : public IOUserClient {
+    OSDeclareDefaultStructors(AppleMobileFileIntegrityUserClient);
+public:
+    bool initWithTask(task_t task, void *sid, UInt32 type) APPLE_KEXT_OVERRIDE;
+    IOReturn clientClose(void) APPLE_KEXT_OVERRIDE;
+    IOReturn externalMethod(uint32_t selector, IOExternalMethodArguments *args,
+        IOExternalMethodDispatch *dispatch, OSObject *target, void *ref) APPLE_KEXT_OVERRIDE;
+};
+OSDefineMetaClassAndStructors(AppleMobileFileIntegrityUserClient, IOUserClient);
+bool AppleMobileFileIntegrityUserClient::initWithTask(task_t task, void *sid, UInt32 type)
+{
+    if (type != 0 || task == TASK_NULL) return false;
+    OSObject *ent = copyClientEntitlement(task, "com.apple.private.amfi.can-check-trust-cache");
+    bool allowed = ent == kOSBooleanTrue;
+    OSSafeReleaseNULL(ent);
+    if (!allowed) return false;
+    return IOUserClient::initWithTask(task, sid, type);
+}
+IOReturn AppleMobileFileIntegrityUserClient::clientClose(void)
+{
+    terminate();
+    return kIOReturnSuccess;
+}
+IOReturn AppleMobileFileIntegrityUserClient::externalMethod(uint32_t selector,
+    IOExternalMethodArguments *args, __unused IOExternalMethodDispatch *dispatch,
+    __unused OSObject *target, __unused void *ref)
+{
+    if (selector != 6) return kIOReturnUnsupported;
+    if (args == NULL || args->structureInputDescriptor != NULL ||
+        args->structureOutputDescriptor != NULL || args->asyncWakePort != MACH_PORT_NULL ||
+        args->scalarInputCount != 1 || args->scalarInput == NULL ||
+        args->scalarOutputCount != 0 || args->structureOutputSize != 0) {
+        return kIOReturnBadArgument;
+    }
+    int result = nabu_amfi_cache_query(args->scalarInput[0], args->structureInput,
+        args->structureInputSize);
+    IOReturn ret = result < 0 ? kIOReturnBadArgument :
+        result ? kIOReturnSuccess : kIOReturnNotFound;
+    IOLog("NABU AMFI: cache query selector=6 length=%u result=0x%x\n",
+        args->structureInputSize, ret);
+    return ret;
+}
+#endif
