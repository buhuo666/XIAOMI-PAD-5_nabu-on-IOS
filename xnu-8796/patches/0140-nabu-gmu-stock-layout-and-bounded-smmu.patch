-	id1 = smmu_rd(smmu, NABU_SMMU_GR0_ID1);
-	id2 = smmu_rd(smmu, NABU_SMMU_GR0_ID2);
-	id7 = smmu_rd(smmu, NABU_SMMU_GR0_ID7);
-	scr0 = smmu_rd(smmu, NABU_SMMU_GR0_sCR0);
-	sacr = smmu_rd(smmu, NABU_SMMU_GR0_sACR);
-	gfsr = smmu_rd(smmu, NABU_SMMU_GR0_sGFSR);
-
-	/*
-	 * Field positions from arm-smmu.h: ID0.NUMSMRG is bits 7:0 and
-	 * ID0.NUMIRPT bits 23:16; ID1.NUMCB is bits 7:0 and ID1.NUMS2CB bits
-	 * 23:16. The stage-2 count comes from ID1, not ID0.
-	 */
-	num_smr  = id0 & 0xffu;
-	num_irpt = (id0 >> 16) & 0xffu;
-	num_cb   = id1 & 0xffu;
-	num_s2cb = (id1 >> 16) & 0xffu;
-
-	printf("nabusammu: id0=0x%08x id1=0x%08x id2=0x%08x id7=0x%08x\n",
-	    id0, id1, id2, id7);
-	printf("nabusammu: model %u.%u, %u stream entries, %u context banks "
-	    "(%u stage-2), %u interrupts\n",
-	    (id7 >> 4) & 0xfu, id7 & 0xfu, num_smr, num_cb, num_s2cb, num_irpt);
-	printf("nabusammu: sCR0=0x%08x sACR=0x%08x sGFSR=0x%08x\n",
-	    scr0, sacr, gfsr);
-
-	/*
-	 * The one line that decides the next step. CLIENTPD set means the SMMU
-	 * lets every client through untranslated, so a GPU address is a physical
-	 * address and the HFI, log and icache regions can be described with their
-	 * physical addresses; clear means they need a page table first.
-	 */
-	printf("nabusammu: translation is %s (CLIENTPD=%u)\n",
-	    (scr0 & NABU_SMMU_sCR0_CLIENTPD) ?
-	    "OFF - GPU addresses are physical" : "ON - a page table is needed",
-	    (scr0 & NABU_SMMU_sCR0_CLIENTPD) ? 1u : 0u);
-
-	if (gfsr) {
-		printf("nabusammu: a fault is recorded, sGFSR=0x%08x "
-		    "(USF=%u)\n", gfsr, (gfsr & NABU_SMMU_sGFSR_USF) ? 1u : 0u);
-	}
-
-	/*
-	 * How the streams are wired. If the bootloader already pointed the GPU's
-	 * streams at a context bank, that tells us both that the instance is
-	 * usable and which bank the vendor chose, which a replacement would have
-	 * to agree with.
-	 */
-	printf("nabusammu: first %u stream mappings\n", smmu_streams);
-	for (uint32_t i = 0; i < smmu_streams; i++) {
-		uint32_t smr = smmu_rd(smmu, NABU_SMMU_GR0_SMR(i));
-		uint32_t s2cr = smmu_rd(smmu, NABU_SMMU_GR0_S2CR(i));
-
-		if (!NABU_SMMU_SMR_VALID(smr) && s2cr == 0) {
