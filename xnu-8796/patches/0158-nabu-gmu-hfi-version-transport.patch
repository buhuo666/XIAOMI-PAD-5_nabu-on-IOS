diff --git a/bsd/dev/nabu_gpu_gmu_hfi.h b/bsd/dev/nabu_gpu_gmu_hfi.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/nabu_gpu_gmu_hfi.h
@@ -0,0 +1,41 @@
+/* Shared A6xx HFI ABI. Preserve the table/queue offsets used by Test111. */
+#ifndef NABU_GPU_GMU_HFI_H
+#define NABU_GPU_GMU_HFI_H
+
+#include "nabu_gpu_gmu.h"
+
+#define NABU_HFI_WORDS 1024u
+#define NABU_HFI_HEADERS 17u
+#define NABU_HFI_QUEUE_OFFSET(i) (0x350u + 0x1000u * (i))
+
+struct nabu_gmu_hfi_queue {
+	uint32_t status, start, type, words, message_words;
+	uint32_t drop_count, rx_watermark, tx_watermark, rx_request, tx_request;
+	uint32_t read, write;
+};
+
+struct nabu_gmu_hfi_table {
+	uint32_t version, words, first_queue, queue_words, queues, active_queues;
+	struct nabu_gmu_hfi_queue queue[NABU_HFI_HEADERS];
+};
+
+enum nabu_gmu_hfi_error {
+	NABU_HFI_OK, NABU_HFI_INPUT, NABU_HFI_IO, NABU_HFI_VERSION,
+	NABU_HFI_LAYOUT, NABU_HFI_INDEX, NABU_HFI_SPACE, NABU_HFI_MESSAGE,
+	NABU_HFI_TRUNCATED, NABU_HFI_ACK, NABU_HFI_FIRMWARE, NABU_HFI_FAULT,
+	NABU_HFI_TIMEOUT, NABU_HFI_BUDGET,
+};
+
+struct nabu_gmu_hfi_result {
+	bool attempted, sent, acked;
+	enum nabu_gmu_hfi_error error;
+	uint32_t hfi_version, firmware_version, request, ack_header, returned_request;
+	uint32_t firmware_error, messages, unmatched, poll_reads, interrupt_info;
+	uint32_t cmd_read, cmd_write, rsp_read, rsp_write;
+};
+
+bool nabu_gpu_gmu_hfi_version(const struct nabu_gmu_memory_view *,
+    const struct nabu_gmu_boot_result *, const struct nabu_gmu_io *,
+    struct nabu_gmu_hfi_result *);
+
+#endif /* NABU_GPU_GMU_HFI_H */
diff --git a/bsd/dev/nabu_gpu_gmu_hfi.c b/bsd/dev/nabu_gpu_gmu_hfi.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/nabu_gpu_gmu_hfi.c
@@ -0,0 +1,243 @@
+/*
+ * Bounded, single-owner HFI version transaction for nabu A640.
+ * Protocol/register definitions: MiCode nabu-r-oss 71b6eff kgsl_hfi.[ch].
+ * The CPU pool must be Normal-NC through pmap before GMU startup.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <libkern/libkern.h>
+#include "nabu_gpu_gmu_hfi.h"
+
+#if defined(ARM64_BOARD_CONFIG_NABU)
+
+#define HFI_VERSION_INFO 0x14604u
+#define HFI_INTR_CLEAR 0x14644u
+#define HFI_INTR_INFO 0x14648u
+#define HFI_DOORBELL 0x14650u
+#define HFI_POLLS 1000u
+#define HFI_MESSAGES 32u
+#define HFI_FW_SUPPORTED 0x20000000u
+
+struct hfi_transaction {
+	const struct nabu_gmu_memory_view *memory;
+	const struct nabu_gmu_io *io;
+	struct nabu_gmu_hfi_result *result;
+	volatile struct nabu_gmu_hfi_table *table;
+	uint32_t major;
+};
+
+static bool
+hfi_fail(struct hfi_transaction *hfi, enum nabu_gmu_hfi_error error)
+{
+	hfi->result->error = error;
+	return false;
+}
+
+static void
+hfi_barrier(struct hfi_transaction *hfi)
+{
+	hfi->io->barrier(hfi->io->cookie);
+}
+
+static bool
+hfi_read_reg(struct hfi_transaction *hfi, uint32_t offset, uint32_t *value)
+{
+	if (!hfi->io->read32(hfi->io->cookie, NABU_GMU_REGS, offset, value)) {
+		return hfi_fail(hfi, NABU_HFI_IO);
+	}
+	return true;
+}
+
+static bool
+hfi_write_reg(struct hfi_transaction *hfi, uint32_t offset, uint32_t value)
+{
+	if (!hfi->io->write32(hfi->io->cookie, NABU_GMU_REGS, offset, value)) {
+		return hfi_fail(hfi, NABU_HFI_IO);
+	}
+	hfi_barrier(hfi);
+	return true;
+}
+
+static bool
+hfi_queue(struct hfi_transaction *hfi, uint32_t index, uint32_t *read, uint32_t *write)
+{
+	volatile struct nabu_gmu_hfi_queue *q = &hfi->table->queue[index];
+	uint32_t priority = index == 2 ? 40 : 10;
+	if (q->status != 1 || q->start != hfi->memory->hfi.iova + NABU_HFI_QUEUE_OFFSET(index) ||
+	    q->type != (index | (priority << 8)) || q->words != NABU_HFI_WORDS ||
+	    q->message_words != 0 || q->drop_count != 0) {
+		return hfi_fail(hfi, NABU_HFI_LAYOUT);
+	}
+	*read = q->read;
+	*write = q->write;
+	hfi_barrier(hfi);
+	if (*read >= NABU_HFI_WORDS || *write >= NABU_HFI_WORDS ||
+	    (hfi->major >= 2 && ((*read | *write) & 3u) != 0)) {
+		return hfi_fail(hfi, NABU_HFI_INDEX);
+	}
+	return true;
+}
+
+static volatile uint32_t *
+hfi_data(struct hfi_transaction *hfi, uint32_t queue)
+{
+	return (volatile uint32_t *)((uint8_t *)hfi->memory->hfi.cpu +
+	       NABU_HFI_QUEUE_OFFSET(queue));
+}
+
+static bool
+hfi_receive(struct hfi_transaction *hfi, uint32_t index)
+{
+	uint32_t read, write, msg[255];
+	struct nabu_gmu_hfi_result *result = hfi->result;
+	if (!hfi_queue(hfi, index, &read, &write)) {
+		return false;
+	}
+	if (read == write) {
+		hfi->table->queue[index].rx_request = 1;
+		hfi_barrier(hfi);
+		return true;
+	}
+	if (result->messages >= HFI_MESSAGES) {
+		return hfi_fail(hfi, NABU_HFI_BUDGET);
+	}
+	volatile uint32_t *data = hfi_data(hfi, index);
+	uint32_t header = data[read], words = (header >> 8) & 0xff;
+	uint32_t available = (write + NABU_HFI_WORDS - read) % NABU_HFI_WORDS;
+	uint32_t occupied = hfi->major >= 2 ? (words + 3u) & ~3u : words;
+	if (words == 0) {
+		return hfi_fail(hfi, NABU_HFI_MESSAGE);
+	}
+	if (occupied > available) {
+		return hfi_fail(hfi, NABU_HFI_TRUNCATED);
+	}
+	for (uint32_t i = 0; i < words; i++) {
+		msg[i] = data[(read + i) % NABU_HFI_WORDS];
+	}
+	hfi_barrier(hfi);
+	hfi->table->queue[index].read = (read + occupied) % NABU_HFI_WORDS;
+	hfi_barrier(hfi);
+	result->messages++;
+	uint32_t type = (header >> 16) & 0xf;
+	bool ack = hfi->major >= 2 ? type == 1 : type == 2 && (header & 0xff) == 126;
+	if (ack) {
+		if (index != 1 || words != 4) {
+			return hfi_fail(hfi, NABU_HFI_ACK);
+		}
+		result->ack_header = msg[0];
+		result->returned_request = msg[1];
+		if (msg[1] != result->request) {
+			result->unmatched++;
+			return true;
+		}
+		result->firmware_error = msg[2];
+		result->firmware_version = msg[3];
+		if (msg[2] != 0) {
+			return hfi_fail(hfi, NABU_HFI_FIRMWARE);
+		}
+		if ((msg[3] >> 28) != 2) {
+			return hfi_fail(hfi, NABU_HFI_VERSION);
+		}
+		result->acked = true;
+	} else if ((header & 0xff) == 100) {
+		result->firmware_error = words > 1 ? msg[1] : 0xffffffffu;
+		return hfi_fail(hfi, NABU_HFI_FAULT);
+	}
+	return true;
+}
+
+bool
+nabu_gpu_gmu_hfi_version(const struct nabu_gmu_memory_view *memory,
+    const struct nabu_gmu_boot_result *boot, const struct nabu_gmu_io *io,
+    struct nabu_gmu_hfi_result *result)
+{
+	if (result == NULL || result->attempted) {
+		return false;
+	}
+	memset(result, 0, sizeof(*result));
+	result->attempted = true;
+	result->error = NABU_HFI_INPUT;
+	if (memory == NULL || memory->hfi.cpu == NULL || !memory->hfi_uncached ||
+	    memory->hfi.bytes != 0x4000 || memory->hfi.iova != 0x60100000 ||
+	    ((uintptr_t)memory->hfi.cpu & 3u) != 0 ||
+	    boot == NULL || boot->failed || boot->state != NABU_GMU_BOOT_HFI_READY ||
+	    !boot->stream_published || io == NULL || io->read32 == NULL ||
+	    io->write32 == NULL || io->barrier == NULL || io->delay_us == NULL) {
+		return false;
+	}
+	struct hfi_transaction hfi = {
+		.memory = memory, .io = io, .result = result,
+		.table = (volatile struct nabu_gmu_hfi_table *)memory->hfi.cpu,
+	};
+	if (!hfi_read_reg(&hfi, HFI_VERSION_INFO, &result->hfi_version)) {
+		return false;
+	}
+	hfi.major = result->hfi_version >> 28;
+	if (hfi.major != 1 && hfi.major != 2) {
+		return hfi_fail(&hfi, NABU_HFI_VERSION);
+	}
+	if (hfi.table->version != 0 || hfi.table->words != 210 ||
+	    hfi.table->first_queue != 6 || hfi.table->queue_words != 12 ||
+	    hfi.table->queues != 3 || hfi.table->active_queues != 3) {
+		return hfi_fail(&hfi, NABU_HFI_LAYOUT);
+	}
+	uint32_t read, write;
+	if (!hfi_queue(&hfi, 0, &read, &write)) {
+		return false;
+	}
+	if (read != write) {
+		return hfi_fail(&hfi, NABU_HFI_SPACE);
+	}
+	result->cmd_read = read;
+	if (!hfi_queue(&hfi, 1, &result->rsp_read, &result->rsp_write)) {
+		return false;
+	}
+	if (result->rsp_read != result->rsp_write) {
+		return hfi_fail(&hfi, NABU_HFI_ACK);
+	}
+	/* A single new sequence; the whole returned request must match. */
+	result->request = 0x00100201u;
+	if (!hfi_write_reg(&hfi, HFI_INTR_CLEAR, 1)) {
+		return false;
+	}
+	volatile uint32_t *command = hfi_data(&hfi, 0);
+	command[write] = result->request;
+	command[(write + 1) % NABU_HFI_WORDS] = HFI_FW_SUPPORTED;
+	uint32_t occupied = hfi.major >= 2 ? 4 : 2;
+	for (uint32_t i = 2; i < occupied; i++) {
+		command[(write + i) % NABU_HFI_WORDS] = 0xfafafafau;
+	}
+	hfi_barrier(&hfi);
+	result->cmd_write = (write + occupied) % NABU_HFI_WORDS;
+	hfi.table->queue[0].write = result->cmd_write;
+	hfi_barrier(&hfi);
+	/* A failed doorbell write is uncertain and must never be retried. */
+	result->sent = true;
+	if (!hfi_write_reg(&hfi, HFI_DOORBELL, 1)) {
+		return false;
+	}
+	result->error = NABU_HFI_OK;
+	for (uint32_t i = 0; i < HFI_POLLS; i++) {
+		result->poll_reads++;
+		if (!hfi_read_reg(&hfi, HFI_INTR_INFO, &result->interrupt_info)) {
+			return false;
+		}
+		if (result->interrupt_info & (1u << 15)) {
+			return hfi_fail(&hfi, NABU_HFI_FAULT);
+		}
+		if (!hfi_receive(&hfi, 2) || !hfi_receive(&hfi, 1)) {
+			return false;
+		}
+		if (!hfi_queue(&hfi, 0, &result->cmd_read, &result->cmd_write) ||
+		    !hfi_queue(&hfi, 1, &result->rsp_read, &result->rsp_write)) {
+			return false;
+		}
+		if (result->acked) {
+			return hfi_write_reg(&hfi, HFI_INTR_CLEAR, 1);
+		}
+		io->delay_us(io->cookie, 100);
+	}
+	return hfi_fail(&hfi, NABU_HFI_TIMEOUT);
+}
+
+#endif /* ARM64_BOARD_CONFIG_NABU */
