+/* A live sampler must not call the kdp_* wait-owner helpers: those require
+ * debugger/stackshot quiescence. Capture only referenced-thread scalars under
+ * a single nonwaiting scheduler-lock attempt. Never dereference wait_event.
+ * continuation is a best-effort code location, not a captured kernel stack. */
+static void
+nabu_smp3_wait(thread_t thread, uint64_t uid, uint64_t tid)
+{
+	uint64_t event = 0, continuation = 0, stamp = 0;
+	unsigned int state = 0, hint = 0, valid = 0;
+	int result = 0;
+	char line[NABU_SMP3_LINE_BYTES];
+	spl_t level = splsched();
+	if (simple_lock_try(&thread->sched_lock, &thread_lck_grp)) {
+		state = (unsigned int)thread->state;
+		hint = (unsigned int)thread->block_hint;
+		event = (uint64_t)thread->wait_event;
+		continuation = (uint64_t)(uintptr_t)thread->continuation;
+		result = (int)thread->wait_result;
+		valid = 1;
+		thread_unlock(thread);
 	}
+	splx(level);
+	absolutetime_to_nanoseconds(mach_absolute_time(), &stamp);
+	int n = snprintf(line, sizeof(line),
+	    "NABU SMP3 W: v=1 s=%llu seq=%u uid=%llu tid=%llu t=%llu"
+	    " ok=%u st=0x%x hint=%u ev=0x%llx ct=0x%llx wr=%d\n",
+	    nabu_smp_session, nabu_sample_seq, uid, tid, stamp,
+	    valid, state, hint, event, continuation, result);
+	(void)nabu_smp3_emit_line(line, n, 0);
 }
 
