-	printf("NABU SMP3 E: v=1 s=%llu end=%llu done=%u skipped=%u reason=%s\n",
+	char end_line[241];
+	int end_n = snprintf(end_line, sizeof(end_line),
+	    "NABU SMP3 E: v=1 s=%llu end=%llu done=%u skipped=%u reason=%s\n",
 	    nabu_smp_session, nabu_smp_now_ns(), done, skipped, "complete");
+	if (end_n > 0 && end_n < (int)sizeof(end_line)) {
+		(void)nabu_log_record(end_line, end_n);
+	}
+	nabu_smp_finish();
 }
 
