+/* Confirm the sampler records preceding target, not all live producers.
+ * This never reboots and never waits indefinitely for the storage thread. */
+static void
+nabu_smp_finish(void)
+{
+	uint64_t target = nabu_log_position();
+	uint64_t deadline = nabu_smp_now_ns() + 5000000000ULL;
+	nabu_log_request_flush();
+	while (nabu_log_committed_position() < target && nabu_smp_now_ns() < deadline) {
+		nabu_smp_sleep_ns(100000000ULL);
+	}
+	uint64_t saved = nabu_log_committed_position();
+	char line[241];
+	int n = snprintf(line, sizeof(line),
+	    "NABU SMP3 D: v=1 s=%llu target=%llu saved=%llu covered=%u scope=sampler\n",
+	    nabu_smp_session, target, saved, saved >= target ? 1u : 0u);
+	if (n > 0 && n < (int)sizeof(line)) {
+		(void)nabu_log_record(line, n);
+	}
+	nabu_log_request_flush();
 }
 
