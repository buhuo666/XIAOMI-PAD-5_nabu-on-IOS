+/* Bounded user frame walk.  Only called after task_unlock. */
+static unsigned int
+nabu_smp3_frames(vm_map_t map, uint64_t fp, uint64_t *frames,
+    unsigned int max, const char **termination)
+{
+	unsigned int count = 0;
+	const char *reason = "end";
+
+	while (count < max) {
+		uint64_t frame[2];
+
+		if (fp == 0) {
