+static int
+nabu_smp3_emit(const char *format, ...)
+{
+	va_list arguments;
+	char line[NABU_SMP3_LINE_BYTES];
+	int n;
+
+	va_start(arguments, format);
+	n = vsnprintf(line, sizeof(line), format, arguments);
+	va_end(arguments);
+	if (n <= 0 || n >= (int)sizeof(line)) {
+		nabu_smp3_out++;
+		return 0;
+	}
