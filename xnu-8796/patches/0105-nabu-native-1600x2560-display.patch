-		fLogicalH = NABU_FB_LOGICAL_H;
-	}
+	fLogicalW = native ? fWidth : NABU_FB_LOGICAL_W;
+	fLogicalH = native ? fHeight : NABU_FB_LOGICAL_H;
 	fOffX = (int32_t)(fLogicalW - fWidth) / 2;
 	fOffY = (int32_t)(fLogicalH - fHeight) / 2;
