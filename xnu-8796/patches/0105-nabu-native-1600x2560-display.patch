+#define NABU_FB_DOT_PITCH              276     /* ppi, Android reports 275.71x275.64 */
 /*
- * The iOS userland only has status bar / layout data for real iPhone
- * screens (UIKit: "No status bar visual provider for screen", the red
- * rdar://45025538 bar for 360x800 points). The display is therefore
- * presented as the iPhone X panel, 1125x2436 (375x812 points @3x), and the
- * centered 1080x2400 part of it is shown on the 1080x2400 panel.
- * Boot-arg nabufb_native=1 presents the real panel size instead.
+ * Xiaomi Pad 5's panel and ABL scanout are 1600x2560.  The display service
+ * reports that same pixel canvas to iPadOS; display-scale=1 means one logical
+ * point per physical pixel.  nabufb_native=1 remains a diagnostic escape
+ * hatch for reporting the framebuffer dimensions supplied by PE_video.
  */
-#define NABU_FB_LOGICAL_W              1125
-#define NABU_FB_LOGICAL_H              2436
+#define NABU_FB_LOGICAL_W              1600
+#define NABU_FB_LOGICAL_H              2560
 #define NABU_FB_FORMAT_BGRA            0x42475241
@@ -158,14 +158,14 @@
