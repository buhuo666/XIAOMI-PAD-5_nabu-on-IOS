 /*
  * "Is this service/command pair available?" It is itself a call of the monitor's
- * information service, so the pair to ask about travels as its argument, with
- * the vendor owner bits set the way the monitor expects to see them.
- */
-static bool
-nabu_scm_available(uint64_t how, uint32_t service, uint32_t command,
-    uint64_t *answer_out)
-{
-	uint64_t target = NABU_SCM_SIP | NABU_SCM_FNID(service, command);
-	int32_t status;
