+ * information service, so the pair to ask about travels as its argument.
+ *
+ * Return both facts rather than one: whether the call was carried out at all,
+ * and what it answered. The previous run recorded only the answer, so "0" could
+ * not be told apart from "the monitor refused to run the call", and that is
+ * exactly the distinction that decides whether firmware loading is possible.
+ */
+struct nabu_scm_probe {
+	int32_t status;     /* what the monitor returned; 0 means it ran the call */
+	uint64_t answer;    /* the answer word */
+};
+
+/*
+ * Ask the monitor whether one of its own calls is available.
+ *
+ * `target` is the function id to ask about, already carrying the vendor owner
+ * bits. The question itself is a call of the information service's
+ * IS_CALL_AVAILABLE, with the target passed as its single argument.
+ */
+static struct nabu_scm_probe
+nabu_scm_ask(uint64_t how, uint64_t target)
+{
+	struct nabu_scm_probe probe;
+
+	probe.answer = 0;
+	probe.status = nabu_scm_raw(how, NABU_SCM_SVC_INFO,
+	    NABU_SCM_INFO_IS_CALL_AVAIL, NABU_SCM_SIP | target, &probe.answer,
+	    true);
+	return probe;
+}
