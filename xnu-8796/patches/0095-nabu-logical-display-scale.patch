--- a/iokit/Kernel/arm/NabuFramebuffer.cpp
+++ b/iokit/Kernel/arm/NabuFramebuffer.cpp
@@ -45,2 +45,3 @@
 #include <IOKit/IOKitKeys.h>
+#include <IOKit/IODeviceTreeSupport.h>
 #include <IOKit/IOLib.h>
@@ -160,5 +160,23 @@
 	if (!native && fWidth <= NABU_FB_LOGICAL_W && fHeight <= NABU_FB_LOGICAL_H) {
 		fLogicalW = NABU_FB_LOGICAL_W;
 		fLogicalH = NABU_FB_LOGICAL_H;
 	}
+	/* Keep the userland mode dimensions consistent with the explicit UI scale
+	 * published by the temporary loader policy. The scanout allocation remains
+	 * native; this changes only the dimensions returned by the IOMFB service. */
+	IORegistryEntry *chosen = IORegistryEntry::fromPath("/chosen", gIODTPlane);
+	if (chosen != NULL) {
+		OSData *scale = OSDynamicCast(OSData, chosen->getProperty("display-scale"));
+		if (scale != NULL && scale->getLength() == sizeof(uint32_t)) {
+			uint32_t value = 0;
+			bcopy(scale->getBytesNoCopy(), &value, sizeof(value));
+			if (value == 2 && fWidth % 2 == 0 && fHeight % 2 == 0) {
+				fLogicalW = fWidth / 2;
+				fLogicalH = fHeight / 2;
+				IOLog("NABU FB: display scale %u, presented as %ux%u\n",
+				    value, fLogicalW, fLogicalH);
+			}
+		}
+		chosen->release();
+	}
 	fOffX = (int32_t)(fLogicalW - fWidth) / 2;
