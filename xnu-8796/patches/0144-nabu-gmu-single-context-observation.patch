+static bool
+smmu_clock_observe(const char *prefix)
+{
+	vm_offset_t gcc, gpucc;
+	bool confirmed = true;
+
+	gcc = ml_io_map(SMMU_CLOCK_GCC_BASE, SMMU_CLOCK_GCC_SIZE);
+	if (gcc == 0) {
+		printf("%s: cannot map GCC; SMMU remains blocked\n", prefix);
+		return false;
+	}
+	gpucc = ml_io_map(SMMU_CLOCK_GPUCC_BASE, SMMU_CLOCK_GPUCC_SIZE);
+	if (gpucc == 0) {
+		printf("%s: cannot map GPUCC; SMMU remains blocked\n", prefix);
+		return false;
+	}
+	printf("%s: read four known power/clock words once; no writes\n", prefix);
+	for (unsigned i = 0; i < sizeof(clock_words) / sizeof(clock_words[0]); i++) {
+		const struct smmu_clock_word *word = &clock_words[i];
+		uint32_t value;
+		bool ready;
+		unsigned long physical = (word->gcc ? SMMU_CLOCK_GCC_BASE :
+		    SMMU_CLOCK_GPUCC_BASE) + word->offset;
+		printf("%s: reading %s pa=0x%lx\n", prefix, word->name, physical);
+		value = smmu_clock_load(word->gcc ? gcc : gpucc, word->offset);
+		if (word->supply) {
+			ready = (value & (SMMU_CX_ON | SMMU_CX_COLLAPSE)) == SMMU_CX_ON;
+		} else {
+			ready = (value & (SMMU_CLOCK_ENABLE | SMMU_CLOCK_OFF)) == SMMU_CLOCK_ENABLE;
+		}
+		confirmed = confirmed && ready;
+		printf("%s: %s pa=0x%lx value=0x%08x confirmed=%u\n",
+		    prefix, word->name, physical, value, ready ? 1u : 0u);
+	}
+	printf("%s: result=%s; four reads, zero writes\n",
+	    prefix, confirmed ? "CONFIRMED" : "BLOCKED");
+	return confirmed;
+}
+
+bool
+nabu_gpu_smmu_clocks_recheck(void)
+{
+	/* A separate, explicit post-root probe needs current clock evidence. */
+	return smmu_clock_observe("nabugmucbclk");
+}
