+}
+
+int
+nvt_read_point_frame_diag(const struct nvt_bus *bus,
+    uint8_t frame[NVT_POINT_DATA_LEN], struct nvt_frame_diag *diag)
+{
+	if (diag != NULL) { memset(diag, 0, sizeof(*diag)); diag->stage = 1; }
+	if (frame == NULL) return -1;
+	int rc = nvt_set_page(bus, NVT_EVENT_BUF_ADDR);
+	if (diag != NULL) diag->page_status = rc;
+	if (rc != 0) return rc;
+	uint8_t tx[NVT_POINT_DATA_LEN + 2], rx[NVT_POINT_DATA_LEN + 2];
 	memset(tx, 0, sizeof(tx));
-	if (nvt_xfer(bus, tx, rx, sizeof(tx)) != 0) {
-		return -1;
-	}
+	if (diag != NULL) diag->stage = 2;
+	rc = nvt_xfer(bus, tx, rx, sizeof(tx));
+	if (diag != NULL) diag->transfer_status = rc;
+	if (rc != 0) return rc;
 	memcpy(frame, rx + 2, NVT_POINT_DATA_LEN);
-	return nvt_validate_point_frame(frame);
+	unsigned sum = 0;
+	for (size_t i = 0; i + 1 < NVT_POINT_DATA_LEN; ++i) sum += frame[i];
+	uint8_t expected = (uint8_t)(0u - sum);
+	if (diag != NULL) { diag->stage = 3; diag->checksum_sum = (uint8_t)sum;
+		diag->checksum_expected = expected; diag->checksum_observed = frame[NVT_POINT_DATA_LEN - 1]; }
+	if (expected != frame[NVT_POINT_DATA_LEN - 1]) return -1;
+	bool recovery_77 = true, recovery_fd_fe = true;
+	for (size_t i = 0; i < 6; ++i) { recovery_77 &= frame[i] == 0x77u;
+		recovery_fd_fe &= frame[i] == 0xfdu || frame[i] == 0xfeu; }
+	if (recovery_77 || recovery_fd_fe) { if (diag != NULL) diag->stage = 4; return -1; }
+	if (diag != NULL) diag->stage = 5;
+	return 0;
 }
 
