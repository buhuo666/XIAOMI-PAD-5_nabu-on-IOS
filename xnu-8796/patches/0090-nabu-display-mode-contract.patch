+
+/* One native software mode; this describes the existing scanout, not panel MMIO. */
+static bool
+nabu_mode_number(OSDictionary *dict, const char *key, uint32_t value)
+{
+	OSNumber *number = OSNumber::withNumber(value, 32);
+	if (number == NULL) return false;
+	bool ok = dict->setObject(key, number);
+	number->release();
+	return ok;
+}
+
+bool
+AppleCLCD::publishDisplayModes(void)
+{
+	OSDictionary *timing = OSDictionary::withCapacity(8);
+	OSDictionary *horizontal = OSDictionary::withCapacity(4);
+	OSDictionary *vertical = OSDictionary::withCapacity(4);
+	OSDictionary *color = OSDictionary::withCapacity(8);
+	OSArray *timings = OSArray::withCapacity(1);
+	OSArray *colors = OSArray::withCapacity(1);
+	bool ok = false;
+	if (timing == NULL || horizontal == NULL || vertical == NULL || color == NULL ||
+	    timings == NULL || colors == NULL) goto done;
+	ok = nabu_mode_number(color, "ID", 1) &&
+	    nabu_mode_number(color, "PixelEncoding", 0) &&
+	    nabu_mode_number(color, "Depth", 8) &&
+	    nabu_mode_number(color, "Colorimetry", 1) &&
+	    nabu_mode_number(color, "EOTF", 1) &&
+	    nabu_mode_number(color, "DynamicRange", 0) &&
+	    nabu_mode_number(color, "Score", 1) &&
+	    color->setObject("IsVirtual", kOSBooleanFalse) && colors->setObject(color) &&
+	    nabu_mode_number(horizontal, "Active", fLogicalW) &&
+	    nabu_mode_number(horizontal, "Total", fLogicalW) &&
+	    nabu_mode_number(horizontal, "SyncRate", 60u << 16) &&
+	    nabu_mode_number(horizontal, "PreciseSyncRate", 60u << 16) &&
+	    nabu_mode_number(vertical, "Active", fLogicalH) &&
+	    nabu_mode_number(vertical, "Total", fLogicalH) &&
+	    nabu_mode_number(vertical, "SyncRate", 60u << 16) &&
+	    nabu_mode_number(vertical, "PreciseSyncRate", 60u << 16) &&
+	    nabu_mode_number(timing, "ID", 1) && nabu_mode_number(timing, "Score", 1) &&
+	    timing->setObject("IsVirtual", kOSBooleanFalse) &&
+	    timing->setObject("IsOverscanned", kOSBooleanFalse) &&
+	    timing->setObject("HorizontalAttributes", horizontal) &&
+	    timing->setObject("VerticalAttributes", vertical) &&
+	    timing->setObject("ColorModes", colors) && timings->setObject(timing);
+	if (ok) ok = setProperty("TimingElements", timings) && setProperty("ColorElements", colors);
+	if (!ok) { removeProperty("TimingElements"); removeProperty("ColorElements"); }
+done:
+	OSSafeReleaseNULL(timings); OSSafeReleaseNULL(colors);
+	OSSafeReleaseNULL(timing); OSSafeReleaseNULL(horizontal);
+	OSSafeReleaseNULL(vertical); OSSafeReleaseNULL(color);
+	if (ok) IOLog("NABU MODE: %ux%u rate16=0x%x timing=1 color=1 RGB8 SDR\n",
+	    fLogicalW, fLogicalH, 60u << 16);
+	return ok;
 }
 
