diff --git a/bsd/sys/nabu_boottrace_queue.h b/bsd/sys/nabu_boottrace_queue.h
new file mode 100644
--- /dev/null
+++ b/bsd/sys/nabu_boottrace_queue.h
@@ -0,0 +1,76 @@
+/* Fixed-memory, try-lock-only boot event queue. No producer waits or I/O. */
+#ifndef NABU_BOOTTRACE_QUEUE_H
+#define NABU_BOOTTRACE_QUEUE_H
+#include <stdint.h>
+
+#define NABU_BT_SLOTS 4096u
+#define NABU_BT_PATH 320u
+#define NABU_BT_NAME 17u
+
+struct nabu_bt_event {
+	uint64_t sequence, id, ns, tid, elapsed_ns;
+	int32_t pid, ppid, result, auxiliary;
+	uint32_t kind, edge, truncated, path_bytes;
+	char name[NABU_BT_NAME];
+	unsigned char path[NABU_BT_PATH];
+};
+
+struct nabu_bt_queue {
+	unsigned int lock, read_at, write_at, count;
+	uint64_t offered, accepted, busy_dropped, full_dropped, consumed;
+	struct nabu_bt_event events[NABU_BT_SLOTS];
+};
+
+static inline int
+nabu_bt_try_lock(struct nabu_bt_queue *q)
+{
+	unsigned int expected = 0;
+	return __atomic_compare_exchange_n(&q->lock, &expected, 1u, 0,
+	           __ATOMIC_ACQUIRE, __ATOMIC_RELAXED);
+}
+
+static inline void
+nabu_bt_unlock(struct nabu_bt_queue *q)
+{
+	__atomic_store_n(&q->lock, 0u, __ATOMIC_RELEASE);
+}
+
+static inline int
+nabu_bt_push(struct nabu_bt_queue *q, struct nabu_bt_event *event)
+{
+	event->sequence = __atomic_add_fetch(&q->offered, 1ULL, __ATOMIC_RELAXED);
+	if (!nabu_bt_try_lock(q)) {
+		__atomic_fetch_add(&q->busy_dropped, 1ULL, __ATOMIC_RELAXED);
+		return 0;
+	}
+	if (q->count == NABU_BT_SLOTS) {
+		__atomic_fetch_add(&q->full_dropped, 1ULL, __ATOMIC_RELAXED);
+		nabu_bt_unlock(q);
+		return 0;
+	}
+	q->events[q->write_at] = *event;
+	q->write_at = (q->write_at + 1u) % NABU_BT_SLOTS;
+	++q->count;
+	__atomic_fetch_add(&q->accepted, 1ULL, __ATOMIC_RELAXED);
+	nabu_bt_unlock(q);
+	return 1;
+}
+
+static inline int
+nabu_bt_pop(struct nabu_bt_queue *q, struct nabu_bt_event *event)
+{
+	if (!nabu_bt_try_lock(q)) {
+		return 0;
+	}
+	if (q->count == 0) {
+		nabu_bt_unlock(q);
+		return 0;
+	}
+	*event = q->events[q->read_at];
+	q->read_at = (q->read_at + 1u) % NABU_BT_SLOTS;
+	--q->count;
+	__atomic_fetch_add(&q->consumed, 1ULL, __ATOMIC_RELAXED);
+	nabu_bt_unlock(q);
+	return 1;
+}
+#endif
diff --git a/bsd/sys/nabu_boottrace.h b/bsd/sys/nabu_boottrace.h
new file mode 100644
--- /dev/null
+++ b/bsd/sys/nabu_boottrace.h
@@ -0,0 +1,37 @@
+/* Observational events only. A path lookup/open is not bundle registration. */
+#ifndef NABU_BOOTTRACE_H
+#define NABU_BOOTTRACE_H
+#include <stdint.h>
+
+enum nabu_bt_kind {
+	NABU_BT_LOOKUP = 1, NABU_BT_OPEN = 2, NABU_BT_EXEC = 3, NABU_BT_EXIT = 4
+};
+struct nabu_bt_token { uint64_t id, ns; };
+
+#if defined(ARM64_BOARD_CONFIG_NABU)
+extern struct nabu_bt_token nabu_boottrace_begin(unsigned int kind, int auxiliary);
+extern void nabu_boottrace_path(struct nabu_bt_token token, unsigned int kind,
+    const char *kernel_path);
+extern void nabu_boottrace_end(struct nabu_bt_token token, unsigned int kind,
+    int result, int auxiliary);
+extern void nabu_boottrace_start(void);
+#else
+static inline struct nabu_bt_token
+nabu_boottrace_begin(unsigned int kind, int auxiliary)
+{
+	(void)kind; (void)auxiliary;
+	return (struct nabu_bt_token){ 0, 0 };
+}
+static inline void
+nabu_boottrace_path(struct nabu_bt_token token, unsigned int kind, const char *path)
+{
+	(void)token; (void)kind; (void)path;
+}
+static inline void
+nabu_boottrace_end(struct nabu_bt_token token, unsigned int kind, int result, int auxiliary)
+{
+	(void)token; (void)kind; (void)result; (void)auxiliary;
+}
+static inline void nabu_boottrace_start(void) {}
+#endif
+#endif
diff --git a/bsd/dev/nabu_boottrace.c b/bsd/dev/nabu_boottrace.c
new file mode 100644
--- /dev/null
+++ b/bsd/dev/nabu_boottrace.c
@@ -0,0 +1,164 @@
+/*
+ * Opt-in system-wide boot boundaries. Producers only copy bounded kernel
+ * memory into a preallocated queue; formatting and console output run here.
+ */
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/proc_internal.h>
+#include <sys/nabu_boottrace.h>
+#include <sys/nabu_boottrace_queue.h>
+#include <kern/thread.h>
+#include <kern/clock.h>
+#include <pexpert/pexpert.h>
+
+#if defined(ARM64_BOARD_CONFIG_NABU)
+static struct nabu_bt_queue nabu_bt_events;
+static unsigned int nabu_bt_enabled, nabu_bt_started;
+static uint64_t nabu_bt_id;
+
+static uint64_t
+nabu_bt_now(void)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(mach_absolute_time(), &ns);
+	return ns;
+}
+
+static void
+nabu_bt_identity(struct nabu_bt_event *event)
+{
+	proc_t p = current_proc();
+	event->pid = p ? proc_getpid(p) : 0;
+	event->ppid = p ? proc_ppid(p) : 0;
+	event->tid = thread_tid(current_thread());
+	if (p) {
+		for (unsigned int i = 0; i < NABU_BT_NAME - 1 && p->p_comm[i]; ++i) {
+			event->name[i] = p->p_comm[i];
+		}
+	}
+	event->ns = nabu_bt_now();
+}
+
+struct nabu_bt_token
+nabu_boottrace_begin(unsigned int kind, int auxiliary)
+{
+	struct nabu_bt_token token = { 0, 0 };
+	if (!__atomic_load_n(&nabu_bt_enabled, __ATOMIC_ACQUIRE)) {
+		return token;
+	}
+	struct nabu_bt_event event = { 0 };
+	nabu_bt_identity(&event);
+	event.id = __atomic_add_fetch(&nabu_bt_id, 1ULL, __ATOMIC_RELAXED);
+	event.kind = kind;
+	event.edge = 1;
+	event.auxiliary = auxiliary;
+	token.id = event.id;
+	token.ns = event.ns;
+	(void)nabu_bt_push(&nabu_bt_events, &event);
+	return token;
+}
+
+void
+nabu_boottrace_path(struct nabu_bt_token token, unsigned int kind, const char *kernel_path)
+{
+	if (!token.id || !kernel_path) {
+		return;
+	}
+	struct nabu_bt_event event = { 0 };
+	nabu_bt_identity(&event);
+	event.id = token.id;
+	event.kind = kind;
+	event.edge = 2;
+	for (unsigned int i = 0; i < NABU_BT_PATH; ++i) {
+		if (!kernel_path[i]) {
+			break;
+		}
+		event.path[event.path_bytes++] = (unsigned char)kernel_path[i];
+	}
+	event.truncated = event.path_bytes == NABU_BT_PATH;
+	(void)nabu_bt_push(&nabu_bt_events, &event);
+}
+
+void
+nabu_boottrace_end(struct nabu_bt_token token, unsigned int kind, int result, int auxiliary)
+{
+	if (!token.id) {
+		return;
+	}
+	struct nabu_bt_event event = { 0 };
+	nabu_bt_identity(&event);
+	event.id = token.id;
+	event.kind = kind;
+	event.edge = 3;
+	event.result = result;
+	event.auxiliary = auxiliary;
+	event.elapsed_ns = event.ns >= token.ns ? event.ns - token.ns : 0;
+	(void)nabu_bt_push(&nabu_bt_events, &event);
+}
+
+static void
+nabu_bt_emit(const struct nabu_bt_event *event)
+{
+	/* Each line fits the port's console limit. Hex preserves path bytes. */
+	printf("BTE q=%llu id=%llu ns=%llu pid=%d pp=%d tid=%llu k=%u e=%u r=%d a=%d dt=%llu n=%s len=%u cut=%u\n",
+	    event->sequence, event->id, event->ns, event->pid, event->ppid, event->tid,
+	    event->kind, event->edge, event->result, event->auxiliary,
+	    event->elapsed_ns, event->name, event->path_bytes, event->truncated);
+	static const char digits[] = "0123456789abcdef";
+	for (unsigned int at = 0; at < event->path_bytes; at += 64) {
+		char hex[129];
+		unsigned int count = MIN(64u, event->path_bytes - at);
+		for (unsigned int i = 0; i < count; ++i) {
+			unsigned char byte = event->path[at + i];
+			hex[i * 2] = digits[byte >> 4];
+			hex[i * 2 + 1] = digits[byte & 15];
+		}
+		hex[count * 2] = 0;
+		printf("BTP q=%llu id=%llu off=%u hex=%s\n",
+		    event->sequence, event->id, at, hex);
+	}
+}
+
+static void
+nabu_bt_worker(__unused void *arg, __unused wait_result_t wr)
+{
+	static int channel;
+	unsigned int tick = 0;
+	struct nabu_bt_event event;
+	printf("BTS v=1 slots=%u path=%u drain=128 period=1 scope=namei,open1,image,exit\n",
+	    NABU_BT_SLOTS, NABU_BT_PATH);
+	for (;;) {
+		(void)tsleep(&channel, PZERO, "nabubtrace", hz);
+		for (unsigned int i = 0; i < 128 && nabu_bt_pop(&nabu_bt_events, &event); ++i) {
+			nabu_bt_emit(&event);
+		}
+		if (++tick % 10u == 0) {
+			printf("BTC ns=%llu offered=%llu accepted=%llu busy=%llu full=%llu out=%llu\n",
+			    nabu_bt_now(),
+			    __atomic_load_n(&nabu_bt_events.offered, __ATOMIC_RELAXED),
+			    __atomic_load_n(&nabu_bt_events.accepted, __ATOMIC_RELAXED),
+			    __atomic_load_n(&nabu_bt_events.busy_dropped, __ATOMIC_RELAXED),
+			    __atomic_load_n(&nabu_bt_events.full_dropped, __ATOMIC_RELAXED),
+			    __atomic_load_n(&nabu_bt_events.consumed, __ATOMIC_RELAXED));
+		}
+	}
+}
+
+void
+nabu_boottrace_start(void)
+{
+	int enabled = 0;
+	unsigned int expected = 0;
+	thread_t thread;
+	if (!PE_parse_boot_argn("nabutraceall", &enabled, sizeof(enabled)) || enabled != 1 ||
+	    !__atomic_compare_exchange_n(&nabu_bt_started, &expected, 1u, 0,
+	    __ATOMIC_ACQ_REL, __ATOMIC_RELAXED)) {
+		return;
+	}
+	/* Matches the existing background cleanup thread priority in fasttrap.c. */
+	if (kernel_thread_start_priority(nabu_bt_worker, NULL, 46, &thread) == KERN_SUCCESS) {
+		__atomic_store_n(&nabu_bt_enabled, 1u, __ATOMIC_RELEASE);
+		thread_deallocate(thread);
+	}
+}
+#endif
