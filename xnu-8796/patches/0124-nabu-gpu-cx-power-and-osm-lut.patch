 /*
- * Power switches (GDSCR) are NOT in SM8150's clock table: the reference reached
- * them directly at gpucc 0x100c / 0x106c, but on this SoC they belong to the
- * gdsc provider and their offsets come from the device tree's qcom,gdsc node.
- * UNVERIFIED: fill in once the gdsc node is read; do not reuse the reference
- * values, which are for a different SoC generation.
- */
-#define NABU_GPUCC_GX_GDSCR         0xFFFFFFFFu
-#define NABU_GPUCC_CX_GDSCR         0xFFFFFFFFu
+ * Power switches (GDSCR). Verified against upstream Linux gpucc-sm8150.c, which
+ * declares gpu_cx_gdsc.gdscr = 0x106c and gpu_gx_gdsc.gdscr = 0x100c. These are
+ * the SAME offsets the reference port uses, so no adaptation is needed after all:
+ * the earlier note that they belonged to a separate provider was wrong, they are
+ * simply declared there and reached through the same clock-controller block.
+ */
+#define NABU_GPUCC_GX_GDSCR         0x100c  /* the 3D core's power switch */
+#define NABU_GPUCC_CX_GDSCR         0x106c  /* the CX half's power switch */
+
+/* Companion registers declared next to the switches in gpucc-sm8150.c. */
+#define NABU_GPUCC_CX_HW_CTRL       0x1540  /* gds_hw_ctrl for the CX switch */
+#define NABU_GPUCC_GX_CLAMP_IO      0x1508  /* clamp_io_ctrl for the GX switch */
+
+/*
+ * GDSC control bits, from Linux's gdsc.c as the reference port also uses them:
+ *   bit0  software collapse (set = off, clear = on)
+ *   bit1  the switch is under hardware control, not ours to operate
+ *   bit31 the domain's power state as it is now
+ */
+#define NABU_GDSC_SW_COLLAPSE       (1u << 0)
+#define NABU_GDSC_HW_CONTROL        (1u << 1)
+#define NABU_GDSC_POWER_ON          (1u << 31)
 
 /* Not present in SM8150's clock table; confirm per step before use. */
