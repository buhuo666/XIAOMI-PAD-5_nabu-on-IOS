+
+static bool
+joint_resource_checkpoint(unsigned stage, bool complete)
+{
+	const char *phase = complete ? "complete" : "intent";
+
+	printf("nabugmujointresources: checkpoint stage=%u phase=%s\n", stage, phase);
+	if (!joint_wait_for_commit(nabu_log_position(), 3, joint_prefix())) {
+		joint_resource_wait_failed = true;
