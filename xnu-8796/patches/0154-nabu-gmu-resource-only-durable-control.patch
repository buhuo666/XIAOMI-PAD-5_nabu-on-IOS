+	    "fsr_mappings=0 resource_checkpoints=12 log_waits=15 writes=0 "
+	    "ownership_proven=0 clients_quiesced=0\n",
 	    joint_values[0], joint_values[1], joint_values[1] & 1u, joint_valid_mask);
 }
 
