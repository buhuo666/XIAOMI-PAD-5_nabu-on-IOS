+		return;
+	}
+	printf("nabugmujointresources: intent committed step=3; refreshing four known resource words\n");
+	if (!nabu_gpu_smmu_clocks_recheck_traced(joint_resource_checkpoint)) {
+		if (!joint_resource_wait_failed) {
