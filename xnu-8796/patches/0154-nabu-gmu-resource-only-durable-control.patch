-smmu_clock_observe(const char *prefix)
+smmu_clock_observe(const char *prefix, nabu_smmu_clock_checkpoint_t checkpoint)
 {
 	vm_offset_t gcc, gpucc;
 	bool confirmed = true;
 
+	if (checkpoint != NULL && !checkpoint(1, false)) {
+		return false;
+	}
 	gcc = ml_io_map(SMMU_CLOCK_GCC_BASE, SMMU_CLOCK_GCC_SIZE);
 	if (gcc == 0) {
 		printf("%s: cannot map GCC; SMMU remains blocked\n", prefix);
 		return false;
 	}
+	if (checkpoint != NULL && (!checkpoint(1, true) || !checkpoint(2, false))) {
