+static bool
+nbu_upload_firmware(void)
+{
+	DTEntry chosen;
+	const uint8_t *data = NULL;
+	unsigned int bytes = 0;
+	struct nbu_firmware fw;
+	struct nbu_fw_result result = {0};
+	if (!ts.chip_verified ||
+	    SecureDTLookupEntry(NULL, "/chosen", &chosen) != kSuccess ||
+	    SecureDTGetProperty(chosen, "nabu-touch-firmware",
+	    (void const **)&data, &bytes) != kSuccess) {
+		printf("NABU TOUCH: no controller firmware in owned boot-memory DT\n");
+		return false;
+	}
+	if (bytes != NBU_FW_IMAGE_BYTES || nbu_fw_parse(data, bytes, &fw) ||
+	    fw.version != 0x12u) {
+		printf("NABU TOUCH: unsupported/bad controller firmware bytes=%u\n", bytes);
+		return false;
+	}
+	printf("NABU TOUCH: SRAM firmware load version=%u bytes=%u parts=%u cascade=%u\n",
+	    fw.version, bytes, fw.count, fw.cascade);
+	int rc = nbu_fw_download(&ts.bus, &fw, &result);
+	printf("NABU TOUCH: firmware result=%d stage=%u part=%u offset=%#x written=%u verified=%u status=%#x\n",
+	    rc, result.stage, result.partition, result.offset,
+	    result.written, result.verified, result.observed);
+	printf("NABU TOUCH: firmware ready=%#x crc-flag=%#x expected=%#x/%#x result=%#x/%#x values-match=%u\n",
+	    result.reset_state, result.crc_flag, result.crc_expected[0], result.crc_expected[1],
+	    result.crc_result[0], result.crc_result[1], result.crc_values_match);
+	if (rc) {
+		return false;
+	}
+	return nbu_probe_chip();
+}
