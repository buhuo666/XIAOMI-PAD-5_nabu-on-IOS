+	if ((nbu_probe_chip() || nbu_upload_firmware()) && nbu_wait_firmware()) {
 		nbu_poll_points();
 	}
 
diff --git a/bsd/dev/nabu_touch_firmware.h b/bsd/dev/nabu_touch_firmware.h
new file mode 100644
index 0000000..e2f604b
--- /dev/null
+++ b/bsd/dev/nabu_touch_firmware.h
@@ -0,0 +1,261 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent
+ * NT36523 host download, from nabu vendor protocol/register facts.
+ * Only controller SRAM and explicitly named volatile control registers.
+ * No flash programming commands, disk access, allocation or unbounded retry.
+ */
+#ifndef NABU_TOUCH_FIRMWARE_H
+#define NABU_TOUCH_FIRMWARE_H
+#include <stddef.h>
+#include <stdint.h>
+#include "nabu_nt36523.h"
+
+#define NBU_FW_PARTS 32u
+#define NBU_FW_SRAM_END 0x3f000u
+#define NBU_FW_IMAGE_BYTES 196608u
+#define NBU_FW_EVENT 0x2fe00u
+struct nbu_fw_part { uint32_t bin, ram, size, crc; };
+struct nbu_firmware {
+	const uint8_t *data;
+	size_t length;
+	unsigned count, cascade, version;
+	struct nbu_fw_part part[NBU_FW_PARTS];
+};
+struct nbu_fw_result {
+	unsigned stage, partition;
+	uint32_t offset, written, verified, observed;
+	uint32_t crc_expected[2], crc_result[2];
+	unsigned reset_state, crc_flag, crc_values_match;
+};
+static inline uint32_t
+nbu_fw_u32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | (uint32_t)p[1] << 8 |
+	       (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+static inline int
+nbu_fw_parse(const uint8_t *data, size_t length, struct nbu_firmware *fw)
+{
+	if (!data || !fw || length < 8192 || length > 0x40000 ||
+	    length % 4096 || data[length - 3] != 'N' ||
+	    data[length - 2] != 'V' || data[length - 1] != 'T') {
+		return -1;
+	}
+	size_t version = length - 4096;
+	if ((unsigned)data[version] + data[version + 1] != 255u) {
+		return -1;
+	}
+	uint32_t end = nbu_fw_u32(data);
+	if (end < 0x40 || end > 0x1000 || end % 16 || end >= length) {
+		return -1;
+	}
+	fw->data = data;
+	fw->length = length;
+	fw->version = data[version];
+	fw->cascade = (data[0x20] >> 1) & 1u;
+	if (fw->cascade && (end < 0x80 || end % 32)) {
+		return -1;
+	}
+	unsigned info = ((fw->cascade ? end / 2 : end) - 0x30) / 16 +
+	    fw->cascade;
+	unsigned overlay = data[0x28] & 0x10u ? data[0x28] & 15u : 0;
+	fw->count = 2u + info + overlay;
+	if (fw->count > NBU_FW_PARTS) {
+		return -1;
+	}
+	unsigned found_header = 0;
+	for (unsigned i = 0; i < fw->count; ++i) {
+		struct nbu_fw_part *p = &fw->part[i];
+		if (i < 2) {
+			p->bin = nbu_fw_u32(data + i * 12);
+			p->ram = nbu_fw_u32(data + i * 12 + 4);
+			p->size = nbu_fw_u32(data + i * 12 + 8);
+			p->crc = nbu_fw_u32(data + 0x18 + i * 4);
+			if (!p->size || p->size > 0x1ffffu) {
+				return -1;
+			}
+		} else {
+			uint64_t at = i < 2 + info ?
+			    (found_header && fw->cascade ? end - 16 :
+			     0x30u + 16u * (i - 2u)) :
+			    (uint64_t)fw->part[1].bin + 16u * (i - 2u - info);
+			if (at > length || length - at < 16) {
+				return -1;
+			}
+			p->ram = nbu_fw_u32(data + at);
+			p->size = nbu_fw_u32(data + at + 4);
+			p->bin = nbu_fw_u32(data + at + 8);
+			p->crc = nbu_fw_u32(data + at + 12);
+			if (i < 2 + info && p->bin < end && p->size) {
+				found_header = 1;
+			}
+		}
+		if (!p->size) {
+			continue; /* Reserved table entries are not transferred. */
+		}
+		uint64_t bytes = (uint64_t)p->size + 1u;
+		if ((uint64_t)p->bin + bytes > length ||
+		    (uint64_t)p->ram + bytes > NBU_FW_SRAM_END) {
+			return -1;
+		}
+		for (unsigned j = 0; j < i; ++j) {
+			const struct nbu_fw_part *other = &fw->part[j];
+			if (other->size && p->ram < (uint64_t)other->ram + other->size + 1u &&
+			    other->ram < (uint64_t)p->ram + bytes) {
+				return -1;
+			}
+		}
+	}
+	return 0;
+}
+
+static inline int
+nbu_fw_write_number(const struct nvt_bus *bus, uint32_t address,
+    uint32_t value, unsigned bytes)
+{
+	uint8_t raw[4];
+	for (unsigned i = 0; i < 4; ++i) {
+		raw[i] = (uint8_t)(value >> (8u * i));
+	}
+	return nvt_write_addr(bus, address, raw, bytes);
+}
+
+static inline int
+nbu_fw_download(const struct nvt_bus *bus, const struct nbu_firmware *fw,
+    struct nbu_fw_result *out)
+{
+	if (!bus || !bus->delay_ms || !fw || !out || fw->count < 2 ||
+	    fw->count > NBU_FW_PARTS) {
+		return -1;
+	}
+	out->stage = 1; out->partition = 0; out->offset = 0;
+	out->written = out->verified = out->observed = 0;
+	out->reset_state = out->crc_flag = out->crc_values_match = 0;
+	for (unsigned i = 0; i < 2; ++i) {
+		out->crc_expected[i] = fw->part[i].crc;
+		out->crc_result[i] = 0;
+	}
+	if (nbu_fw_write_number(bus, 0x3f0feu, 0x69u, 1)) {
+		return -1;
+	}
+	bus->delay_ms(bus->ctx, 5);
+	if (nbu_fw_write_number(bus, 0x3f310u, 0, 1)) {
+		return -1;
+	}
+	out->stage = 2;
+	/* NT36523 uses hw_crc=2: 17-bit size in three bytes. */
+	for (unsigned i = 0; i < 2; ++i) {
+		const struct nbu_fw_part *p = &fw->part[i];
+		if (nbu_fw_write_number(bus, i ? 0x3f12cu : 0x3f128u, p->ram, 3) ||
+		    nbu_fw_write_number(bus, i ? 0x3f130u : 0x3f118u, p->size, 3) ||
+		    nbu_fw_write_number(bus, i ? 0x3f104u : 0x3f100u, p->crc, 4)) {
+			return -1;
+		}
+	}
+	out->stage = 3;
+	if (fw->cascade && nbu_fw_write_number(bus, 0x3f7e8u, 0x69u, 1)) {
+		return -1;
+	}
+	/* First transfer all parts, then await cascade copy and read back.
+	 * Each transfer stays within one 128-byte page and a small kernel stack. */
+	for (unsigned pass = 0; pass < 2; ++pass) {
+		out->stage = pass ? 6 : 4;
+		for (unsigned i = 0; i < fw->count; ++i) {
+			const struct nbu_fw_part *p = &fw->part[i];
+			if (!p->size) {
+				continue;
+			}
+			for (uint32_t at = 0; at <= p->size;) {
+				uint32_t address = p->ram + at;
+				unsigned n = 128u - (address & 127u);
+				if (n > p->size + 1u - at) {
+					n = p->size + 1u - at;
+				}
+				out->partition = i; out->offset = at;
+				if (!pass) {
+					if (nvt_write_addr(bus, address, fw->data + p->bin + at, n)) {
+						return -1;
+					}
+					out->written += n;
+				} else {
+					uint8_t verify[128];
+					if (nvt_read_addr(bus, address, verify, n)) {
+						return -1;
+					}
+					for (unsigned k = 0; k < n; ++k) {
+						if (verify[k] != fw->data[p->bin + at + k]) {
+							out->observed = verify[k];
+							return -1;
+						}
+					}
+					out->verified += n;
+				}
+				at += n;
+			}
+		}
+		if (!pass && fw->cascade) {
+			out->stage = 5;
+			unsigned done = 0;
+			for (unsigned tries = 0; tries < 200; ++tries) {
+				uint8_t state;
+				if (nvt_read_addr(bus, 0x3f7f1u, &state, 1)) {
+					return -1;
+				}
+				out->observed = state;
+				if (!state) { done = 1; break; }
+				bus->delay_ms(bus->ctx, 1);
+			}
+			if (!done) {
+				return -1;
+			}
+		}
+	}
+	out->stage = 7;
+	uint8_t crc_enable;
+	if (nvt_read_addr(bus, 0x3f30eu, &crc_enable, 1) ||
+	    nbu_fw_write_number(bus, 0x3f30eu, crc_enable | 0x80u, 1) ||
+	    nbu_fw_write_number(bus, NBU_FW_EVENT | 0x60u, 0, 1) ||
+	    nbu_fw_write_number(bus, NBU_FW_EVENT | 0x50u, 0xaeu, 1) ||
+	    nbu_fw_write_number(bus, 0x3f10du, 1, 1)) {
+		return -1;
+	}
+	out->stage = 8;
+	unsigned ready = 0;
+	for (unsigned tries = 0; tries < 500; ++tries) {
+		uint8_t state;
+		if (nvt_read_addr(bus, NBU_FW_EVENT | 0x60u, &state, 1)) {
+			return -1;
+		}
+		out->observed = state;
+		out->reset_state = state;
+		if (state >= 0xa1u && state <= 0xafu) { ready = 1; break; }
+		bus->delay_ms(bus->ctx, 10);
+	}
+	if (!ready) {
+		return -1;
+	}
+	out->stage = 9;
+	uint8_t flag, results[8];
+	if (nvt_read_addr(bus, 0x3f133u, &flag, 1) ||
+	    nvt_read_addr(bus, 0x3f120u, results, sizeof(results))) {
+		return -1;
+	}
+	out->observed = flag;
+	out->crc_flag = flag;
+	out->crc_result[0] = nbu_fw_u32(results);
+	out->crc_result[1] = nbu_fw_u32(results + 4);
+	out->crc_values_match = out->crc_result[0] == out->crc_expected[0] &&
+	    out->crc_result[1] == out->crc_expected[1];
+	/* nabu vendor HW-CRC boot accepts the initialized firmware state;
+	 * result registers are read for failure diagnostics, not compared after
+	 * running firmware has initialized. Preserve the raw numbers as evidence.
+	 * Require full pre-boot SRAM readback, actual readiness and the hardware
+	 * done/no-ILM-or-DLM-error bits; never ignore a CRC error or missing done. */
+	if ((flag & 7u) != 4u || out->written != out->verified ||
+	    !out->written || out->reset_state < 0xa1u || out->reset_state > 0xafu) {
+		return -1;
+	}
+	out->stage = 10;
+	return 0;
+}
+#endif
