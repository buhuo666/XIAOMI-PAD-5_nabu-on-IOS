diff --git a/bsd/dev/nabu_project_storage.h b/bsd/dev/nabu_project_storage.h
new file mode 100644
--- /dev/null
+++ b/bsd/dev/nabu_project_storage.h
@@ -0,0 +1,149 @@
+/*
+ * Storage contract for this nabu's isolated 60 GiB system partition.
+ * Types, memcpy and memcmp are supplied by the kernel or host test harness.
+ */
+#ifndef NABU_PROJECT_STORAGE_H
+#define NABU_PROJECT_STORAGE_H
+
+#define NABU_PROJECT_NAME "nabu_system"
+#define NABU_PROJECT_NUMBER 36u
+#define NABU_PROJECT_FIRST 108652288ULL
+#define NABU_PROJECT_LAST 124380927ULL
+#define NABU_PROJECT_BLOCKS (NABU_PROJECT_LAST - NABU_PROJECT_FIRST + 1)
+#define NABU_PROJECT_DISK_BLOCKS 124381184ULL
+#define NABU_PROJECT_BLOCK_SIZE 4096u
+#define NABU_PROJECT_MAX_TRANSFER 256u
+
+static inline uint32_t
+nabu_project_le32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | (uint32_t)p[1] << 8 |
+	       (uint32_t)p[2] << 16 | (uint32_t)p[3] << 24;
+}
+
+static inline uint64_t
+nabu_project_le64(const uint8_t *p)
+{
+	return (uint64_t)nabu_project_le32(p) |
+	       (uint64_t)nabu_project_le32(p + 4) << 32;
+}
+
+/* zero_at masks the GPT header CRC field; pass (size_t)-1 for ordinary CRC. */
+static inline uint32_t
+nabu_project_crc32(const uint8_t *p, size_t length, size_t zero_at)
+{
+	uint32_t crc = 0xffffffffu;
+	for (size_t i = 0; i < length; i++) {
+		uint8_t byte = (i >= zero_at && i - zero_at < 4) ? 0 : p[i];
+		crc ^= byte;
+		for (unsigned bit = 0; bit < 8; bit++) {
+			crc = (crc >> 1) ^ (0xedb88320u & (0u - (crc & 1u)));
+		}
+	}
+	return ~crc;
+}
+
+static inline int
+nabu_project_range_allowed(uint8_t lun, uint64_t first, uint64_t blocks,
+    uint64_t lba, uint64_t count)
+{
+	return lun == 0 && first == NABU_PROJECT_FIRST &&
+	       blocks == NABU_PROJECT_BLOCKS && count != 0 &&
+	       lba >= first && lba - first < blocks &&
+	       count <= blocks - (lba - first);
+}
+
+static inline int
+nabu_project_gpt_header(const uint8_t *p, size_t available,
+    uint64_t *entry_lba, uint32_t *entries, uint32_t *table_crc)
+{
+	if (available < 92 || memcmp(p, "EFI PART", 8) != 0 ||
+	    nabu_project_le32(p + 8) != 0x10000 ||
+	    nabu_project_le32(p + 20) != 0) {
+		return 0;
+	}
+	uint32_t bytes = nabu_project_le32(p + 12);
+	if (bytes < 92 || bytes > available || bytes > NABU_PROJECT_BLOCK_SIZE ||
+	    nabu_project_crc32(p, bytes, 16) != nabu_project_le32(p + 16) ||
+	    nabu_project_le64(p + 24) != 1 ||
+	    nabu_project_le64(p + 32) != NABU_PROJECT_DISK_BLOCKS - 1) {
+		return 0;
+	}
+	uint64_t first_usable = nabu_project_le64(p + 40);
+	uint64_t last_usable = nabu_project_le64(p + 48);
+	uint64_t table_lba = nabu_project_le64(p + 72);
+	uint32_t count = nabu_project_le32(p + 80);
+	if (nabu_project_le32(p + 84) != 128 ||
+	    count < NABU_PROJECT_NUMBER || count > (1u << 20) / 128 ||
+	    table_lba < 2 || table_lba >= first_usable ||
+	    (count * 128u + NABU_PROJECT_BLOCK_SIZE - 1) / NABU_PROJECT_BLOCK_SIZE >
+	    first_usable - table_lba ||
+	    first_usable > NABU_PROJECT_FIRST || last_usable < NABU_PROJECT_LAST ||
+	    last_usable >= NABU_PROJECT_DISK_BLOCKS - 1) {
+		return 0;
+	}
+	*entry_lba = table_lba;
+	*entries = count;
+	*table_crc = nabu_project_le32(p + 88);
+	return 1;
+}
+
+static inline int
+nabu_project_gpt_entry(const uint8_t *entry, uint32_t number)
+{
+	if (number != NABU_PROJECT_NUMBER ||
+	    nabu_project_le64(entry + 32) != NABU_PROJECT_FIRST ||
+	    nabu_project_le64(entry + 40) != NABU_PROJECT_LAST) {
+		return 0;
+	}
+	uint8_t type_any = 0, identity_any = 0;
+	for (unsigned i = 0; i < 16; i++) {
+		type_any |= entry[i];
+		identity_any |= entry[16 + i];
+	}
+	if (!type_any || !identity_any) {
+		return 0;
+	}
+	for (unsigned i = 0; i < 36; i++) {
+		uint8_t expected = i < sizeof(NABU_PROJECT_NAME) - 1 ?
+		    (uint8_t)NABU_PROJECT_NAME[i] : 0;
+		if (entry[56 + i * 2] != expected || entry[57 + i * 2] != 0) {
+			return 0;
+		}
+	}
+	return 1;
+}
+
+/* Gate every command before the request list is touched or a doorbell rung. */
+static inline int
+nabu_project_command_allowed(uint8_t lun, uint64_t first, uint64_t blocks,
+    const uint8_t *cdb, unsigned cdb_length, uint32_t bytes, int write)
+{
+	if (lun != 0 || cdb == NULL || cdb_length == 0) {
+		return 0;
+	}
+	if (!write && cdb_length == 6 && cdb[0] == 0x00 && bytes == 0) {
+		static const uint8_t tur[6] = { 0 };
+		return memcmp(cdb, tur, sizeof(tur)) == 0;
+	}
+	if (cdb_length == 10 && cdb[1] == 0 && cdb[6] == 0 && cdb[9] == 0) {
+		uint64_t lba = (uint64_t)cdb[2] << 24 | (uint64_t)cdb[3] << 16 |
+		    (uint64_t)cdb[4] << 8 | cdb[5];
+		uint32_t count = (uint32_t)cdb[7] << 8 | cdb[8];
+		if (!write && cdb[0] == 0x35 && bytes == 0) {
+			return nabu_project_range_allowed(lun, first, blocks, lba, count);
+		}
+		if (cdb[0] != (write ? 0x2a : 0x28)) {
+			return 0;
+		}
+		if (!count || count > NABU_PROJECT_MAX_TRANSFER ||
+		    bytes != count * NABU_PROJECT_BLOCK_SIZE ||
+		    lba >= NABU_PROJECT_DISK_BLOCKS || count > NABU_PROJECT_DISK_BLOCKS - lba) {
+			return 0;
+		}
+		return !write || nabu_project_range_allowed(lun, first, blocks, lba, count);
+	}
+	return 0;
+}
+
+#endif
