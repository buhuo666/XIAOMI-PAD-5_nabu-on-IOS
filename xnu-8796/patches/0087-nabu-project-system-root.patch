 {
-	static const uint8_t cdb[10] = { 0x35 };       /* SYNCHRONIZE CACHE(10), whole LUN */
-	return ufs_scsi(cdb, sizeof(cdb), 0, false);
+	/* A zero transfer length would flush the whole LUN; use a bounded range. */
+	if (!su.writable || !nabu_project_range_allowed(su.lun, su.first_block, su.nblocks,
+	    su.first_block, su.nblocks)) {
+		return EPERM;
+	}
+	uint64_t lba = su.first_block, remaining = su.nblocks;
+	while (remaining) {
+		uint32_t count = remaining > 0xffffu ? 0xffffu : (uint32_t)remaining;
+		uint8_t cdb[10] = {
+			0x35, 0, /* SYNCHRONIZE CACHE(10), never the zero-count whole-LUN form */
+			(uint8_t)(lba >> 24), (uint8_t)(lba >> 16), (uint8_t)(lba >> 8), (uint8_t)lba,
+			0, (uint8_t)(count >> 8), (uint8_t)count, 0
+		};
+		int error = ufs_scsi(cdb, sizeof(cdb), 0, false);
+		if (error) { return error; }
+		lba += count;
+		remaining -= count;
+	}
+	return 0;
 }
 
