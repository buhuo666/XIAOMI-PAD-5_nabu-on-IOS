+    dyld_pager_t pager, struct dyld_chained_starts_in_segment *seg,
+    uint32_t page_index)
+{
+	int enabled = 0;
+	const struct mwl_info_hdr *hdr = pager->dyld_link_info;
+	size_t info_bytes = pager->dyld_link_info_size;
+	uintptr_t info_address = (uintptr_t)hdr;
+	uintptr_t segment_address = (uintptr_t)seg;
+	size_t segment_offset;
+	size_t page_start_offset = offsetof(struct dyld_chained_starts_in_segment, page_start);
+
+	if (!PE_parse_boot_argn("nabuarm64e", &enabled, sizeof(enabled)) || enabled != 1 ||
+	    info_bytes < sizeof(*hdr) || segment_address < info_address ||
+	    end_contents < contents) {
+		return KERN_FAILURE;
+	}
+	segment_offset = segment_address - info_address;
+	if (segment_offset > info_bytes || page_start_offset > info_bytes - segment_offset ||
+	    seg->size > info_bytes - segment_offset || seg->size < page_start_offset ||
+	    page_index >= seg->page_count ||
+	    (size_t)seg->page_count > (seg->size - page_start_offset) / sizeof(uint16_t) ||
+	    seg->pointer_format != hdr->mwli_pointer_format ||
+	    end_contents - contents != seg->page_size ||
+	    (hdr->mwli_binds_offset & 7) != 0 ||
+	    hdr->mwli_binds_offset > info_bytes ||
+	    hdr->mwli_binds_count > (info_bytes - hdr->mwli_binds_offset) / sizeof(uint64_t)) {
+		return KERN_FAILURE;
+	}
+	const uint64_t *binds = (const uint64_t *)(info_address + hdr->mwli_binds_offset);
+	enum nabu_arm64e_result result = nabu_arm64e_fixup_page((uint8_t *)contents,
+	    end_contents - contents, seg->page_start[page_index], hdr->mwli_pointer_format,
+	    hdr->mwli_image_address, hdr->mwli_slide, binds, hdr->mwli_binds_count, NULL);
+	if (result != NABU_ARM64E_OK) {
+		printf("nabuarm64e: rejected unsigned chain format=%u page=%u reason=%u\n",
+		    hdr->mwli_pointer_format, page_index, (unsigned int)result);
+		return KERN_FAILURE;
+	}
+	return KERN_SUCCESS;
+}
+#endif
