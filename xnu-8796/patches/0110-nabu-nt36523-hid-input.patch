+static bool
+nbu_wait_firmware(void)
+{
+	uint64_t deadline;
+	uint8_t state = 0;
+	int rc = -1;
+	unsigned polls = 0;
+
+	clock_interval_to_deadline(30000u, NSEC_PER_MSEC, &deadline);
+	do {
+		rc = nvt_read_addr(&ts.bus, NVT_EVENT_BUF_ADDR | 0x60u, &state, 1);
+		if (rc == 0 && state == 0xa3u) {
+			printf("NABU TOUCH: firmware normal-run state confirmed\n");
+			return true;
+		}
+		if ((polls++ % 10u) == 0) {
+			printf("NABU TOUCH: waiting for normal-run state read=%d state=%#x\n",
+			    rc, state);
+		}
+		nbu_sleep_ms(100);
+	} while (mach_absolute_time() < deadline);
+
+	printf("NABU TOUCH: firmware normal-run timeout read=%d state=%#x\n", rc, state);
+	return false;
+}
