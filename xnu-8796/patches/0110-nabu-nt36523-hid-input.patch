diff --git a/bsd/dev/nabu_touch_board.h b/bsd/dev/nabu_touch_board.h
new file mode 100644
index 0000000..2112a02
--- /dev/null
+++ b/bsd/dev/nabu_touch_board.h
@@ -0,0 +1,58 @@
+/* SPDX-License-Identifier: BSD-2-Clause-Patent */
+#ifndef NABU_TOUCH_BOARD_H
+#define NABU_TOUCH_BOARD_H
+
+#include <stdint.h>
+
+#define NBU_TOUCH_WIDTH 1600u
+#define NBU_TOUCH_HEIGHT 2560u
+#define NBU_TOUCH_XO_HZ 19200000u
+#define NBU_TOUCH_EAST_PA 0x03500000u
+#define NBU_TOUCH_NORTH_PA 0x03900000u
+#define NBU_TOUCH_EAST_SIZE 0x1b000u
+#define NBU_TOUCH_NORTH_SIZE 0x28000u
+#define NBU_TOUCH_GCC_VOTE 0x52014u
+#define NBU_TOUCH_VOTES ((1u << 1) | (1u << 2) | (1u << 5))
+#define NBU_TOUCH_M_AHB 0x1e004u
+#define NBU_TOUCH_S_AHB 0x1e008u
+#define NBU_TOUCH_SE_HALT 0x1e274u
+#define NBU_TOUCH_HWCG (1u << 1)
+#define NBU_TOUCH_CLK_OFF (1u << 31)
+#define NBU_TOUCH_RCG_CFG_MASK 0x371fu
+
+static inline unsigned
+nbu_touch_pin_mux(unsigned pin)
+{
+	return pin == 24u || pin == 25u ? 3u : 2u;
+}
+
+static inline int
+nbu_touch_branch_ready(uint32_t offset, uint32_t cbcr, uint32_t vote)
+{
+	uint32_t bit = offset == NBU_TOUCH_M_AHB ? 1u << 2 :
+	    offset == NBU_TOUCH_S_AHB ? 1u << 1 :
+	    offset == NBU_TOUCH_SE_HALT ? 1u << 5 : 0;
+
+	if (!bit || !(vote & bit)) {
+		return 0;
+	}
+	if (offset == NBU_TOUCH_S_AHB && (cbcr & NBU_TOUCH_HWCG)) {
+		return 1;
+	}
+	return !(cbcr & NBU_TOUCH_CLK_OFF) ||
+	    (cbcr & 0xf0000000u) == 0x20000000u;
+}
+
+static inline int
+nbu_touch_xo_level(const uint32_t levels[8])
+{
+	for (unsigned i = 0; i < 8; i++) {
+		uint32_t cfg = levels[i] & NBU_TOUCH_RCG_CFG_MASK;
+		if (cfg == 0 || cfg == 1) {
+			return (int)i;
+		}
+	}
+	return -1;
+}
+
+#endif /* NABU_TOUCH_BOARD_H */
diff --git a/bsd/dev/nabu_touch_input.h b/bsd/dev/nabu_touch_input.h
new file mode 100644
index 0000000..843e840
--- /dev/null
+++ b/bsd/dev/nabu_touch_input.h
@@ -0,0 +1,113 @@
+/*
+ * Stable NT36523 contact ids mapped to Nabu HID slots.
+ *
+ * SPDX-License-Identifier: BSD-2-Clause-Patent
+ */
+#ifndef NABU_TOUCH_INPUT_H
+#define NABU_TOUCH_INPUT_H
+
+#include <stdint.h>
+
+#include "nabu_touch_board.h"
+#include "nabu_nt36523.h"
+
+struct nbu_touch_slots {
+	uint16_t active;
+	uint16_t x[NVT_MAX_FINGERS];
+	uint16_t y[NVT_MAX_FINGERS];
+};
+
+typedef void (*nbu_touch_emit_fn)(int slot, int down, int x, int y);
+
+static inline int
+nbu_touch_hid_x(int x)
+{
+	if (x <= 0) {
+		return 0;
+	}
+	if ((unsigned)x >= NBU_TOUCH_WIDTH - 1u) {
+		return 1079;
+	}
+	return (int)((int64_t)x * 1079 / (NBU_TOUCH_WIDTH - 1u));
+}
+
+static inline int
+nbu_touch_hid_y(int y)
+{
+	if (y <= 0) {
+		return 0;
+	}
+	if ((unsigned)y >= NBU_TOUCH_HEIGHT - 1u) {
+		return 2399;
+	}
+	return (int)((int64_t)y * 2399 / (NBU_TOUCH_HEIGHT - 1u));
+}
+
+static inline int
+nbu_touch_publish(struct nbu_touch_slots *slots, const struct nvt_contact *contacts,
+    int count, uint16_t max_x, uint16_t max_y, nbu_touch_emit_fn emit)
+{
+	uint16_t next = 0;
+	uint16_t x[NVT_MAX_FINGERS] = {0};
+	uint16_t y[NVT_MAX_FINGERS] = {0};
+
+	if (slots == NULL || contacts == NULL || emit == NULL ||
+	    count < 0 || count > NVT_MAX_FINGERS || max_x == 0 || max_y == 0) {
+		return -1;
+	}
+
+	for (int i = 0; i < count; i++) {
+		const struct nvt_contact *c = &contacts[i];
+		if (!c->down || c->id < 1 || c->id > NVT_MAX_FINGERS ||
+		    c->x < 0 || c->y < 0 || c->x > max_x || c->y > max_y) {
+			return -1;
+		}
+		unsigned slot = (unsigned)c->id - 1u;
+		uint16_t bit = (uint16_t)(1u << slot);
+		if (next & bit) {
+			return -1;
+		}
+		next |= bit;
+		x[slot] = (uint16_t)c->x;
+		y[slot] = (uint16_t)c->y;
+	}
+
+	for (unsigned slot = 0; slot < NVT_MAX_FINGERS; slot++) {
+		uint16_t bit = (uint16_t)(1u << slot);
+		if ((slots->active & bit) && !(next & bit)) {
+			emit((int)slot, 0, slots->x[slot], slots->y[slot]);
+		}
+	}
+	for (unsigned slot = 0; slot < NVT_MAX_FINGERS; slot++) {
+		uint16_t bit = (uint16_t)(1u << slot);
+		if (next & bit) {
+			/* Replay active contacts so a late-starting HID service sees state. */
+			emit((int)slot, 1, x[slot], y[slot]);
+		}
+	}
+
+	slots->active = next;
+	for (unsigned slot = 0; slot < NVT_MAX_FINGERS; slot++) {
+		if (next & (uint16_t)(1u << slot)) {
+			slots->x[slot] = x[slot];
+			slots->y[slot] = y[slot];
+		}
+	}
+	return 0;
+}
+
+static inline void
+nbu_touch_release(struct nbu_touch_slots *slots, nbu_touch_emit_fn emit)
+{
+	if (slots == NULL || emit == NULL) {
+		return;
+	}
+	for (unsigned slot = 0; slot < NVT_MAX_FINGERS; slot++) {
+		if (slots->active & (uint16_t)(1u << slot)) {
+			emit((int)slot, 0, slots->x[slot], slots->y[slot]);
+		}
+	}
+	slots->active = 0;
+}
+
+#endif /* NABU_TOUCH_INPUT_H */
