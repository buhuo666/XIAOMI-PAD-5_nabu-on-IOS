--- a/bsd/dev/nabu_nt36523.h
+++ b/bsd/dev/nabu_nt36523.h
@@ -23,6 +23,19 @@
 #define NVT_EVENT_BUF_ADDR          0x2FE00u
 #define NVT_EVENT_FWINFO            0x78u
 #define NVT_EVENT_BUF_FWINFO        (NVT_EVENT_BUF_ADDR | NVT_EVENT_FWINFO)
+
+/*
+ * The firmware state byte, read from offset 0x60 within the event buffer.
+ *
+ * Android's driver judges it by its high nibble, not its whole value
+ * (nvt_check_fw_status at 0xffffff800892a200: `and w8, w8, #0xf0` then
+ * `cmp w8, #160`). The low nibble varies between boots -- this port has
+ * observed 0xa1 and 0xa3 from the same firmware -- so comparing the whole byte
+ * rejects valid states.
+ */
+#define NVT_FW_STATUS_OFFSET        0x60u
+#define NVT_FW_STATE_MASK           0xF0u
+#define NVT_FW_STATE_RUNNING        0xA0u   /* 0xa1, 0xa3, 0xaf all count */
 
 /* Full-duplex SPI transfer, chip select held for the whole transfer. */
 struct nvt_bus {
