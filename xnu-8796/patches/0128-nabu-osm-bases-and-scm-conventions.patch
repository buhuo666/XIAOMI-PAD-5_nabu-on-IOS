+/*
+ * The three frequency tables, with the bases corrected.
+ *
+ * The first three attempts used 0x18321000 / 0x18323000 / 0x18325800 and the
+ * decoded code sequences settled it. Comparing what each base actually reads
+ * against this tablet's own cpufreq lists:
+ *
+ *   base 0x18321000 reads codes 15 21 26 32 37 ...   matches neither cluster
+ *   base 0x18323000 reads codes 15 21 26 30 35 40 44 49   IS the little table
+ *   base 0x18325800 reads codes 37 43 49 55 61 67 73 78   IS the big table
+ *
+ * and Android's own lists decode to exactly those codes:
+ *   little 300000 403200 499200 576000 672000 768000 844800 940800
+ *          -> -, 21, 26, 30, 35, 40, 44, 49
+ *   big    710400 825600 940800 1056000 1171200 1286400 1401600 1497600
+ *          -> 37, 43, 49, 55, 61, 67, 73, 78
+ *
+ * So the bases were one cluster out. 0x18321000 is not a table at all: it is the
+ * OSM clock controller itself (the device tree's qcom,cpucc, whose driver is
+ * clk-cpu-osm), which is why it reads plausible-looking but wrong words.
+ *
+ * The prime cluster therefore begins at the fourth block, 0x18327800.
+ */
 static struct nabu_cluster clusters[] = {
-	{ "little", 0x18321000UL, 4, 0 },
-	{ "big",    0x18323000UL, 3, 0 },
-	{ "prime",  0x18325800UL, 1, 0 },
+	{ "little", 0x18323000UL, 4, 0 },
+	{ "big",    0x18325800UL, 3, 0 },
+	{ "prime",  0x18327800UL, 1, 0 },
 };
 #define NABU_CLUSTERS (sizeof(clusters) / sizeof(clusters[0]))
 
