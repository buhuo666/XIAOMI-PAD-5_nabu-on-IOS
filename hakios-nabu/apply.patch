+	    nbu_overlap(PAYLOAD_BASE, PAYLOAD_MAX_SIZE, (uint64_t)(uintptr_t)image->image_base, image->image_size) ||
+	    (platform_fdt != NULL && nbu_overlap(PAYLOAD_BASE, PAYLOAD_MAX_SIZE,
+	    (uint64_t)(uintptr_t)platform_fdt, platform_fdt_bytes))) {
+		return 0;
+	}
+	loader_image_base = (uint64_t)(uintptr_t)image->image_base;
+	loader_image_bytes = image->image_size;
+	if (mapped_ram(PAYLOAD_BASE, PAYLOAD_MAX_SIZE, (1u << 2) | (1u << 4))) {
+		payload_memory_ready = 1;
+		return 1;
+	}
+	if (!mapped_ram(PAYLOAD_BASE, PAYLOAD_MAX_SIZE, 1u << EfiConventionalMemory)) {
+		return 0;
+	}
+	uint64_t address = PAYLOAD_BASE;
+	if (EFI_ERROR(BS->allocate_pages(AllocateAddress, EfiLoaderData, PAYLOAD_MAX_SIZE >> 12, &address)) ||
+	    address != PAYLOAD_BASE) {
