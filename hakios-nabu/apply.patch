+/* Firmware memory is readable only after its complete range is described as RAM. */
+static int
+mapped_ram(uint64_t base, uint64_t bytes, uint32_t allowed)
+{
+	static uint8_t map[65536] __attribute__((aligned(8)));
+	uint64_t size = sizeof(map), key, stride;
+	uint32_t version;
+	if (EFI_ERROR(BS->get_memory_map(&size, map, &key, &stride, &version))) {
+		return 0;
+	}
+	return nbu_map_covers(map, size, stride, base, bytes, allowed);
+}
+
+static int
+find_nabu_platform(void)
+{
+	static const efi_guid fdt_guid = {
+		0xb1b621d5, 0xf19c, 0x41a5, { 0x83, 0x0b, 0xd9, 0x15, 0x2c, 0x69, 0xaa, 0xe0 }
+	};
+	struct nbu_fdt_facts facts;
+	const uint32_t ram_types = 0xfe; /* firmware-provided loader, boot, runtime or conventional RAM */
+	if (ST->nr_tables > 256 || (ST->nr_tables && ST->tables == NULL)) {
+		return 0;
+	}
+	for (uint64_t i = 0; i < ST->nr_tables; i++) {
+		if (memcmp(&ST->tables[i].guid, &fdt_guid, sizeof(fdt_guid)) != 0) {
+			continue;
+		}
+		const uint8_t *raw = ST->tables[i].table;
+		uint64_t address = (uint64_t)(uintptr_t)raw;
+		if (!mapped_ram(address, 40, ram_types)) {
+			return 0;
+		}
+		uint32_t bytes = nbu_be32(raw + 4);
+		if (bytes < 40 || bytes > 4 * 1024 * 1024 || !mapped_ram(address, bytes, ram_types) ||
+		    !nbu_fdt(raw, bytes, &facts)) {
+			return 0;
+		}
+		platform_fdt = raw;
+		platform_fdt_bytes = bytes;
+		payload_fdt_reserved = facts.payload_reserved;
+		return facts.gic_dist == platform_nabu.gic_dist && facts.gic_redist == platform_nabu.gic_redist;
+	}
+	return 0;
