{
  "run_at_boot": [
    "com.apple.notifyd",
    "com.apple.cfprefsd.xpc.daemon",
    "com.apple.cfprefsd.xpc.daemon.system",
    "com.apple.logd",
    "com.apple.syslogd",
    "com.apple.distnoted.xpc.daemon",
    "com.apple.diagnosticd",
    "com.apple.fseventsd",
    "com.apple.containermanagerd",
    "com.apple.containermanagerd.system",
    "com.apple.runningboardd",
    "com.apple.backboardd",
    "com.apple.mobile.usermanagerd",
    "com.apple.mobilegestalt.xpc",
    "com.apple.lsd",
    "com.apple.powerd",
    "com.apple.analyticsd",
    "com.apple.logd_helper",
    "com.apple.iconservices.iconservicesagent",
    "com.apple.pluginkit.pkd",
    "com.apple.bluetoothd",
    "com.apple.SpringBoard"
  ],
  "additional_deny": [
    "purplebuddy",
    "mobileactivation"
  ],
  "on_demand_allow": [
    "com.apple.dmd",
    "com.apple.bluetoothuserd"
  ],
  "environment_overrides": {
    "com.apple.bluetoothd": {
      "OS_ACTIVITY_DT_MODE": "YES",
      "BT_HCI_TRANSPORT": "H4:POSIX:com.apple.uart.bluetooth,115200"
    },
    "com.apple.backboardd": {
      "CA_FORCE_TIMER": "1"
    },
    "com.apple.SpringBoard": {
      "CG_CONTEXT_SHOW_BACKTRACE": "1"
    }
  },
  "scope": "20F66 local services plus Nabu native Bluetooth bring-up: original bluetoothd at boot, Bluetooth UI service and local user-daemon Mach triggers; controller operation requires separate runtime validation",
  "source_job_allow": [
    "com.apple.managedconfiguration.passcodenagd",
    "com.apple.bluetoothuiservice"
  ],
  "restore_conditions": {
    "com.apple.chronod": {
      "fields": [
        "KeepAlive"
      ],
      "events": {
        "com.apple.distnoted.matching": true,
        "com.apple.notifyd.matching": true
      }
    },
    "com.apple.assetsd": {
      "fields": [
        "KeepAlive"
      ],
      "events": {
        "com.apple.tccd.events": [
          "com.apple.assetsd"
        ]
      }
    },
    "com.apple.aggregated": {
      "fields": [
        "KeepAlive"
      ]
    },
    "com.apple.mediaserverd": {
      "fields": [
        "KeepAlive"
      ]
    },
    "com.apple.dmd": {
      "events": {
        "com.apple.ManagedSettings.effective-settings.changed": true,
        "com.apple.distnoted.matching": true,
        "com.apple.notifyd.matching": [
          "SignificantTimeChangeNotification",
          "com.apple.dmd.budget.didChange",
          "com.apple.mobile.keybagd.first_unlock"
        ]
      }
    },
    "com.apple.calaccessd": {
      "events": {
        "com.apple.notifyd.matching": [
          "com.apple.springboard.finishedstartup",
          "SignificantTimeChangeNotification",
          "com.apple.mobilecal.timezonechanged",
          "_CalDatabaseChangedNotification",
          "kCalEventOccurrenceCacheChangedNotification",
          "kCalBirthdayDefaultAlarmChangedNote",
          "com.apple.mobile.keybagd.first_unlock",
          "com.apple.mobilecal.preference.notification.calendarsExcludedFromNotifications",
          "com.apple.mobilecal.preference.notification.weekStart",
          "EKNotificationCountChangedExternallyNotification",
          "com.apple.eventkit.preference.notification.UnselectedCalendarIdentifiersForFocusMode"
        ]
      }
    },
    "com.apple.contactsd": {
      "events": {
        "com.apple.notifyd.matching": [
          "__ABDataBaseChangedByOtherProcessNotification",
          "com.apple.contacts.clientDidDisplayFavorites"
        ]
      }
    },
    "com.apple.mobiletimerd": {
      "fields": [
        "RunAtLoad"
      ],
      "events": {
        "com.apple.alarm": true,
        "com.apple.distnoted.matching": [
          "Application Uninstalled"
        ],
        "com.apple.notifyd.matching": [
          "SignificantTimeChange",
          "com.apple.mobile.keybagd.first_unlock",
          "com.apple.springboard.finishedstartup",
          "com.apple.system.powersources.source"
        ]
      }
    },
    "com.apple.remindd": {
      "fields": [
        "RunAtLoad"
      ],
      "events": {
        "com.apple.alarm": true,
        "com.apple.notifyd.matching": [
          "PCPreferencesDidChangeNotification",
          "SignificantTimeChangeNotification"
        ]
      }
    },
    "com.apple.searchd": {
      "events": {
        "com.apple.notifyd.matching": [
          "com.apple.spotlightui.prefschanged"
        ],
        "com.apple.distnoted.matching": [
          "com.apple.LaunchServices.applicationUnregistered"
        ]
      }
    }
  }
}
