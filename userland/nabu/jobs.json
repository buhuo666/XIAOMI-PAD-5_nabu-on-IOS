{
  "run_at_boot": [
    "com.apple.notifyd",
    "com.apple.cfprefsd.xpc.daemon",
    "com.apple.cfprefsd.xpc.daemon.system",
    "com.apple.logd",
    "com.apple.syslogd",
    "com.apple.distnoted.xpc.daemon",
    "com.apple.diagnosticd",
    "com.apple.fseventsd",
    "com.apple.containermanagerd",
    "com.apple.containermanagerd.system",
    "com.apple.runningboardd",
    "com.apple.backboardd",
    "com.apple.mobile.usermanagerd",
    "com.apple.mobilegestalt.xpc",
    "com.apple.lsd",
    "com.apple.powerd",
    "com.apple.analyticsd",
    "com.apple.logd_helper",
    "com.apple.iconservices.iconservicesagent",
    "com.apple.pluginkit.pkd",
    "com.apple.SpringBoard"
  ],
  "additional_deny": ["purplebuddy", "mobileactivation"],
  "on_demand_allow": ["com.apple.dmd"],
  "environment_overrides": {
    "com.apple.backboardd": {"CA_FORCE_TIMER": "1"}
  },
  "scope": "20F66 local software bring-up; dmd is a run65 on-demand candidate for observed application-policy lookup failures"
}
